# Journal patterns (ERE) for the #8162 ROW, each from a line the code at 4c663af40f really prints (crate file:line at
# that head). legs.sh waits on them and verdict.py judges with them; ./patterns-check.sh <lampOS tree> checks that
# each one's fixed text is still in the tree that was built.
# lamp-tasks: readiness and the kept session (tasks/src/agent.rs, one_session.rs, harness.rs)
export P_AGENT='tasks: agent: [a-z_]+ -> [a-z_]+'                                                       # agent.rs:232
export P_T_REFUSEDHAND='refused the hand-over \(.*\); the task ends now, and a fresh session is opened after \(#8138\)'   # one_session.rs:4857
export P_T_WARMING='refused the hand-over while warming up \(.*\); the task ends now, the session is kept \(#8138\)'   # one_session.rs:4829
export P_T_BROKE='its session broke \(.*\); the task ends now, never run again'                         # one_session.rs:5282
export P_T_STUCK='is gone or stuck \(.*\); closed, forgotten and replaced with a fresh session \(#7906\)' # one_session.rs:3987
export P_T_KEPTNEW='tasks: one session: kept session new [0-9a-f]{8} '                                  # one_session.rs:3799 (result "new")
export P_T_KEPT='tasks: one session: kept session (new|live|reused) [0-9a-f]{8} '                       # one_session.rs:3799
export P_T_WATCHAGAIN="tasks: one session: the kept session [^ ]+'s watch ended \(.*\); ensured and watched again"   # one_session.rs:2906
export P_T_GWBACK="tasks: one session: OpenClaw's Gateway answers again; opened at once"               # one_session.rs:2562
export P_T_HELD="Harness's watch says it is held \((held_approval|held_sign_in)\); only the person can clear it, so no fresh session \(#8138\)"   # one_session.rs:2847
export P_T_DONE="tasks: one session: [^ ]+'s turn is done; the queue goes on"                          # one_session.rs:2084
export P_T_TAKEN='tasks: harness reply: .*exit=0 '                                                       # harness.rs:5944 (call_line)
# lamp-voice (voice/src/agent_tasks.rs, second_provider.rs, coordinator.rs, task_news.rs, attention.rs)
export P_V_REQ='lamp-voice (second|provider): request [0-9]+'                                            # every request's lines
export P_V_HELD='its answer is held back: nobody spoke to the lamp'                                      # second_provider.rs:11589 + attention.rs:337
export P_V_REFUSED="lamp-voice provider: request [0-9]+: the lamp's own agent is [A-Za-z]+: refused at once, nothing prepared"   # agent_tasks.rs:4752
export P_V_AUDIO='lamp-voice second: request [0-9]+ first answer audio [0-9]+ ms after the words were heard'   # second_provider.rs:23212, :4394
export P_V_TOLD='lamp-voice: telling news from the work handed over \('                                  # coordinator.rs:14535
export P_V_READYTOLD='lamp-voice: telling news from the work handed over \(agent-ready-[0-9]+'           # coordinator.rs:14535, key task_news.rs:1553
export P_V_READYOFFER="the lamp's own agent is ready again after a refusal: told once at a quiet moment"   # task_news.rs:1522
# lamp-update (update/src/openclaw_install.rs, round.rs, main.rs, harness_install.rs)
export P_U_TASKSSTOP='lamp-tasks.service stopped while lamp-openclaw-gateway.service restarts'          # openclaw_install.rs:2111
export P_U_HEALTH='lamp-openclaw-gateway.service answers health [0-9]+ s after its restart'              # openclaw_install.rs:2201
export P_U_TASKSBACK='lamp-tasks.service started again'                                                  # openclaw_install.rs:2128
export P_U_CUTBACK="lamp-tasks.service started again: OpenClaw's install ended while it was stopped for the gateway's restart \(#8138\)"   # openclaw_install.rs:2160
export P_U_END='switched to build [0-9]+; every part is well|up to date: build [0-9]+'                   # round.rs:301, :311
export P_U_SELF='lamp-update switches to its build [0-9a-f]+; it must confirm itself'                    # round.rs:3975
export P_U_CONFIRMED='confirmed: lamp-update runs its new build'                                         # main.rs:1043
export P_U_HMOVED='Harness [0-9.]+ is moved to the pinned [0-9.]+'                                       # harness_install.rs:1166
