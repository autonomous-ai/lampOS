#!/usr/bin/env python3
# Mock ssh for the #6449 kit: never connects. A LAMP body -> the fixture out/<script>[.<key>] (key: STAGE=, MODE= or
# the fence's STOPF suffix); `journalctl -f` -> journal chunks j/<LEG>.<CLIP>[.<k>] appended as each clip is played
# (the afplay stub's trigger file), "@+<s> <unit>[pid]: <line>" offsets from the play; `journalctl -u` -> MOCK_STARTS
# "Started" lines (the start budget); anything else (rm, touch, mkdir) -> nothing.
import os, sys, time, re, glob
FX = os.environ["MOCK_FX"]; ROW = os.environ["MOCK_ROW"]; LOG = os.environ["MOCK_LOG"]
a = sys.argv[1:]; i = 0
while i < len(a) and a[i].startswith("-"):
    if a[i] in ("-o", "-p", "-i", "-l"): i += 2
    else: i += 1
host = a[i] if i < len(a) else ""; cmd = " ".join(a[i+1:])
def log(m):
    with open(LOG, "a") as f: f.write("%.3f ssh %s: %s\n" % (time.time(), host, m))
def fx(*names):
    for nm in names:
        p = os.path.join(FX, nm)
        if os.path.exists(p): return open(p).read()
    return None
if "sudo sh -s" in cmd:
    body = sys.stdin.read()
    names = {}
    for f in glob.glob(os.path.join(ROW, "*.lamp.sh")):
        c = open(f).read()
        if os.path.basename(f) != "common.lamp.sh" and body.endswith(c): names[os.path.basename(f)] = c
    nm = max(names, key=lambda k: len(names[k])) if names else "unknown"
    pre = body[: len(body) - len(names.get(nm, ""))].rstrip("\n").split("\n")[-1]
    m = re.search(r"STOPF=/tmp/t6449-stop\.(\S+)", pre) or re.search(r"STAGE=(\S+)", pre) or re.search(r"MODE=(\S+)", pre)
    key = m.group(1) if m else ""
    pw = body.split("\n", 1)[0]
    log("LAMP %s key=%s pre=%r sudo_line=%s" % (nm, key, pre[:120], "given" if pw else "empty"))
    out = fx("out/%s.%s" % (nm, key), "out/%s" % nm)
    if out is None: log("NO FIXTURE out/%s.%s" % (nm, key)); sys.exit(0)
    sys.stdout.write(out); sys.exit(0)
log("CMD " + cmd)
if "journalctl -f" in cmd:
    # -n0: only clips played after the follower starts (a real `journalctl -f -n0` shows no older lines)
    trig = os.path.join(os.environ["MOCK_STATE"], "played"); count = {}
    try: seen = len(open(trig).read().splitlines())
    except FileNotFoundError: seen = 0
    while True:
        try: ts = open(trig).read().splitlines()
        except FileNotFoundError: ts = []
        for t in ts[seen:]:
            at, leg, clip = t.split()
            count[(leg, clip)] = count.get((leg, clip), 0) + 1; k = count[(leg, clip)]
            ch = fx("j/%s.%s.%d" % (leg, clip, k), "j/%s.%s" % (leg, clip)) or ""
            for line in ch.splitlines():
                mm = re.match(r"@\+([0-9.]+) (.*)", line)
                if mm: sys.stdout.write("%.6f mock-lamp %s\n" % (float(at) + float(mm.group(1)), mm.group(2)))
            sys.stdout.flush()
        seen = len(ts); time.sleep(0.05)
if cmd.startswith("journalctl -u"):
    sys.stdout.write("Started x.\n" * int(os.environ.get("MOCK_STARTS", "0"))); sys.exit(0)
sys.exit(0)
