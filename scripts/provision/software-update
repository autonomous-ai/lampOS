fi
if [ -n "$SERVICE_NAME" ]; then
  [ $# -le 2 ] && { [ $# -eq 1 ] || [ "$2" = --activate ] || [ "$2" = --activate-promoted ]; } || { echo "Usage: software-update <component> [--activate|--activate-promoted]" >&2; exit 1; }
  [ -n "$URL" ] && [[ "$SHA256" =~ ^[a-fA-F0-9]{64}$ ]] || { echo "Service OTA requires URL and SHA-256" >&2; exit 1; }
