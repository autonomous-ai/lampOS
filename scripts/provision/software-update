    echo "[software-update] ${UNIT}.service absent (runtime not active) — binary restored, no restart"
  else
    systemctl restart "$UNIT"
  fi
  [ "$ROLLBACK_TARGET" != "bootstrap" ] && systemctl restart bootstrap
  echo "$ROLLBACK_TARGET restored from $BACKUP"
  exit 0
fi
LEGACY_TARGET=0
case "$APP" in
  os-server|openclaw|codex|claudecode|opencode|hermes|picoclaw|bootstrap|web|hal|claude-desktop-buddy|device) LEGACY_TARGET=1 ;;
  *) [[ "$APP" =~ ^[a-z][a-z0-9-]{0,47}$ ]] || { echo "Invalid component name" >&2; exit 1; } ;;
esac

PROGRESS_RUN_ID="$(date +%s)-$$"
PROGRESS_BOOT_ID="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
progress_report preparing

if [ -z "${OTA_METADATA_URL:-}" ]; then
