  ZIP_TMP=$(mktemp)
  download_verified "$URL" "$ZIP_TMP" "$SHA256" || { echo "Service package verification failed" >&2; exit 1; }
  service_transaction install "$APP" "$METADATA_PAYLOAD" "$ZIP_TMP" "${2:-}"
