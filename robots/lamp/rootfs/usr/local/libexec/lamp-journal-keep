# The last two boots' journal, kept on the eMMC (#2602; the drop-in
# orangepi-ramlog.service.d/zz-lamp-journal-keep.conf runs it), and a
# first-time setup's (#5144; lamp-journal-setup.timer runs it). Run with
# bash.
#
# The journal lives on the /var/log RAM disk, one boot at a time, and
# ramlog's copies to the eMMC leave it out (/etc/default/orangepi-ramlog):
# bringing earlier boots' files back into the RAM disk is what filled it
# past orangepi-truncate-logs' 75% and had its vacuum drop this boot's first
# seconds. So the kept boots never go back to the RAM disk, nor to
# /var/log.hdd (whose copy has --delete), nor anywhere a vacuum reaches:
#
# `keep`, from ramlog's stop at a clean shutdown or reboot only (systemd
#   says "stopping"; never at a `systemctl stop`, and a crash runs nothing,
#   so a crashed boot is lost, as accepted on #2602): journald rotates, so
#   every file is closed, then this boot's closed files are copied, newest
#   first, to $keep/last, up to 5 MB, stopping at the first that doesn't fit
#   so what is kept is the boot's end without a gap. The boot before moves
#   to $keep/previous, and the one before that is removed: at most 2 boots
#   and 10 MB, written once per shutdown. A boot with nothing to copy, or
#   a move that fails, leaves the kept ones as they are.
# `link`, from ramlog's start at boot: each kept file is linked into
#   /run/log/journal, a tmpfs journalctl reads besides /var/log/journal.
#   Journald's own vacuum is of its machine's folder only, and a vacuum
#   (orangepi-truncate-logs' `journalctl --vacuum-size`) never removes a
#   file whose name isn't an archived one's, which a link's ("lamp-kept-…",
#   no "@") isn't. Nothing is written to the RAM disk.
# `setup`, from lamp-journal-setup.timer every 3 minutes (#5144): a tester's
#   setup on lamp-0c4e (3 Nov) was gone from the 20M journal within 4
#   hours, so its failed face step couldn't be read back. While the setup
#   walk is under way (setup done, and the voice's onboarding file missing
#   or without an outcome for one of its steps), and for 20 runs (an hour)
#   after it ends, each of this boot's closed journal files is copied, oldest
#   first, to $keep/setup, up to 24 MB, stopping at the first that doesn't
#   fit, so what is kept is the setup's start without a gap. Every part's
#   lines are in them, the voice's and the eyes' among them. The walk's end
#   is kept by one more copy: the first file closed after the hour, which
#   holds it. Each copy is linked into /run/log/journal once its original
#   is gone from the journal (vacuumed), and at boot by `link`, so
#   journalctl never reads a line twice. Its lines can hold what the person
#   said at setup, so it is deleted 72 hours after the walk was first seen,
#   at a reset (the reset plan wipes the folder) or when a walk begins again
#   (a redo), which replaces it, whichever comes first; and the owner's
#   "forget everything" deletes it at once (lamp-voice's setup_journal.rs,
#   which leaves .forgotten: nothing more of that walk is copied). 24 MB at
#   most, each file written once. A lamp whose walk ended before this ran
#   keeps nothing. Journald is never rotated, restarted nor signalled here.
#
# The last two boots' copies hold the same kind of lines as the setup's, so
# they follow its rules too (#5358, the PM's privacy ruling): a reset wipes
# them (both reset plans wipe /var/lib/lamp-journal), the owner's "forget
# everything" removes them and leaves .forgotten-boot with this boot's id,
# so the shutdown of that boot keeps nothing of it, and no file is kept
# past 72 hours from when it was closed: `keep` copies none older, and
# `link` at boot and every `setup` run (every 3 minutes) delete any older,
# with their links. Nothing is deleted on a clock not set yet.
#
# The paths, the state and the boot's id may be given for tests only; with
# them given, journald isn't asked to rotate.
keep=${LAMP_JOURNAL_KEEP:-/var/lib/lamp-journal}
run=${LAMP_JOURNAL_RUN:-/run/log/journal}
budget=5000000
# `setup`'s bound, its runs after the walk, and the onboarding's steps
# (lamp_msgs::ONBOARDING_STEPS; lamp-update's tests check they match).
setup_budget=24000000
setup_after=20
# 72 hours, and a time before which the clock isn't set yet (2026-01-01).
setup_life=259200
clock_set=1767225600
steps="where_you_sit who_you_are how_you_sound touch privacy giving_way room_sounds face_expressions preferences"

# Whether the setup walk is under way, as lamp-update's walk.rs reads it:
# setup done, and the onboarding file not written yet or without an
# outcome for one of the steps (its "steps" object, written compact by the
# voice). A file that can't be read is no walk.
walking() {
    [ -f "$1" ] || return 1
    [ -e "$2" ] || return 0
    local text
    text=$(head -c 65536 "$2" 2>/dev/null) || return 1
    case "$text" in *'"steps":{'*) ;; *) return 1 ;; esac
    for step in $steps; do
        case "$text" in *"\"$step\":{"*) ;; *) return 0 ;; esac
    done
    return 1
}

# This boot's id, as the voice's forget reads it (setup_journal.rs).
boot_id() {
    cat "${LAMP_JOURNAL_BOOT_ID:-/proc/sys/kernel/random/boot_id}" 2>/dev/null
}

# The last two boots' files closed more than 72 hours ago are deleted, with
# their links; a slot left empty goes too. Only on a clock that is set.
expire_boots() {
    local now file name slot
    now=$(date +%s)
    [ "$now" -ge "$clock_set" ] || return 0
    for slot in previous last; do
        for file in "$keep/$slot"/*.journal; do
            [ -f "$file" ] || continue
            [ $((now - $(stat -c %Y "$file"))) -ge "$setup_life" ] || continue
            name=${file##*/}
            rm -f "$file" "$run/lamp-kept-$slot-${name//@/.}"
            echo "lamp-journal-keep: a kept boot's file is deleted after 72 hours" >&2
        done
        rmdir "$keep/$slot" 2>/dev/null
    done
    return 0
}

# Links each setup copy whose original is gone from `$1` (all of them with
# no `$1`) into $run, as lamp-kept-setup-….journal.
setup_links() {
    mkdir -p "$run" || return
    for file in "$keep/setup"/*.journal; do
        [ -f "$file" ] || continue
        name=${file##*/}
        [ -n "$1" ] && [ -e "$1/$name" ] && continue
        ln -sfn "$file" "$run/lamp-kept-setup-${name//@/.}"
    done
}

case "$1" in
keep)
    state=${LAMP_JOURNAL_STATE:-$(systemctl is-system-running 2>/dev/null)}
    [ "$state" = stopping ] || exit 0
    # The owner forgot everything during this boot: none of it is kept. A
    # mark from an earlier boot is spent.
    if [ -f "$keep/.forgotten-boot" ]; then
        if [ "$(cat "$keep/.forgotten-boot")" = "$(boot_id)" ]; then
            exit 0
        fi
        rm -f "$keep/.forgotten-boot"
    fi
    if [ -n "${LAMP_JOURNAL_FROM:-}" ]; then
        from=$LAMP_JOURNAL_FROM
    else
        from=/var/log/journal/$(cat /etc/machine-id 2>/dev/null)
        timeout 15 journalctl --rotate >/dev/null 2>&1
    fi
    [ -d "$from" ] || exit 0
    mkdir -p "$keep" || exit 0
    new=$keep/.new
    rm -rf "$new"
    mkdir "$new" || exit 0
    total=0
    # Closed files only: an archived name has "@"; the open ones journald
    # starts after the rotation hold the shutdown's last lines only.
    now=$(date +%s)
    for file in $(ls -1t "$from"/*@*.journal 2>/dev/null); do
        # None closed more than 72 hours ago: newest first, so none after.
        if [ "$now" -ge "$clock_set" ] &&
            [ $((now - $(stat -c %Y "$file"))) -ge "$setup_life" ]; then
            break
        fi
        size=$(wc -c <"$file")
        [ $((total + size)) -le $budget ] || break
        cp -p "$file" "$new/" || break
        total=$((total + size))
    done
    if [ -z "$(ls -A "$new")" ]; then
        rm -rf "$new"
        exit 0
    fi
    # The boot before is set aside, not removed, until this one is in its
    # place: a move that fails (the eMMC full or read-only) leaves the kept
    # boots as they were and says so in the journal.
    rm -rf "$keep/.old"
    if [ -d "$keep/last" ] && ! mv "$keep/last" "$keep/.old"; then
        echo "lamp-journal-keep: this boot is not kept: $keep/last could not be moved aside" >&2
        rm -rf "$new"
        exit 0
    fi
    if ! mv "$new" "$keep/last"; then
        echo "lamp-journal-keep: this boot is not kept: it could not be moved to $keep/last" >&2
        [ -d "$keep/.old" ] && mv "$keep/.old" "$keep/last"
        rm -rf "$new"
        exit 0
    fi
    if [ -d "$keep/.old" ]; then
        rm -rf "$keep/previous"
        mv "$keep/.old" "$keep/previous" ||
            echo "lamp-journal-keep: the boot before could not be moved to $keep/previous" >&2
    fi
    sync
    ;;
link)
    mkdir -p "$run" || exit 0
    rm -f "$run"/lamp-kept-*.journal
    expire_boots
    for slot in previous last; do
        for file in "$keep/$slot"/*.journal; do
            [ -f "$file" ] || continue
            name=${file##*/}
            ln -s "$file" "$run/lamp-kept-$slot-${name//@/.}"
        done
    done
    setup_links ""
    ;;
setup)
    expire_boots
    done_marker=${LAMP_JOURNAL_SETUP_DONE:-/var/lib/lampos-setup/done}
    progress=${LAMP_JOURNAL_PROGRESS:-/var/lib/lampOS/voice/onboarding/progress.json}
    from=${LAMP_JOURNAL_FROM:-/var/log/journal/$(cat /etc/machine-id 2>/dev/null)}
    slot=$keep/setup
    now=$(date +%s)
    # 72 hours after the walk was first seen, all of it goes. A start
    # dated before the clock was set is dated now instead.
    if [ -e "$slot/.started" ]; then
        started=$(stat -c %Y "$slot/.started")
        if [ "$started" -lt "$clock_set" ] && [ "$now" -ge "$clock_set" ]; then
            touch "$slot/.started"
        elif [ $((now - started)) -ge "$setup_life" ]; then
            rm -f "$run"/lamp-kept-setup-*.journal
            rm -rf "$slot"
            echo "lamp-journal-setup: the setup's journal kept is deleted after 72 hours" >&2
            exit 0
        fi
    fi
    if walking "$done_marker" "$progress"; then
        # A walk begun again (a redo, a reset) replaces the setup kept.
        if [ -e "$slot/.ended" ] || [ -e "$slot/.after" ]; then
            rm -f "$run"/lamp-kept-setup-*.journal
            rm -rf "$slot"
        fi
        # Forgotten during this walk: nothing more of it is kept.
        [ -e "$slot/.forgotten" ] && exit 0
        if [ ! -e "$slot/.started" ]; then
            mkdir -p "$slot" && touch "$slot/.started" || exit 0
        fi
    else
        # Nothing for a walk this never saw. One forgotten keeps only its
        # end marked, so a redo after it starts anew. One kept to its end
        # is only linked as its originals go.
        [ -e "$slot/.started" ] || exit 0
        if [ -e "$slot/.forgotten" ]; then
            [ -e "$slot/.after" ] || echo 1 >"$slot/.after"
            exit 0
        fi
        if [ -e "$slot/.ended" ]; then
            [ -d "$from" ] && setup_links "$from"
            exit 0
        fi
        after=$(cat "$slot/.after" 2>/dev/null)
        after=$(( ${after:-0} + 1 ))
        echo "$after" >"$slot/.after"
        # The hour after: the time it ends at, once. The first file closed
        # after it holds the walk's end; once it is kept, nothing more.
        if [ "$after" -ge "$setup_after" ] && [ ! -e "$slot/.end_at" ]; then
            date +%s >"$slot/.end_at"
        fi
    fi
    [ -d "$from" ] || exit 0
    total=0
    for file in "$slot"/*.journal; do
        [ -f "$file" ] && total=$((total + $(stat -c %s "$file")))
    done
    end_at=$(cat "$slot/.end_at" 2>/dev/null)
    # The walk is first seen up to a run (3 minutes) after it begins: a file
    # closed in that gap holds its first lines (Twelve's P3 on #5342).
    started=$(( $(stat -c %Y "$slot/.started") - 180 ))
    # Closed files only (an archived name has "@"), oldest first, and none
    # closed before the walk began: those hold nothing of it.
    for file in $(ls -1tr "$from"/*@*.journal 2>/dev/null); do
        name=${file##*/}
        [ -e "$slot/$name" ] && continue
        [ "$(stat -c %Y "$file")" -ge "$started" ] || continue
        size=$(wc -c <"$file")
        if [ $((total + size)) -gt $setup_budget ]; then
            touch "$slot/.ended"
            echo "lamp-journal-setup: the setup's journal kept is full at $total bytes" >&2
            break
        fi
        cp -p "$file" "$slot/.$name" && mv "$slot/.$name" "$slot/$name" || break
        # Forgotten while it copied: the copy goes too.
        if [ -e "$slot/.forgotten" ]; then
            rm -f "$slot/$name"
            exit 0
        fi
        total=$((total + size))
        if [ -n "$end_at" ] && [ "$(stat -c %Y "$file")" -ge "$end_at" ]; then
            touch "$slot/.ended"
            break
        fi
    done
    setup_links "$from"
    ;;
esac
exit 0
