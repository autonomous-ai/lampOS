# lampOS body: the first stand of a lamp moved from V1, confirmed at the lamp (#2396; the first
# builder on #1711, 21 Oct). Its body runs seated (lamp-body-measure.service) until a person beside
# it says yes. Once someone is near, the lamp asks through the voice's say service: "I'd like to
# stretch for the first time. When you're ready, say yes, or rest your hand on my head." A touch
# on the head or a button held a second is the yes, or a short spoken yes heard after the ask, with a
# face near (voice/heard). lamp-body is then stopped, the arm stood at 30% and 100% as the
# factory's steps stand it, this arm's stand written into /etc/lampOS/body/lamp.env, and lamp-body
# started again on it. A second touch while it moves stops it, and nothing is written. Nothing moves
# without the yes: two asks at most, ten minutes apart; then a person asks again by removing
# /var/lib/lampos-body/first-stand.json and restarting this unit (lamp_body::first_stand).
# With lamp.env there it does nothing. It ends well whatever became of the stand, and stays active
# (RemainAfterExit), so the keeper does not wait on it. Root: it stops and starts lamp-body; the
# body and its read run as @LAMP_USER@ through setpriv (util-linux), which execs them, so a stop
# reaches the body itself and it folds before it ends; as the servo port's owner requires.
[Unit]
Description=lampOS body: the first stand, asked at the lamp and confirmed by a touch or a spoken yes
ConditionHost=@UNIT_ID@
PartOf=lampos.target
After=lamp-body.service lamp-voice.service lamp-controls.service lamp-eyes.service

[Service]
Type=simple
RemainAfterExit=yes
User=root
Slice=lampos-parts.slice
WorkingDirectory=/
ExecStart=/opt/lampOS/body/@BODY_SHA256@/lamp-body-measure first-stand --device @SERVO_DEVICE@ --unit-id @UNIT_ID@ --lock-directory @MOTOR_LOCK_DIR@ --body-user @LAMP_USER@
Restart=on-failure
RestartSec=60s
StandardInput=null
SyslogIdentifier=lamp-first-stand
# The owner's language, the voice's file (#4473): in vi, ja, zh or ko the lamp asks for the touch alone,
# never a spoken yes, since that is heard by English words only (Fourth's finding on #4710).
Environment=LAMP_LANGUAGE_FILE=/etc/lampOS/setup/language
# The stand's folder is private to this unit (the reviewer-lead on #2541).
PrivateTmp=yes

[Install]
WantedBy=lampos.target
