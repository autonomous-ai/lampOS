# lampOS controls: reads the button and the touch pads and says on the bus what a hand did
# (lampOS/docs/controls.md). Without --enable nothing it says may be acted on.
# Template: replace every @NAME@ (README.md here). lamp-4ace's own unit is the worked example.
# Type=simple until it calls the keeper's helper.
[Unit]
Description=lampOS controls (lamp-controls)
ConditionHost=@UNIT_ID@
PartOf=lampos.target
# Not after the voice: the voice is after Controls, so it stops first at a shutdown (#3697).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=@LAMP_USER@
Group=@LAMP_USER@
Slice=lampos-parts.slice
Nice=5
ExecStart=/opt/lampOS/controls/@CONTROLS_SHA256@/lamp-controls serve --config /opt/lampOS/controls/@CONTROLS_SHA256@/controls.json --pins /opt/lampOS/controls/@CONTROLS_SHA256@/controls-pins.json --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=5s
SyslogIdentifier=lamp-controls
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=lampos.target
