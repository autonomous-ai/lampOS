# lampOS control: the developers' door, paired computers on the LAN driving the lamp's body, light
# and voice at `skill` (lampOS/docs/control.md, #3504). The product unit (lampOS/docs/install.md):
# installed and enabled on every lamp, and off unless the owner's developer setting in the app writes
#   [Service]
#   Environment=LAMP_CONTROL=on
# as a drop-in and restarts it. Off, `serve` says so and exits 0 with nothing listening.
# Skill push on (--manage-socket, docs/control.md "Skills pushed from a computer"): a paired computer
# with the `skills` grant pushes, lists and removes its own skills through root's manage helper
# (lamp-skills-manage.socket), which reads the push from --state-dir's push/ and installs it into
# /var/lib/lampOS/skills-dev for lamp-skills. App push (--apps-manage-socket, docs/apps.md "An app from your own
# computer"): with LAMP_STORE_APPS=on, a paired computer with `skills` pushes, lists and removes its own unsigned apps
# through root's apps helper (lamp-apps-manage.socket), staged in /var/lib/lampos-apps-staging. The body's
# lease socket is opened by the product lamp-body unit (#4568); until it is there, lamp-control
# retries it and `look` is refused as the body not reachable.
[Unit]
Description=lampOS control (lamp-control)
PartOf=lampos.target
# Not before setup has finished (#806). The target's own condition holds back none of its parts.
ConditionPathExists=/var/lib/lampos-setup/done
After=local-fs.target network-online.target lamp-voice.service lamp-body.service lamp-actions.service lamp-skills-manage.socket lamp-apps-manage.socket
StartLimitIntervalSec=600
StartLimitBurst=5
# The apps' manage helper socket and folders (#7415, #8131): a round that adds the apps' part enables the socket into
# sockets.target, which no round starts, and may start the folders unit before its `current` link is made. The round
# restarts lamp-control (changed in the same build) after the links, so its start starts both; a boot starts them
# anyway. No order on the folders: lamp-control needs neither to start.
Wants=lamp-apps-manage.socket lamp-apps-folders.service
After=lamp-apps-manage.socket

[Service]
Type=simple
User=lampos
Group=lampos
Slice=lampos-parts.slice
Nice=10
# A skill's task (#6305, #6432, docs/control.md): the owner's yes kept in --state-dir's task-yes.json, and a
# run's service.read and service.write sent to lamp-services; only on the run socket, with the door on or off ((b)).
Environment=LAMP_SKILL_TASKS=on
# The lamp's agent's connectors (#6648, #6664): a skill's linked-service grants kept in the owner's yes and carried
# by the run's token, so service.read and service.write reach only what the yes named. The same line in
# lamp-tasks, lamp-skills, lamp-skills-manage@ and lamp-voice. On in the product (owner, 13 Nov).
Environment=LAMP_AGENT_SERVICES=on
# A made skill's fixed write through the lamp's agent (#6824): a token minted for its one write grant, for a skill
# whose only step is a fixed write (task_yes::KeptYes::fixed_write_grant), its call given that write by the run's
# token (runs::FixedWrite), never the agent's words. The same line in lamp-skills, lamp-tasks and lamp-services.
# On in the product (owner, 13 Nov).
Environment=LAMP_SKILL_WRITE_AGENT=on
# A skill's task reaches the public web (80/443) with its owner's spoken yes (#7200).
Environment=LAMP_TASK_NET=on
# A skill's own writes (#6142): lamp-control loads a skill in its own process to read its grants before it mints a
# run's token (task_yes.rs, lamp_skills::load_with), and that load refuses a write step with this off. The same line
# as lamp-skills, so a skill lamp-skills runs isn't refused a token as "doesn't load".
Environment=LAMP_SKILL_WRITES=on
# #7233, docs/skills.md; owner, 16 Nov
Environment=LAMP_MADE_SKILL_ASKS=on
# LAMP_NPU: #7415, `pose` forwarded to lamp-npu; on in the product by the first builder's DEFAULT-ON of 20 Nov, the
# same line in lamp-npu.service; its rules are its row in docs/switches.md.
Environment=LAMP_NPU=on
# #8180, docs/switches.md: a skill made on the lamp (put on by the manage helper) is minted its declared grants, and
# its task check (a run's `net`) agreed for its folder as it is, with no yes kept (task_yes::no_yes_folder). The same
# line in lamp-voice. Off, every skill's grants wait for the owner's kept yes, as before.
Environment=LAMP_MADE_CODE_ON_AT_ONCE=on
# #8475, docs/switches.md: every source's skill (pushed, Store, added by hand, made) is minted its declared grants,
# and its task check (a run's `net`) agreed for its folder as it is, with no yes kept (task_yes::no_yes_folder). The
# same line in lamp-skills, lamp-services and lamp-voice. Off, only LAMP_MADE_CODE_ON_AT_ONCE's made skills, as before.
# #8475's switch-on, after its part 2 (#8535, the stop that ends a run) landed; DEFAULT-ON asked of a second reader.
Environment=LAMP_TASK_NO_YES=on
# The run socket (/run/lampos-control/control.sock) for lamp-tasks' skill runs as `lampos` (#6071 PR 1,
# docs/control.md "The control socket, lamp-control's side"). With LAMP_CONTROL off, lamp-control serves only it and
# admin.sock (no TLS door), once the first builder's (b) of 12 Nov 08:15 lands.
Environment=LAMP_CONTROL_RUN_SOCKET_USER=lampos
# LAMP_STORE_APPS: #7415, the Store apps; on in the product by the first builder's DEFAULT-ON of 20 Nov; its rules are its rows in docs/switches.md.
Environment=LAMP_STORE_APPS=on
# LAMP_APP_TOOLS: #8386's switch-on; with LAMP_STORE_APPS, each running app's tools file read and said on apps/tools,
# and the voice's app.call sent to the app's socket. The same line in lamp-voice and lamp-apps-manage@; its rules are
# its rows in docs/switches.md.
Environment=LAMP_APP_TOOLS=on
# The door's pre-check lets a computer's move through to the most any lamp may take; the body holds it (#7513's switch-on, the same line in lamp-body).
Environment=LAMP_BODY_APP_REACH=on
# Its certificate and paired computers in --state-dir, the owner's side on --admin-socket (0600),
# the body's mood and lease sockets, the voice's say socket, lamp-actions' call socket (`volume`),
# root's skills manage helper (skill push) and the ring's light requests on the bus.
ExecStart=/opt/lampOS/control/current/lamp-control serve --state-dir /var/lib/lampos-control --admin-socket /run/lampos-control/admin.sock --mood-socket /run/lampos-body/mood.sock --lease-socket /run/lampos-body/lease.sock --say-socket /run/lampos-say/say.sock --actions-socket /run/lampos-actions/call.sock --manage-socket /run/lampos-skills-manage/manage.sock --apps-manage-socket /run/lampos-apps-manage/manage.sock --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=5s
# The local agent's socket file (docs/control.md, "The local agent") is made by lamp-control while the owner's switch is on,
# in /run/lampos-agent, which is writable here only through the switch's own drop-in (agent.conf). Turning the switch off
# removes that drop-in, so the next lamp-control cannot remove the old file: it would stay, owned by lampos and listening
# nowhere. A stop removes it, by root (the `+`: outside this unit's sandbox), and a missing file is no error. A start with
# the switch on makes it again.
ExecStopPost=-+/usr/bin/rm -f /run/lampos-agent/agent.sock
# OpenClaw's gateway is PartOf= this unit (#8320: its namespace binds this socket file once, at its start), so each start
# here starts it again, which spends one of its own StartLimitBurst=5 starts per 600 s: a crash loop here would leave it
# failed (start-limit-hit) after this unit is up again. Each start here gives its count back first, by root (the `+`),
# before the gateway's start (it is After= this unit). No gateway (a lamp without OpenClaw) is no error.
ExecStartPost=-+/bin/sh -c '/usr/bin/systemctl reset-failed lamp-openclaw-gateway.service 2>/dev/null'
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-control
NoNewPrivileges=yes
# Its own state and admin socket, made by systemd for its user and writable under ProtectSystem=strict.
StateDirectory=lampos-control
StateDirectoryMode=0700
RuntimeDirectory=lampos-control
RuntimeDirectoryMode=0700
# #5299: lamp-update's state, handed in for the build hello says (docs/control.md, "The build"); the blank SetCredential= is the fallback when the file is missing, as lamp-skills.service's.
SetCredential=build:\n
LoadCredential=build:/var/lib/lampos-update/state.json
ProtectSystem=strict
# The bus.
ReadWritePaths=/run/lampos-bus
# The apps' socket folder, made by the tmpfiles (lampos.conf); `-` so a lamp without it still starts.
ReadWritePaths=-/run/lampos-apps
# A pushed app's package staged for the apps' helper (lampos's, made by lamp-apps-folders.service); `-` as above.
ReadWritePaths=-/var/lib/lampos-apps-staging
# `pose` (#7415, docs/npu.md): forwarded to lamp-npu's /run/lampos-npu/npu.sock (lampos's, 0700) only with
# LAMP_NPU=on in this unit's own environment, set below with the same line in lamp-npu.service. Connecting needs no
# ReadWritePaths= (as the body's and the voice's sockets).
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=lampos.target
