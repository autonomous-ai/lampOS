# lampOS skills' manage helper, one request (lampOS/docs/skills.md, "The manage helper"; #1722):
# started by lamp-skills-manage.socket for each connection, as root, the connection its standard
# input and output. `lamp-skills asked` reads one line and checks it itself, whoever connected:
# {"remove": NAME} (a skill's name, never a core skill), lamp-skills' own remove under the folder's
# lock; or {"install": {"url", "sha256", "name", "version"}}, a Skills Store package it fetches
# itself over HTTPS (at most 18 MB within 25 s, redirects only to https) and installs only when it
# is signed with the update channel's key (--key-file), never a core skill or a core skill's name,
# and never older than the version installed.
# It answers one line and exits. Only the skills folder is writable; /etc is read-only, the key
# with it.
# The Store is off unless set, as lamp-cloud's LAMP_SKILLS_STORE is: off, the helper refuses every
# install itself ("not on this lamp: skills.install"), whoever connected, removes still run, and
# it has no network. A drop-in turns it on, with the network for the fetch (lamp-cloud passes the
# URL and fetches nothing), at /etc/systemd/system/lamp-skills-manage@.service.d/store.conf:
#   [Service]
#   Environment=LAMP_SKILLS_STORE=on
#   PrivateNetwork=no
#   RestrictAddressFamilies=
#   RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# systemd can't open the network for one request and not another in one template: with the
# Store on, a remove runs with the network too. Network for installs alone would be a unit and
# socket of their own.
[Unit]
Description=lampOS skills' manage helper (lamp-skills asked)
CollectMode=inactive-or-failed

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/lampOS/skills/current/lamp-skills asked --dir /var/lib/lampOS/skills --key-file /etc/lampOS/update/key.pub
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=lamp-skills
RuntimeMaxSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/lampOS/skills
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
