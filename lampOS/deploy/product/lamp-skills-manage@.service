# lampOS skills' manage helper, one request (lampOS/docs/skills.md, "The manage helper"; #1722):
# started by lamp-skills-manage.socket for each connection, as root, the connection its standard
# input and output. `lamp-skills asked` reads one line and checks it itself, whoever connected:
# {"remove": NAME} (a skill's name, never a core skill), lamp-skills' own remove under the folder's
# lock; or {"install": {"url", "sha256", "name", "version"}}, a Skills Store package it fetches
# itself over HTTPS (at most 18 MB within 25 s, redirects only to https) and installs only when it
# is signed with the Store's key (--key-file), never a core skill or a core skill's name,
# and never older than the version installed.
# Or {"off": NAME} / {"on": NAME}, the app's off and on (#2815): kept in lamp-skills' state
# folder, its `off` and `on`. That folder is lampos's, 0700 (the daily journal requires it), so
# the helper keeps one capability, CAP_DAC_OVERRIDE, and nothing else: root without it is held to
# the folder's mode. ProtectSystem=strict still limits its writes to the two paths below.
# It answers one line and exits. Only the skills folder and that state folder are writable; /etc
# is read-only, the key with it.
# Install writes store.conf, which reads the same default-off store.env as lamp-cloud and
# prepares network access for a later install. Off, or with no valid Store key, the helper
# creates no HTTPS client and refuses installs; remove/on/off still work. Network permissions
# in the installed drop-in apply to all requests, including removes; no service starts here.
[Unit]
Description=lampOS skills' manage helper (lamp-skills asked)
CollectMode=inactive-or-failed

[Service]
Type=simple
# On since the backend listed four approved, signed skills (2 Nov, #4710), shown on lamp-9adf (31 Oct).
Environment=LAMP_SKILLS_STORE=on
# A made skill reads a linked service to its owner alone (#5288, #5303): a made skill's read step is held
# to its cap again as it is put on (install_made, lamp_voice::made_skill::put_on_cap). Played on lamp-9adf 5 Nov.
Environment=LAMP_SKILL_READS=on
# A made skill's write (#6066, #6142): a made skill with one fixed write step loads as it is put on; it sends
# only after the owner's yes to its content, at most three a day, never a public post. On in the product (owner, 11 Nov).
Environment=LAMP_SKILL_WRITES=on
# A Store or pushed skill's `do.task` (#6305): its task and grants read for the voice's say-back (task_asks).
# The same line in lamp-skills, lamp-voice, lamp-control, lamp-services, lamp-tasks and lamp-update.
Environment=LAMP_SKILL_TASKS=on
# A made skill's code of its own (#6307): install_made holds its scripts/ to the made cap again as it is put on
# (made_skill::put_on_scripts), and its `do.task` reads back (task_asks). The same line in lamp-skills and lamp-voice.
Environment=LAMP_MADE_SCRIPTS=on
# The lamp's agent's connectors (#6664): a `do.task`'s linked-service grants held as it is put on. The same line in
# lamp-tasks, lamp-skills, lamp-voice and lamp-control. On in the product (owner, 13 Nov).
Environment=LAMP_AGENT_SERVICES=on
# A skill made here is the person's own (#6059): a made say's cooldown held to a minute, not an hour, as it is
# put on (made_skill::capped). The same line in lamp-voice and lamp-skills.
Environment=LAMP_MADE_SKILL_LOOSE=on
# An uploaded SKILL.md run by the lamp's agent (the owner's ruling, 13 Nov; docs/skills.md "Run by the lamp's agent"):
# the file kept whole and followed by Hermes in a fresh home, its grants read from it and said back. The same line
# in lamp-cloud, lamp-voice, lamp-skills and lamp-skills-manage@.
Environment=LAMP_UPLOAD_TO_AGENT=on
# Wellbeing nudges at a present spacing and Comfort break (#5207): the skills' [present] values, as lamp-skills
# loads them, so the app's on and off act on the skills as they run. The same line in lamp-skills.service and lamp-cloud.service.
Environment=LAMP_NUDGES_PRESENT=on
User=root
Group=root
ExecStart=/opt/lampOS/skills/current/lamp-skills asked --dir /var/lib/lampOS/skills --key-file /etc/lampOS/skills/store-key.pub
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=lamp-skills
RuntimeMaxSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/lampOS/skills -/var/lib/lampOS/skills-dev -/var/lib/lampos-skills-state
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE
