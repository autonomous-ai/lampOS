# lampOS skills' manage helper, one request (lampOS/docs/skills.md, "The manage helper"; #1722):
# started by lamp-skills-manage.socket for each connection, as root, the connection its standard
# input and output. `lamp-skills asked` reads one line and checks it itself, whoever connected:
# {"remove": NAME} (a skill's name, never a core skill), lamp-skills' own remove under the folder's
# lock; or {"install": {"url", "sha256", "name", "version"}}, a Skills Store package it fetches
# itself over HTTPS (at most 18 MB within 25 s, redirects only to https) and installs only when it
# is signed with the Store's key (--key-file), never a core skill or a core skill's name,
# and never older than the version installed.
# Or {"off": NAME} / {"on": NAME}, the app's off and on (#2815): kept in lamp-skills' state
# folder, its `off` and `on`. That folder is lampos's, 0700 (the daily journal requires it), so
# the helper keeps one capability, CAP_DAC_OVERRIDE, and nothing else: root without it is held to
# the folder's mode. ProtectSystem=strict still limits its writes to the two paths below.
# It answers one line and exits. Only the skills folder and that state folder are writable; /etc
# is read-only, the key with it.
# Install writes store.conf, which reads the same default-off store.env as lamp-cloud and
# prepares network access for a later install. Off, or with no valid Store key, the helper
# creates no HTTPS client and refuses installs; remove/on/off still work. Network permissions
# in the installed drop-in apply to all requests, including removes; no service starts here.
[Unit]
Description=lampOS skills' manage helper (lamp-skills asked)
CollectMode=inactive-or-failed

[Service]
Type=simple
Environment=LAMP_SKILLS_STORE=off
User=root
Group=root
ExecStart=/opt/lampOS/skills/current/lamp-skills asked --dir /var/lib/lampOS/skills --key-file /etc/lampOS/skills/store-key.pub
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=lamp-skills
RuntimeMaxSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/lampOS/skills -/var/lib/lampOS/skills-dev -/var/lib/lampos-skills-state
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE
