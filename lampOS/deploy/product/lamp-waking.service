# The waking face (#1681, lampOS/docs/ring-choreography.md, "The waking face"): from power-on until the
# voice asks for the ring, the asleep face's warm glow opening up the ring like an eye; pale and slow if no
# voice has asked within 5 minutes. On in the product (#2848), after cold power-ons 3 of 3 on lamp-06c1 (#2847).
# Without LAMP_WAKING_FACE=on it exits at once and makes no socket, and the voice opens the ring as before.
[Unit]
Description=lampOS: the waking face, the ring's light until the voice takes it
# Early in boot, before most of the system, so the ring is lit soon after power.
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
Conflicts=shutdown.target
Before=shutdown.target
# A set-up lamp only: before setup's marker the ring is the setup light's.
ConditionPathExists=/var/lib/lampos-setup/done

[Service]
Type=simple
# Root: the ring's device, as the voice opens it.
User=root
Environment=LAMP_WAKING_FACE=on
ExecStart=/opt/lampOS/setup/current/lamp-setup wake
# The release socket the voice asks on, /run/lampos-waking/release.sock; gone when it ends.
RuntimeDirectory=lampos-waking
RuntimeDirectoryMode=0700
# Its sandbox (#3710): it writes only that socket and the ring's device, /dev/spidev3.0. So the whole file
# system is read-only to it but its runtime directory, which systemd keeps writable; /dev stays as it is.
# No home, its own /tmp, and nothing it starts gains privileges.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-waking

[Install]
WantedBy=sysinit.target
