# lampOS ears: the room microphone: how loud the room is, and a rise, on the bus.
# The product unit (lampOS/docs/install.md).
[Unit]
Description=lampOS ears (lamp-ears)
PartOf=lampos.target
# Not before setup has finished (#806). The target's own condition holds back none of its parts.
ConditionPathExists=/var/lib/lampos-setup/done
After=sound.target local-fs.target lamp-voice.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=lampos
Group=lampos
Slice=lampos-parts.slice
SupplementaryGroups=audio
Nice=5
# The privacy route (docs/privacy-switch.md): Controls reads the lamp's privacy switch (chip 1 line 9, the pins file's
# privacy section), Voice leases the microphones from it and Ears captures only under that lease. Set in Controls,
# Voice and Ears together (the lead on #1711, 20 Oct 09:33: the lamps have the switch; the first builder at 09:51).
Environment=LAMP_PRIVACY_CONTROLS=on
# Room sound classes (#1669, docs/sound-events.md): speech, music, laughter, a door and footsteps scored on the lamp
# from mic1, no audio written, at most one patch under 2 s in memory; music sway (#2834) reads `scores.music` (the
# lead's ask on #5748, 9 Nov). YAMNet's two files are pinned in classes.rs but not yet in models.json (their
# distribution review is open): a lamp without them publishes `invalid_model` and nothing sways.
Environment=LAMP_EARS_CLASSES=on
Environment=LAMP_EARS_CLASSES_MODEL=/opt/lampOS/ears/models/yamnet.onnx
# mic1's capture level, pinned (#694, 21 Oct): --rise-db 30 and the quiet in docs/ears.md were measured at the C-Media
# card's `Mic` capture 4 (-8 dB), lamp-4ace's. lamp-75c9 was left at 20 (+8 dB) and its quiet read 16 dB louder,
# -37.6 against -53.6 at 4. Said once in the journal at each start; a lamp without the card starts ears all the same.
ExecStartPre=-/usr/bin/amixer -c device_cmedia sset Mic capture 4
ExecStart=/opt/lampOS/ears/current/lamp-ears --device plug:device_micro1 --rise-db 30 --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-ears
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=lampos.target
