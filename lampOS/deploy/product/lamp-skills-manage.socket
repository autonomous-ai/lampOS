# lampOS skills' manage helper: the one way a part other than root changes the skills folder
# (lampOS/docs/skills.md, "The manage helper"; #1722). lamp-cloud's skills.remove and skills.install, for the app's
# skills page, ask here instead of writing /var/lib/lampOS/skills, root's, itself: lamp-cloud talks
# to the network and stays ProtectSystem=strict with no writable path for the skills (the first
# builder, 18:33 on #1722). systemd holds the socket and starts lamp-skills-manage@.service as root
# for each connection; nothing listens between requests. Only root and the group lampos may connect.
# In lamp-update's install list (install::PRODUCT): the socket enabled, the template never.
[Unit]
Description=lampOS skills' manage helper socket

[Socket]
ListenStream=/run/lampos-skills-manage/manage.sock
Accept=yes
SocketUser=root
SocketGroup=lampos
SocketMode=0660
DirectoryMode=0755
# One request a connection, a few at once at most.
MaxConnections=4

[Install]
WantedBy=sockets.target
