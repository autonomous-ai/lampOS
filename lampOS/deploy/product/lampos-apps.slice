# The Store apps (#7415): every lampapp@ and lampapp-net@ instance, together held below the lamp's own parts.
# The apps socket's guard reads this path: /lampos.slice/lampos-apps.slice/lampapp@<name>.service.
[Unit]
Description=lampOS apps slice

[Slice]
CPUWeight=50
IOWeight=50
MemoryHigh=192M
MemoryMax=256M
TasksMax=128
