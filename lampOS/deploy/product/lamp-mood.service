# lampOS mood: the lamp's one inner state, awake, energy and warmth, said on the bus as
# mood/state for every behaviour to read (lampOS/docs/mood.md, #1670). It reads metadata only:
# no words, no faces kept, no actuator, microphone or speaker of its own.
# The product unit (lampOS/docs/install.md). Off unless set: a drop-in turns it on,
#   [Service]
#   Environment=LAMP_MOOD=on
# Off, it exits at once with nothing touched, and stays inactive.
[Unit]
Description=lampOS mood (lamp-mood)
PartOf=lampos.target
# Not before setup has finished (#806). The target's own condition holds back none of its parts.
ConditionPathExists=/var/lib/lampos-setup/done
After=local-fs.target lamp-voice.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=lampos
Group=lampos
Slice=lampos-parts.slice
Nice=10
# The lamp's own zone, followed as it changes, for the time of day it dozes by.
ExecStart=/opt/lampOS/mood/current/lamp-mood serve --zone system --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=10s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-mood
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=lampos.target
