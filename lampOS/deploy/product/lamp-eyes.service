# lampOS eyes: the head camera; whether a face is there, where and whose (lampOS/docs/eyes.md).
# The product unit (lampOS/docs/install.md). The camera opens only while the voice permits it.
[Unit]
Description=lampOS eyes (lamp-eyes)
PartOf=lampos.target
# Not before setup has finished (#806). The target's own condition holds back none of its parts.
ConditionPathExists=/var/lib/lampos-setup/done
After=lamp-voice.service lamp-body.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=exec
User=lampos
Group=lampos
SupplementaryGroups=video
Slice=lampos-parts.slice
WorkingDirectory=/
RuntimeDirectory=lampos-eyes
RuntimeDirectoryMode=0755
StateDirectory=lampos-eyes
StateDirectoryMode=0700
# Looking is never worth a late word.
Nice=10
Environment=LAMP_BUS=on
# room/activity and room/stood_up, which watch you leave and stretch break
# read (#2834, eyes.md): the sitter followed by place only, never told by a
# face print, though --recogniser is passed, until that path's privacy read.
Environment=LAMP_ACTIVITY=place
# Whether each face is speaking, from YuNet's five marks, on humans/faces/tracked: the voice's
# LAMP_SECOND_SPEAKING_FACE reads it (#720, #2008; the lead, 21 Oct 07:19 on #1711).
Environment=LAMP_EYES_SPEAKING=on
# Paired with Voice: remember only the face proven to have said the request,
# using its same-line print and fresh frames under one camera permission hold.
Environment=LAMP_REMEMBER_SPEAKER=on
# How the near face seems, on humans/seems for Mood's LAMP_MOOD_SEEMS (#1671, #2799): Google's
# Blendshape V2 from Face Mesh V2's points, both placed by install (models.json). FER+ (`--seems`)
# never runs here: its training pictures are for research only. Nothing is read without the
# lamp's kept yes, for everyone it sees, in /var/lib/lampOS/consent/face-expressions.json (privacy-switch.md). The mesh
# runs on the look, one a look, so the speaking read above reads the lips, and the read takes its
# points on its own thread, off the look (eyes.md).
# The full look: the camera at 1280x960, and "what do you see" answered from one still, at most 1024
# across, kept in look.jpg for 15 s (LAMP_LOOK_FULL in the voice). The sight file's working frame is
# encoded from the look's own decoded picture (--sight-from-look, #2748). On lamp-75c9 it cost about
# 12 ms a look (125 to 137.5 ms, an empty desk; #2791's product half).
# The camera is taken by its ids on whichever USB port it is (#4074: 3-1.1.4 on lamp-4ace and
# lamp-52e6, 3-1.3.4 on lamp-a63e and lamp-dbda), found at each open; none or two is refused.
# A camera that stops opening (#2892, lamp-52e6 after a voice restart) is re-authorized by
# lamp-eyes-camera.socket's root helper, asked after three failed opens, at most once a minute.
ExecStart=/opt/lampOS/eyes/current/lamp-eyes --lock-directory /run/lampos-locks/camera --usb 01da:5875 --model /opt/lampOS/eyes/models/face_detection_yunet_2023mar.onnx --recogniser /opt/lampOS/eyes/models/face_recognition_sface_2021dec.onnx --permit-socket /run/lampos-eyes/permit.sock --body-socket /run/lampos-body/gaze.sock --presence-file /run/lampos-eyes/present --sight-file /run/lampos-eyes/sight.jpg --people /var/lib/lampos-eyes/people.json --who-socket /run/lampos-eyes/who.sock --known-file /run/lampos-eyes/known --mouth-model /opt/lampOS/eyes/models/face_mesh_v2.onnx --seems-blendshapes /opt/lampOS/eyes/models/face_blendshapes.onnx --full-look 1280x960 --full-look-file /run/lampos-eyes/look.jpg --sight-from-look on --camera-helper /run/lampos-eyes-camera/camera.sock
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-eyes
NoNewPrivileges=yes

[Install]
WantedBy=lampos.target
