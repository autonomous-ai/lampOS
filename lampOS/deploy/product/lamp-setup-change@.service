# lampOS changes after setup (#1959, lampOS/docs/setup.md, "Changed after setup"): one request from
# lamp-cloud on lamp-setup-change.socket, as standard input and output. It writes with setup's own
# writers, answers, and after a zone change restarts lamp-schedule once the lamp is quiet (45 s,
# an update's rule) and no update is at work (holding lamp-update's lock), waiting at most 30 minutes;
# after a new language (#4473) restarts lamp-voice once it rests between turns (5 s, at most 45 s),
# holding the same lock. The owner's two yeses from the app (#5500): written or removed, and after a
# new room sounds yes lamp-ears restarted once no update is at work. The app's restart and shutdown too (#2193, #3697):
# answered first, then lampos.target restarted (this instance is not part of it) or lamp-setup
# shutdown started.
[Unit]
Description=lampOS changes after setup: one change
CollectMode=inactive-or-failed

[Service]
Type=simple
# Root: the person's name, /etc/localtime, /etc/timezone, zone.env and the language are root's,
# as setup writes them, and lamp-schedule's and lamp-voice's restarts; so are lamp-control's drop-in
# (the owner's developer setting, under /etc/systemd/system, below /etc's ReadWritePaths), systemd's
# reload and lamp-control's restart or stop.
User=root
# LAMP_NOTICING_BY_DEFAULT: its why and rules are its row in docs/switches.md (#7767). Root's helper reads it from
# this unit, never from lamp-setup's or lamp-cloud's (change::apply): with it on, the app's offs keep a no. The
# same line in lamp-seen, lamp-eyes, lamp-ears, lamp-skills, lamp-cloud, lamp-setup and lamp-voice.
Environment=LAMP_NOTICING_BY_DEFAULT=on
ExecStart=/opt/lampOS/setup/current/lamp-setup change --config /etc/lampOS/setup/serve.json --bus-root /run/lampos-bus --enable
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=lamp-setup-change
RuntimeMaxSec=35min
NoNewPrivileges=yes
ProtectSystem=strict
# /etc for the zone's link and /etc/timezone, written beside and renamed into place; the bus
# for the voice's state, read to judge quiet; lamp-update's lock (0700), taken for the app's
# restart and shutdown (#3697), which then run systemctl and systemd-run; the owner's face expressions
# and room sounds yeses from the app (#5500, root:lampos 0640 in the 0750 folder lampos.conf makes),
# and after a new room sounds yes lamp-ears' try-restart under the same lock; the privacy light's look
# from the app (#8696, root's 0600 in the 0700 light folder lampos.conf makes), only from lamp-cloud.
ReadWritePaths=/etc /run/lampos-bus -/var/lib/lampos-update -/var/lib/lampOS/consent -/var/lib/lampOS/light
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
