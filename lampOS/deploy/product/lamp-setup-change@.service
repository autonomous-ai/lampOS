# lampOS changes after setup (#1959, lampOS/docs/setup.md, "Changed after setup"): one request from
# lamp-cloud on lamp-setup-change.socket, as standard input and output. It writes with setup's own
# writers, answers, and after a zone change restarts lamp-schedule once the lamp is quiet (45 s,
# an update's rule) and no update is at work (holding lamp-update's lock), waiting at most 30 minutes. The app's restart and shutdown too (#2193, #3697):
# answered first, then lampos.target restarted (this instance is not part of it) or lamp-setup
# shutdown started.
[Unit]
Description=lampOS changes after setup: one change
CollectMode=inactive-or-failed

[Service]
Type=simple
# Root: the person's name, /etc/localtime, /etc/timezone and zone.env are root's, as setup
# writes them, and lamp-schedule's restart.
User=root
ExecStart=/opt/lampOS/setup/current/lamp-setup change --config /etc/lampOS/setup/serve.json --bus-root /run/lampos-bus --enable
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=lamp-setup-change
RuntimeMaxSec=35min
NoNewPrivileges=yes
ProtectSystem=strict
# /etc for the zone's link and /etc/timezone, written beside and renamed into place; the bus
# for the voice's state, read to judge quiet; lamp-update's lock (0700), taken for the app's
# restart and shutdown (#3697), which then run systemctl and systemd-run.
ReadWritePaths=/etc /run/lampos-bus -/var/lib/lampos-update
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
