# lampOS updates: keeps the lamp's lampOS current by itself (lampOS/docs/updates.md).
# The product unit (lampOS/docs/install.md). Not part of lampos.target: an update restarts the
# lamp's parts, and what restarts them must not be stopped with them. It runs before setup is
# done too, so a lamp still in its box is current when it is first set up.
# On: a lamp in a home installs, switches at a quiet moment and puts a build back by itself.
# The public key it checks every build with comes with the image (#806), never from the channel.
# It follows the stable feed: a lamp in a home gets only a build promoted to it after its checks (docs/updates.md,
# "Selecting a published build for the stable feed"), never each lamp-voice publish. The signed channel stays lamp-voice.
[Unit]
Description=lampOS updates (lamp-update serve)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
# A lamp-update that fails, a new build of its own that cannot start among them, starts lamp-update-back, which puts
# its previous build back while that switch is unconfirmed, and otherwise does nothing (lampOS/docs/updates.md).
OnFailure=lamp-update-back.service

[Service]
Type=simple
User=root
Group=root
Slice=lampos-parts.slice
Nice=10
IOSchedulingClass=idle
ExecStart=/opt/lampOS/update/current/lamp-update serve --channel-url https://github.com/autonomous-ai/lampOS/releases/download/lampos-stable/ --channel lamp-voice --key-file /etc/lampOS/update/key.pub --apply on
Restart=on-failure
RestartSec=30s
StandardInput=null
SyslogIdentifier=lamp-update
NoNewPrivileges=yes
ProtectSystem=strict
# The product skills' folder: a round places the build's own there (lampOS/docs/updates.md);
# and lamp-skills' state folder, where a round keeps the core skills turned on (its `on`).
ReadWritePaths=/opt/lampOS /etc/systemd/system -/var/lib/lampOS/skills -/var/lib/lampos-skills-state -/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes
StateDirectory=lampos-update
StateDirectoryMode=0700
Environment=LAMP_BUS_ROOT=/run/lampos-bus
# The updater moves to each build's own lamp-update too, confirmed by a signed dry round and put back by
# lamp-update-back within 10 min otherwise (docs/updates.md, "lamp-update switching itself"; shown on
# lamp-4ace 20 Oct). Without it this unit's updater can change only by running install again on the lamp,
# which a customer's lamp never has: so a later build could never carry units or settings to it (25 Oct).
Environment=LAMP_UPDATE_SELF=on

[Install]
WantedBy=multi-user.target
