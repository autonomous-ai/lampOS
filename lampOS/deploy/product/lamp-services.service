# lampOS linked services (Queue #4710): the person's Gmail, Google Calendar and Drive, Notion, Figma,
# GitHub, Linear, Asana, Ahrefs and Facebook Page links, kept by this one root process in
# /var/lib/lampos-services (0700; one 0600 file a service). Two doors, each answering only its one
# asker by SO_PEERCRED and cgroup, whatever the socket's group lets connect: admin.sock
# (lamp-cloud.service: set, remove, wipe, list) and tools/ with tools.json and call.sock
# (lamp-voice.service: services_connected, service_read, service_write). Not socket-activated like
# lamp-setup-keys: a write waits here, in memory, for its spoken "send" (2 min, once).
# Reads, and sends with LAMP_SERVICES_WRITE=on (below). A token is never journalled.
# The product unit (lampOS/docs/install.md). On for reads, with the same line in lamp-cloud.service
# and lamp-voice.service: read on lamp-9adf on build 9928's own binaries on 4 Nov (Google Calendar, by
# voice, the owner's face seen saying it). A drop-in setting LAMP_SERVICES=off turns it off: then it
# exits at once with no socket opened, and stays inactive.
[Unit]
Description=lampOS linked services (lamp-services)
PartOf=lampos.target
# Not before setup has finished (#806), and only with setup's account and the voice's key, as
# lamp-cloud: systemd fails a unit whose LoadCredential= file is missing, and on lamp-75c9 (a dev
# lamp never set up from the app, no backend.json) on 4 Nov it failed 18 times and stayed failed.
# Without the account lamp-cloud is off too, so no link could reach this unit anyway; skipped, it
# stays inactive, and lampos.target starts it once both are there.
ConditionPathExists=/var/lib/lampos-setup/done
ConditionPathExists=/etc/lampOS/setup/backend.json
ConditionPathExists=/etc/lampOS/voice/credential
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# Root, for the store only root reads and the factory reset's plan wipes as root's; group lampos, so
# the sockets it makes (0660) let lamp-cloud (lampos) and the voice connect, and the peer check then
# tells them apart. It holds no capability (CapabilityBoundingSet= below), a narrow system-call set,
# and sees the system read-only but for its own two folders.
User=root
Group=lampos
Slice=lampos-parts.slice
Nice=5
UMask=0077
# The backend's link and the lamp's key, as lamp-cloud reads them: for an OAuth token's refresh
# through the backend (POST <base>/connector/refresh-token), nothing else. Both are conditions
# above, since a missing one would fail the unit.
LoadCredential=account:/etc/lampOS/setup/backend.json
LoadCredential=key:/etc/lampOS/voice/credential
# Reads on (the header), and sends: a "send" needs a voice print, which lamp-voice.service now makes for
# the services alone (LAMP_SAME_VOICE_MODEL, LAMP_SAME_VOICE_FOR=services). Before it, on lamp-9adf on
# 4 Nov, every send was refused for its voice (services.md). A drop-in setting LAMP_SERVICES_WRITE=off
# leaves reads only.
Environment=LAMP_SERVICES=on
Environment=LAMP_SERVICES_WRITE=on
# A made skill reads a linked service to its owner alone (#5288, #5303): the lamp-skills.service cgroup
# onto the tools socket for service_read alone, any other call refused. Played on lamp-9adf 5 Nov.
Environment=LAMP_SKILL_READS=on
# A made skill's write (#6066, #6142): its one fixed write sent, with LAMP_SERVICES_WRITE above, only when the
# owner's yes holds that content's SHA-256, at most 10 a skill and 30 in all a day, never a public post. On in the
# product (owner, 11 Nov).
Environment=LAMP_SKILL_WRITES=on
# A skill's run on the lamp's Hermes (#6432, services.md): the lamp-control.service cgroup onto the tools socket
# for service_read and service_write alone, by the run's grants; a write still waits for the person's yes.
Environment=LAMP_SKILL_TASKS=on
# A skill's keys given in the app (#6686, docs/skills.md "Its keys, given in the app"): kept root-only in the store's
# skill-secrets folder, set and listed (names only) from lamp-cloud's admin door, read by lamp-tasks.service alone.
Environment=LAMP_SKILL_SECRETS=on
ExecStart=/opt/lampOS/services/current/lamp-services --store /var/lib/lampos-services --run /run/lampos-services
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-services
NoNewPrivileges=yes
# The sockets' folder, root:lampos 0750 (tools/ inside it 0755, tools.json 0644).
RuntimeDirectory=lampos-services
RuntimeDirectoryMode=0750
# The tokens' store; the factory reset's plan wipes it.
StateDirectory=lampos-services
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Back from @resources for the PDF reader's child alone (lamp-services --pdf-text, services.md): it
# caps its own memory (RLIMIT_AS, RLIMIT_DATA, 128 MiB) before it parses. With no capability a limit
# is only ever lowered, or a soft one raised to its hard one.
SystemCallFilter=setrlimit prlimit64
# The services and the backend (AF_INET, AF_INET6); its own sockets (AF_UNIX).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=lampos.target
