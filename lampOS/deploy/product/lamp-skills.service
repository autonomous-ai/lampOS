# lampOS skills: physical skills, each a folder in /var/lib/lampOS/skills (lampOS/docs/skills.md).
# The product unit (lampOS/docs/install.md); install puts Welcome back in that folder (#811).
# A skill speaks only through the voice's say service (LAMP_SAY=on in lamp-voice.service, its
# socket in the group lampos); the voice's own hello is off there, so only Welcome back greets.
# LAMP_SKILLS_ASK=skip acts without asking the Policy, whose gate is not built yet (#939);
# without it every skill is asked about and refused, and nothing is done.
[Unit]
Description=lampOS skills (lamp-skills)
PartOf=lampos.target
# Not before setup has finished (#806). The target's own condition holds back none of its parts.
ConditionPathExists=/var/lib/lampos-setup/done
After=local-fs.target lamp-voice.service lamp-body.service lamp-actions.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=lampos
Group=lampos
Slice=lampos-parts.slice
Nice=10
Environment=LAMP_SKILLS_ASK=skip
# A skill's light is asked of the ring (#1132): the ring's half is the voice's LAMP_LIGHT_REQUESTS (17 Oct).
Environment=LAMP_LIGHT_REQUESTS=on
# --zone system: the lamp's zone from /etc/localtime, which setup points at the person's (#820), for a skill's
# [quiet] hours, which without it never start themselves (docs/skills.md); across summer time (#1384).
ExecStart=/opt/lampOS/skills/current/lamp-skills --dir /var/lib/lampOS/skills --bus-root /run/lampos-bus --gaze-socket /run/lampos-body/gaze.sock --mood-socket /run/lampos-body/mood.sock --actions-socket /run/lampos-actions/call.sock --say-socket /run/lampos-say/say.sock --tools-dir /run/lampos-actions/skills --zone system
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-skills
NoNewPrivileges=yes
ProtectSystem=strict
# The bus, and its tools beside the actions part's, which the voice reads at each session.
ReadWritePaths=/run/lampos-bus /run/lampos-actions
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=lampos.target
