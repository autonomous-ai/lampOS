# lampOS voice: listens, talks with the model, speaks and drives the light ring (lampOS/docs/serve-runtime.md).
# The product unit (lampOS/docs/install.md): every lamp's, with the office lamp's options and switches of
# 2026-10-17 (lamp-4ace's unit that day, without what only the office has). A lamp that needs a switch off says so in lamp-voice.service.d/, never here.
# Root: it reads /etc/lampOS/voice (the credentials and the second route's settings) and runs its microphone and
# speaker real-time.
[Unit]
Description=lampOS voice (lamp-voice serve)
PartOf=lampos.target
# Not before setup has finished (#806). The target's own condition holds back none of its parts.
ConditionPathExists=/var/lib/lampos-setup/done
# Memory, actions, schedule and tasks answer its calls from the first turn: all first.
After=network-online.target sound.target lamp-memory.service lamp-actions.service lamp-schedule.service lamp-tasks.service
# The image's speaker level, set by udev when the C-Media card appears (lampOS/docs/install.md): after it, so the
# first word is at its level. Not Wanted: a lamp without that card or unit starts the voice all the same.
After=lamp-cmedia-speaker.service
Wants=network-online.target
# Controls publishes the privacy switch the voice leases the microphones by (docs/privacy-switch.md): the voice
# starts after it and, at a shutdown or reboot, stops before it. Stopped after Controls, the voice saw the switch
# go unreadable, ended with 1, and the next boot came up muted by the restart guard (lamp-52e6, 27 Oct, #3697).
# A publisher not yet up at start is waited for with the microphones closed, never an exit.
After=lamp-controls.service
Wants=lamp-controls.service
# The waking face (#2848, lampOS/docs/ring-choreography.md, "The waking face"): every start of the voice, at
# power-on, the app's Restart, an update round or a crash restart, starts it again, so the ring opens like an
# eye until the voice asks for it. A face still up isn't started twice. It's no part of lampos.target, so a
# stop of the voice leaves it alone.
Wants=lamp-waking.service
After=lamp-waking.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=exec
User=root
Group=root
Slice=lampos-voice.slice
# Kept from reclaim (#7383): under an agent's work the board swaps, and the voice's pages went out with the rest.
# With MemoryMin they are reclaimed last. Measured: lamp-voice MemoryCurrent 105-119 MB on lamp-c0a4 (17 Nov), so
# 256M covers it with room. The OpenClaw gateway keeps no MemoryHigh (#6226), so the voice protects itself. The
# protection takes effect only with the same on each ancestor slice: lampos-voice.slice and lampos.slice.
MemoryMin=256M
WorkingDirectory=/
UMask=0077
ExecStart=/opt/lampOS/voice/current/lamp-voice serve /etc/lampOS/voice/provider.json /var/lib/lampOS/voice/sessions/${INVOCATION_ID} --noise-suppression off --turn-taking duplex --faint-floor-db -28 --microphone mic2 --reference-clock capture --reference-recovery bounded --provider-continuation kept-start --playout-start-ms 350 --ring-channel-ceiling 24 --end-silence-ms 600 --controls-stop --endpoint smart-turn-fast --call-wait-ms 2000 --controls-mute /var/lib/lampOS/voice/mute/record.json --failure-notice-dir /opt/lampOS/voice/notices --failure-notice-language en-US
# The lines recorded in the lamp's own voice, loaded once at start (lampOS/docs/failure-notices.md): the offline line,
# back online, the voice service's line and the Wi-Fi helper's no-Wi-Fi line, placed by lamp-update install from
# deploy/product/models.json (#1844). With no directory or no manifest every notice stays silent, and
# failure_notice_capability says why.
# Microphone and speaker threads may not wait behind other work (lamp-4ace, 2026-10-13).
CPUSchedulingPolicy=rr
CPUSchedulingPriority=20
# With LAMP_VOICE_LOCK_CODE=on (off here) the voice and each worker lock their code's file pages, the executable's
# and its shared libraries' text, so an SD log flush can't evict them (#5611, serve-runtime.md). As root, CAP_IPC_LOCK
# already lifts the limit, so this changes nothing today; it is there for a future non-root unit, or one without that
# capability. Not a bound: the limit counts each process's locked bytes, the same shared text again in each, and no
# lamp has measured them yet. What may be locked is bounded by the code instead: file text only, never the heap or
# the models.
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=4s
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-voice
NoNewPrivileges=yes
RuntimeDirectory=lampos-voice
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment=LAMP_THREAD_FILE=/run/lampos-voice/thread.json
Environment=LAMP_ONBOARDING_FILE=/var/lib/lampOS/voice/onboarding/progress.json
# LAMP_ONBOARDING: its why and rules are its row in docs/switches.md (#2843, #3430).
Environment=LAMP_ONBOARDING=on
# The walk's done line also names a few things to try first, once per setup (#5316, docs/onboarding.md "The walk's
# last words name a few things to try"). Played on lamp-52e6, build 12587: the closing quoted, tries_said true.
Environment=LAMP_ONBOARDING_FIRST_TRIES=on
# The walk waits for the first update after setup (#6284, docs/onboarding.md "Held for the first update"): one line
# when a newer build is read, one when it has switched. With setup's and lamp-update's.
Environment=LAMP_FIRST_UPDATE=on
Environment=LAMP_BUS=on
# LAMP_PRIVACY_CONTROLS: its why and rules are its row in docs/switches.md (#1711).
Environment=LAMP_PRIVACY_CONTROLS=on
# LAMP_PRIVACY_RIDES_STALL: its why and rules are its row in docs/switches.md (#5611, #5224).
Environment=LAMP_PRIVACY_RIDES_STALL=on
Environment=LAMP_BUS_ROOT=/run/lampos-bus
Environment=LAMP_BUS_AUDIO=on
Environment=LAMP_ATTENTION=busy-near
Environment=LAMP_AIR_FACTS=on
# Asked how it is, the lamp names its unwell parts and keeps quiet about them otherwise (#1681, docs/health.md).
# On lamp-06c1 on 13 Nov (12587, #6860): three parts stopped, "How are you?" named all three, the time question none.
Environment=LAMP_HEALTH_FACTS=on
Environment=LAMP_RING_EYE=strong
Environment=LAMP_SHORT_SOUNDS=quiet-room-checked
# LAMP_TURN_END_PRIORITY: its why and rules are its row in docs/switches.md (#1608, #2602).
Environment=LAMP_TURN_END_PRIORITY=10
Environment=LAMP_TURN_END_NO_SPIN=on
Environment=LAMP_FIRST_OUTPUT=/var/lib/lampOS/voice/first-output
# The lamp's voice is the second route since 19 Oct (the owner, #1712; lampOS/docs/second-voice.md, "Second only"):
# speech to text, DeepSeek's text model and search, and the configured voice (ElevenLabs, eleven_v4_turbo) answer
# every turn, all through the Autonomous relay; Gemini Live is not used. Live stays a per-lamp setting: a drop-in with
# Environment=LAMP_VOICE_ROUTE=gemini. It needs two files in /etc/lampOS/voice, both placed by install and the
# updater, and nothing for a person to add: second.json (deploy/product/settings/second.json) and the relay key it
# names for every service, credential (the one provider.json names; setup takes the user's). Without either the
# voice does not start, and never falls back to Live: lamp-selftest's "voice route" says which is missing.
Environment=LAMP_VOICE_ROUTE=second
Environment=LAMP_VOICE_SECOND_CONFIG=/etc/lampOS/voice/second.json
Environment=LAMP_SECOND_CHAT=deepseek
Environment=LAMP_SECOND_SEARCH=deepseek
Environment=LAMP_SECOND_SPEECH_MODEL=eleven_v4_turbo
# DeepSeek's chat and search go through the relay, at the address the voice derives from second.json's llm_base_url
# (second_config::relay_deepseek, #2978) with its llm_credential_file,
# so no deepseek.key (#1934, #1939). Not LAMP_SECOND_DEEPSEEK_BASE_URL here: an address the unit gives is never
# routed, so with LAMP_RELAY_ROUTES the relay may name a nearer one (#2882, the first builder's (a)).
Environment=LAMP_SECOND_DOWN_LINE=on
Environment=LAMP_SECOND_WAIT_CUE=on
Environment=LAMP_SECOND_LOOK=on
# A skill's look on this route (Look for things, in the Skills Store): without it the lamp says it will look and never
# does. On lamp-9adf on 3 Nov "can you find my glasses?" looked five places and said what it saw at each (#4710).
Environment=LAMP_SECOND_SKILL_LOOK=on
# Each turn told and kept for the person (or the room) admitted with its request, not the session's owner: the lead's
# decision of 21 Oct on #1711, after the two-person run on lamp-52e6 (11 of 12, nothing crossed; #1895, #2233).
Environment=LAMP_SECOND_SCOPED_CONTEXT=on
# LAMP_SECOND_STEADY_FIRST: its why and rules are its row in docs/switches.md (#2135, #2593).
Environment=LAMP_SECOND_STEADY_FIRST=on
Environment=LAMP_SECOND_CHAT_WARM=on
Environment=LAMP_SECOND_SPEECH_WARM=on
Environment=LAMP_SECOND_STT_WARM=on
# LAMP_SECOND_PLAYOUT_START_MS: its why and rules are its row in docs/switches.md.
Environment=LAMP_SECOND_PLAYOUT_START_MS=100
# LAMP_SECOND_NAME_CARRIES: its why and rules are its row in docs/switches.md.
Environment=LAMP_SECOND_NAME_CARRIES=on
# LAMP_CALL_TAKES_NEXT_LINE: its why and rules are its row in docs/switches.md (#3396, #3411).
Environment=LAMP_CALL_TAKES_NEXT_LINE=on
# LAMP_FIRST_SECONDS_QUIET: its why and rules are its row in docs/switches.md (#3711).
Environment=LAMP_FIRST_SECONDS_QUIET=on
Environment=LAMP_SECOND_OPEN_NAME=on
Environment=LAMP_NAME_NEAR=on
Environment=LAMP_NAME_SECOND_SIGN=on
# LAMP_NAME_AS_A_SENTENCE: its why and rules are its row in docs/switches.md (#5277, #6078).
Environment=LAMP_NAME_AS_A_SENTENCE=on
# LAMP_NAME_SAID_TO_A_PERSON: its why and rules are its row in docs/switches.md (#3945, #5233).
Environment=LAMP_NAME_SAID_TO_A_PERSON=on
# LAMP_NAMED_ALWAYS: its why and rules are its row in docs/switches.md (#2191).
Environment=LAMP_NAMED_ALWAYS=on
# A hearing of the name inside one line's sound stays with that line: on lamp-4ace on 26 Oct (6919) a hearing in
# "Can you pass me the charger? The white one." counted for the desk line begun 0.7 s after it, which was answered.
Environment=LAMP_NAME_STAYS_IN_ITS_LINE=on
# The conversation's windows measured to when a line began (#4594): on lamp-4ace on 31 Oct (9063) off then on, talk
# answered 41/43 against 42/43 and desk lines left alone 0/4 against 2/4 (the first builder on #4604).
Environment=LAMP_WINDOW_FROM_START=on
# The line's end: a 0.5 s line is a line, a short one gets the end-of-turn model's verdict, an unsure one waits.
Environment=LAMP_ENDPOINT_LEAST_SPEECH_MS=500
Environment=LAMP_ENDPOINT_SHORT_VERDICT=on
Environment=LAMP_ENDPOINT_UNFINISHED_BELOW=0.5
Environment=LAMP_ENDPOINT_UNSURE_MS=1200
Environment=LAMP_SECOND_UNFINISHED_WAIT=on
Environment=LAMP_JOIN_CUT_WORDS=on
# An ask cut short by a line let out that the model only declines is answered in its place (#5961).
Environment=LAMP_CUT_ASK_ANSWERED=on
Environment=LAMP_REPLY_END_REACH=on
# Its own voice heard back, a cut-in told as one, words said once, and a reply that is not for it.
Environment=LAMP_SECOND_OWN_ECHO=on
Environment=LAMP_CUT_IN_TOLD=on
# A stop said over the lamp's answer, or within 3 s after it ended ("Stop", "Stop Lamp", "That's enough."), is
# answered "Okay, I'll stop there." and kept in the thread, never asked of the model (#3985, #4710).
Environment=LAMP_SPOKEN_STOP_ENDS=on
# LAMP_STOP_WORDS_KEYTERM: its why and rules are its row in docs/switches.md (#5111, #5076, #1711).
Environment=LAMP_STOP_WORDS_KEYTERM=on
# A short stop over the answer reads as neither talk nor quiet, and the answer went on: on lamp-06c1 9 of 9 spoken
# stops were lost (#5032). Everything heard while the lamp speaks goes to the speech to text, and a short stop command
# stops the answer as the hand does, whether or not the lamp paused: on lamp-52e6 on 11 Nov a 0.5 s "Stop." made no
# pause, so `heard` (a pause's audio only) never heard it (the lead's call on #5905). Its words only judge a stop and are
# never kept (the first builder's condition on #5032). Its cost: the whole answer's audio streamed (stop-word.md).
# PARKED (#5905): off in the product; turning it on waits for the stop keyword spotted by lamp-name's on-mic
# model (the first builder's ruling on #5905, 15 Nov). To turn it on, uncomment the next line.
#Environment=LAMP_STOP_WORDS=heard-always
# An answer cut by a line or a stop is kept as the words that were played, so "go on" picks up from the cut
# (#3997): probe-cut-in on lamp-06c1 on 30 Oct, resume 19/20 to 20/20 with LAMP_CUT_IN_TOLD; two played demos, 2 of 2.
Environment=LAMP_SAID_AS_HEARD=on
# A cough, beep or knock that cuts the lamp's answer with no words is asked "Um, excuse me, did anyone say
# something?", rendered ahead, so the lamp is not left quiet mid-story (#4710): on by the memory owner's call, 4 Nov.
# Known gap, accepted: the lamp's own echo can commit as a cut-in with 0 words and be asked (7 of 15 stories on
# lamp-06c1, 3 Nov, #4938); a later echo fix from duplex makes those asks fewer.
Environment=LAMP_CUT_IN_WORDLESS_ASKS=on
# LAMP_CUT_IN_WORDLESS_RESUMES (a busy room's cut goes on from the sentence it cut) is off for the candidate
# (the PM, 6 Nov): its lamp check on lamp-06c1 came back FAIL, partial, with the busy room and the second and third
# cuts never reached (#5430). It comes back on once that path passes on a lamp.
Environment=LAMP_SECOND_SAID_ONCE=on
# A light, volume or timer turn answered at once with the acting part's own result, a single ask ending there, in
# English only (#2135, #4700): on lamp-4ace on 31 Oct (d06603109f) off and on alternating, timers and reminders 2.06-2.20 s
# against 2.95-3.27 s, a real light change 1.82-1.89 s, nothing said twice (the first builder on #4710, 17:35).
Environment=LAMP_SECOND_SAY_WITH_CALL=on
# An earlier turn that ran a light or volume step is told to the model as the call, then its words, so an ask
# is not learned as words alone (#5018): on lamp-9adf at 9730, 10 of 10 device lines called, 0 talk-only (4 of 14 off).
Environment=LAMP_HISTORY_KEEPS_CALLS=on
# Each turn is told the light as light/state says it now: on lamp-52e6 at 9928 (4 Nov), "what colour is the light?"
# was answered "White" three times while the light was warm at level 1, as the voice could not read it.
Environment=LAMP_LIGHT_TOLD=on
# A reply claiming a light, volume or timer action no call made is asked again once, then said not done: on lamp-52e6
# "Timer set. It rings at 9:39 am." (9928) and "Louder."/"Brighter."/"Cooler." came with no call (#5215).
Environment=LAMP_ACTION_CLAIM_CHECKED=on
# And a skill said removed, off, on or made with no make_skill call (#7587: "Moon time is removed." on lamp-9adf).
Environment=LAMP_ACTION_CLAIM_SKILLS=on
# The owner's line is told which services are linked in the app, so "what can you do with my calendar?"
# is answered from it, not as the app's job (#5523).
Environment=LAMP_SERVICES_TOLD=on
Environment=LAMP_NOT_FOR_ME_WORDS=on
Environment=LAMP_BUSY_ENDS_SOONER=on
# Talk over the lamp's own line (a say, a reminder, news) in a busy room is let go and the line goes on; its name,
# a turned face or a tap still stops it (#2602's design, #4933): on lamp-52e6 a talk-over say was spoken 3/3 (3 Nov),
# dropped 5/5 with it off; name 2/2, face 3/3, quiet room 3/3 still cut it (2 Nov).
Environment=LAMP_OWN_LINE_OVER_TALK=on
# A few emotion tags in the second route's speech ([laughs], [sighs], [whispers], [excited]), read by
# LAMP_SECOND_SPEECH_MODEL's eleven_v4_turbo (#2901): the owner's pick at lamp-52e6 on 28 Oct, first sound unchanged.
Environment=LAMP_SECOND_SPEECH_TAGS=on
# The weather for any place and day. LAMP_SECOND_FACE_NAME is on below, beside LAMP_PERSON_SCOPE_SEEN, which binds a
# turn to the person seen speaking it (reviewer-two's condition on #3371).
Environment=LAMP_SECOND_WEATHER=on
# LAMP_SECOND_MEMORY_HITS: its why and rules are its row in docs/switches.md (#2176, #3371).
Environment=LAMP_SECOND_MEMORY_HITS=on
# The owner's approximate place from the app, city level (#4333): told only beside a line that needs a place
# ("near me", the weather). The lead's yes on 3 Nov; shown on lamp-0c89 on 30 Oct (asked nothing back, and asked after a clear).
Environment=LAMP_OWNER_PLACE=on
# The owner's chosen voice and character words (#5394): spoken in the chosen voice, the words told after its
# character; the same line in lamp-cloud.service. On in the product on 12 Nov for the lead (#6590).
Environment=LAMP_CHOSEN_VOICE=on
# Speed: the relay's near routes, the chat's connection kept, the link said for lamp/online.
Environment=LAMP_RELAY_ROUTES=on
Environment=LAMP_SECOND_CHAT_KEPT=on
# The model service refusing every turn (#4265; lamp-52e6 30 Oct, the lead's call on #1711): said once and held,
# a line sent each minute to find it back; a skill's fixed words are said meanwhile, a note the model words waits.
Environment=LAMP_SECOND_REFUSED_HOLD=on
Environment=LAMP_VOICE_LINK=on
# LAMP_CAMERA_FOLLOWS_EYES: its why and rules are its row in docs/switches.md (#2233, #2402).
Environment=LAMP_CAMERA_FOLLOWS_EYES=on
# A line another face was seen speaking is the room's, not the known person's (#2008, with lamp-eyes'
# LAMP_EYES_SPEAKING): "seeing who speaks", which the lead's decision puts on with scoped context.
Environment=LAMP_SECOND_SPEAKING_FACE=on
# The eyes' own switch, read by the voice too: with it the voice reads the face seen saying a line that asks to
# forget, so a room's "forget my face" forgets only a face seen saying it and a held forget's yes counts only from
# that face (#3038, #3037, #2377). Without it every room's forget is told NOT_THEIRS.
Environment=LAMP_EYES_SPEAKING=on
Environment=LAMP_NAME_NOTE=on
Environment=LAMP_NAME_NOTE_BUSY=face
Environment=LAMP_EXPRESSION_OUT=on
Environment=LAMP_FAINT_HOLD_MS=400
Environment=LAMP_TOOLS=on
Environment=LAMP_CLOCK=on
# The time of another place, named, and the lamp's own beside it (#1547; lamp-4ace 18 Oct 19:41, 8 of 8 right).
Environment=LAMP_TIME_PLACES=on
# Tell the time only once the kernel says the clock is set: no battery clock (#811, #830).
Environment=LAMP_KERNEL_CLOCK=on
Environment=LAMP_SESSION_FACT=on
# Switched on lamp-4ace through 16 and 17 October and run there all day; several only in the groups of #1238's
# census, so their lamp record is that day's running, not a run of their own (install.md).
# Not here: the stop words and the voice link (lamp-4ace's alone), the office's own (its Harness target, its say group); those that need
# another part's flag the product doesn't pass (the Policy holding actions, its hello and progress news, the full
# look); and "that was weird", a builder's review tool whose marks the reset doesn't wipe (#1332's review).
Environment=LAMP_TOOL_LEAD_IN=on
Environment=LAMP_WAIT_KEEPS_ANSWER=on
# A heard request answered only "One moment." or "Let me check." with nothing called is asked once to go on
# (holding-answer.md, #4711), on Live and the second route alike: the coordinator passes `--holding-answer` to its
# provider and second workers. The safety net for the "Let me check." dead-end (#7458); on in the product (17 Nov).
Environment=LAMP_HOLDING_ANSWER=on
Environment=LAMP_STOP_TOLD=on
Environment=LAMP_ASKER_FIRST=record
Environment=LAMP_NAMES=checked
# A known face giving another name is asked before a rename, and only their yes renames it, the old name kept as an
# alias (#5485, docs/eyes.md): 9 of 9 on lamp-52e6, 9 Nov; re-run on 13143, 15 Nov (#6859). Accepted risk, the first
# builder's on #6594: with no face seen speaking, a voice off camera can start the ask and give the yes; it renames
# only a face already known, and the new name is said back. Both need LAMP_NAMES=checked and the eyes' who socket.
Environment=LAMP_NAMES_RENAME_ASKED=on
Environment=LAMP_NAMES_RENAME_YES=on
# LAMP_NAME_LEARN_FIX: its why and rules are its row in docs/switches.md (#7331).
Environment=LAMP_NAME_LEARN_FIX=on
Environment=LAMP_STAFF_NOTE=on
Environment=LAMP_TASK_NEWS_AT_PAUSE=on
Environment=LAMP_MEMORY_RULES=on
Environment=LAMP_LIGHT_REQUESTS=on
# Bedtime and Morning's night caps (#5753, #1732): the ring keeps under Actions' output caps, light 24 from 21:00
# to 06:00; all night under the caps on lamp-06c1 through restarts and silence (#2804, 22-23 Oct).
Environment=LAMP_OUTPUT_CAPS=on
Environment=LAMP_QUIET_PACE=on
# A silent service costs no connection and no line waiting on it: the provider file's unset
# waits become assume_over, 8 s with no output = unanswered, 12 s for a first output (#705).
Environment=LAMP_PROVIDER_PATIENCE=on
Environment=LAMP_START_OFFLINE=on
# LAMP_OFFLINE_VOICE: its why and rules are its row in docs/switches.md (#830).
Environment=LAMP_OFFLINE_VOICE=on
Environment=LAMP_RING_ASLEEP=on
# LAMP_HEAD_TOUCH: its why and rules are its row in docs/switches.md (#711, #1798).
Environment=LAMP_HEAD_TOUCH=on
# A hand's 3 s hold says "Going to sleep. Tap my head to wake me." in the owner's language before the mute (#3748,
# #6028): the speech cache's kept line at the hold's 2 s mark, the breath in the quiet hours (22:00 to 07:00) or
# while the line is not kept yet. The mute comes once the cue has played, at most 6 s after the hold.
Environment=LAMP_SLEEP_LINE=on
# "Lamp, go to sleep" asks the same sleep the 3 s hold asks, with the same kept line (#3748, controls.md): played on
# lamp-52e6 on 2 Nov 09:18-09:24, PASS, and the one-breath fix 4/4 there (#4886). On in the product for #6853.
Environment=LAMP_SLEEP_ASKED=on
Environment=LAMP_RESTORED_MUTE=on
# The privacy slide is the lamp's sleep and wake (migrate-P4, #5182): closing it lays the lamp down, and open for 1 s
# it wakes as at a tap, with no touch; a POWER mute stays. The lead's yes on 6 Nov, after lamp-e82d's row at 10441.
Environment=LAMP_SLIDE_WAKES=on
# On after the checks: the button and the app on lamp-52e6 (#3697, 2 Nov), the app's power-off on lamp-0c89 (#3698, 30 Oct).
Environment=LAMP_SHUTDOWN=on
# "I'm unplugging you" folds the arm first (#1674, unplug.md): set on Body, Expression, Skills and Voice together
# (#5747); lamp-52e6 20 Oct, #1699 row 1: ask, fold 6.7 s, head and base home, ready, Expression asleep.
Environment=LAMP_UNPLUG=on
# LAMP_BODY_ENERGY: its why and rules are its row in docs/switches.md (#6893).
Environment=LAMP_BODY_ENERGY=on
# LAMP_GUARD_NEVER_LISTENED: its why and rules are its row in docs/switches.md (#1567, #4332).
Environment=LAMP_GUARD_NEVER_LISTENED=on
Environment=LAMP_OTHER_LANGUAGE=sorry
Environment=LAMP_NAME_IN_PASSING=ignored
# LAMP_SPOKEN_TO: its why and rules are its row in docs/switches.md (#828).
Environment=LAMP_SPOKEN_TO=on
# Inside a live back-and-forth a follow-up the model lets pass still renews the call for the caller's next line, and the
# next line is told it is theirs (#7332: lamp-74ff, 16 Nov, three of the owner's lines in 26 s held). Caller's face only.
Environment=LAMP_BUSY_FOLLOW_UP_RENEWS=on
# LAMP_TURNED_FACE_SPEAKS: its why and rules are its row in docs/switches.md (#7297).
Environment=LAMP_TURNED_FACE_SPEAKS=on
# LAMP_SAID_TO_ME: its why and rules are its row in docs/switches.md (#7442).
Environment=LAMP_SAID_TO_ME=on
# LAMP_SPEAKING_READ_LOOKS: its why and rules are its row in docs/switches.md (#7442, #7419).
Environment=LAMP_SPEAKING_READ_LOOKS=on
# LAMP_ONE_AS_LAMP: its why and rules are its row in docs/switches.md (#4710).
Environment=LAMP_ONE_AS_LAMP=on
Environment=LAMP_FIRST_WORDS=kept
# LAMP_SOFT_START: its why and rules are its row in docs/switches.md (#3411).
Environment=LAMP_SOFT_START=on
# LAMP_NAME_START_USUAL: its why and rules are its row in docs/switches.md (#4226, #5234).
Environment=LAMP_NAME_START_USUAL=on
Environment=LAMP_TASKS_ASKED=on
Environment=LAMP_TASKS_WHO=on
# Work goes only to the agent named: one named who isn't set up is said so, never given to another (#1722; the
# 27 Oct demo, where "have Hermes do it" went to Claude Code unsaid, #3504). Checked on lamp-75c9 on 22 Oct.
Environment=LAMP_TASKS_NAMED_ONLY=on
# LAMP_TASKS_CORRECT: its why and rules are its row in docs/switches.md (#2838, #6857).
Environment=LAMP_TASKS_CORRECT=on
# LAMP_TASKS_SIGN_IN: its why and rules are its row in docs/switches.md (#5198, #1676).
Environment=LAMP_TASKS_SIGN_IN=on
Environment=LAMP_TASKS_SIGN_IN_APP=on
# LAMP_TASKS_REPLY_NAMED: its why and rules are its row in docs/switches.md (#5535, #5978).
Environment=LAMP_TASKS_REPLY_NAMED=on
# LAMP_TASKS_HARNESS_STATUS: its why and rules are its row in docs/switches.md (#6061, #6222).
Environment=LAMP_TASKS_HARNESS_STATUS=on
Environment=LAMP_CUT_KEEPS_NAME=on
Environment=LAMP_SELFTEST_SPEAKER=on
# Each stall of 50 ms or more in the voice's loops, with what held it, in /run/lampos-voice (#1179): cheap, and
# what support reads first after a voice ends (#1178).
Environment=LAMP_STALLS=on
Environment=LAMP_ROOM_FACTS=on
# The hello on arrival is the Welcome back skill's alone (lamp-skills.service, #811, #2825), spoken
# through the say service below.
Environment=LAMP_SAY=on
Environment=LAMP_SAY_GROUP=lampos
# A body let go for its pose says its ask through the say service, once, and when called by name (#2938).
# Off until its lamp-52e6 row is run (switches.md).
# Environment=LAMP_BODY_ASK=on
Environment=LAMP_ACTIONS_DIR=/run/lampos-actions
# The skills' functions, in lamp-skills' own folder; the old one inside the actions part's is still
# read after it for one release.
Environment=LAMP_SKILLS_DIR=/run/lampos-skills
# Every skill reached through one function, use_skill, instead of one function each (#2826, use_skill.rs):
# installed skills no longer push the lamp's own past the chat route's 48 (lamp-9adf, 6 Nov, on 10441: the_time,
# reports_state and fetch_page left out). Who was here and Guard mode answered through it there by drop-in (#1685).
Environment=LAMP_USE_SKILL=on
# #7335, docs/skills.md; owner, 16 Nov
Environment=LAMP_SKILL_STATE_TOLD=on
# #5207, with the line above; as in lamp-skills
Environment=LAMP_NUDGES_PRESENT=on
# Music to relax (#1685, #5749): a spoken request for a skill's checked local recording plays it after the
# confirmation; Stop, an interruption, the privacy slide or mute ends it, and nothing resumes (requested-audio.md).
# The same line in lamp-voice, lamp-skills and lamp-actions; played on lamp-4ace on 6963 (#2793). Installing
# the skill (relaxing-music, a Store skill) is separate: with none installed nothing plays.
Environment=LAMP_REQUESTED_AUDIO=on
# "Stop sending reports" and asking whether they're sent (#2862, reports_stop.rs): the voice can only
# turn them off, never on.
Environment=LAMP_REPORTS=on
Environment=LAMP_TASKS_DIR=/run/lampos-tasks
# The tasks part runs only with Harness (its unit's condition): without it the voice says work
# can't be handed on yet, not that a part failed (#811).
Environment=LAMP_TASKS_NEEDS=/usr/local/bin/harness
# LAMP_TASK_NEWS: its why and rules are its row in docs/switches.md (#1038, #1722).
Environment=LAMP_TASK_NEWS=skill
# A skill made for the person (#1685, #2813, #4914): asked aloud or typed in the app's "Make a skill",
# made by the lamp's own model, with no computer and no tasks part, and put on only by a spoken yes at
# the lamp (the lead's ruling on #1711); the app's button shows at once. Played on lamp-9adf on 2 Nov, by
# voice and from the app, each put on by a plain "Yes." (#4946). A computer's agent no longer makes one
# (the first builder, 3 Nov, on the Queue).
Environment=LAMP_MAKE_SKILL=on
# A voice make the lamp's own model can't keep goes to the lamp's own agent when it is Hermes (#6059, docs/skills.md); on again 15 Nov, a code make passed 3 of 3 on 9adf.
Environment=LAMP_MAKE_SKILL_AGENT=on
# On the one run path too (#7245): a make DeepSeek fails goes to the lamp's agent when lamp-tasks says it takes
# runs, OpenClaw as well as Hermes, through `harness new <engine>` (docs/tasks.md). Off: Hermes only, as before.
Environment=LAMP_MAKE_AGENT_ONE_PATH=on
# #7270, docs/skills.md; owner, 16 Nov
Environment=LAMP_MADE_NOT_ON_TOLD=on
Environment=LAMP_APP_MAKE_SKILL=on
# A skill added from a file in the app, on a spoken yes (#5080): lamp-cloud hands it over the app-make socket,
# the same line in lamp-cloud.service; it never starts on its own.
Environment=LAMP_SKILL_UPLOAD=on
# An uploaded SKILL.md run by the lamp's agent (the owner's ruling, 13 Nov; docs/skills.md "Run by the lamp's agent"):
# the file kept whole and followed by Hermes in a fresh home, its grants read from it and said back. The same line
# in lamp-cloud, lamp-voice, lamp-skills and lamp-skills-manage@.
Environment=LAMP_UPLOAD_TO_AGENT=on
Environment=LAMP_SCHEDULE_TOOLS=on
# LAMP_SERVICES: its why and rules are its row in docs/switches.md (#4710).
Environment=LAMP_SERVICES=on
# LAMP_SAME_VOICE_MODEL: its why and rules are its row in docs/switches.md.
Environment=LAMP_SAME_VOICE_MODEL=/opt/lampOS/voice/current/3dspeaker_speech_campplus_sv_en_voxceleb_16k.onnx
Environment=LAMP_SAME_VOICE_FOR=services
# A made skill reads a linked service to its owner alone (#5288, #5303): the made-skill brief lets one read
# through, passed to the provider and second routes. Played on lamp-9adf 5 Nov.
Environment=LAMP_SKILL_READS=on
# LAMP_SKILL_WRITES: its why and rules are its row in docs/switches.md (#6066, #6142).
Environment=LAMP_SKILL_WRITES=on
# A Store or pushed skill's `do.task` (#6305, docs/skills.md "A skill's task"): its task and each grant said back,
# and the person's yes recorded by lamp-control (task_yes_record); passed to the provider and second routes.
Environment=LAMP_SKILL_TASKS=on
# A skill's keys given in the app (#6686, docs/skills.md "Its keys, given in the app"): an agent skill's tool says to add a
# missing key in the app, never by voice; passed to the provider and second routes.
Environment=LAMP_SKILL_SECRETS=on
# A made skill's code of its own (#6307, docs/skills.md "Made by voice"): the making model may write up to 4
# scripts/ files run by one task step, said back with its grants; on only at the person's later yes to that package's
# SHA-256, never at once; passed to both routes. The same line in lamp-skills and lamp-skills-manage@.
Environment=LAMP_MADE_SCRIPTS=on
# The lamp's agent's connectors (#6648, #6664, docs/skills.md): a voice make of a skill that reads or writes a linked
# service is one `do.task` for the lamp's agent, its grants said back; a send comes back here for the owner's
# spoken yes; passed to both routes. The same line in lamp-tasks, lamp-skills, lamp-skills-manage@ and
# lamp-control. On in the product (owner, 13 Nov).
Environment=LAMP_AGENT_SERVICES=on
# A skill made here, by voice or in the app, is the person's own (#6059, docs/skills.md "A made skill loosened"):
# what the check refuses is left out and said, no limits added unless asked, a say as often as asked (at least a
# minute); passed to the provider and second routes. The same line in lamp-skills and lamp-skills-manage@.
Environment=LAMP_MADE_SKILL_LOOSE=on
# #7233, docs/skills.md; also in lamp-skills, -manage@, -cloud, -control
Environment=LAMP_MADE_SKILL_ASKS=on
# A due reminder is timed by the Reminders skill (lampOS/skills/reminders): the voice keeps its words and
# its acknowledgement, and says it itself when no ask has come within 10 s, so none is lost (#939).
Environment=LAMP_SCHEDULE_SPEAK=skill
Environment=LAMP_SCHEDULE_SOCKET=/run/lampos-schedule/call.sock
Environment=LAMP_SCHEDULE_DELIVERY_DIR=/var/lib/lampOS/voice/schedule-delivery
# LAMP_LEDGER_REFENCE: its why and rules are its row in docs/switches.md (#5560).
Environment=LAMP_LEDGER_REFENCE=on
Environment=LAMP_MEMORY_SOCKET=/run/lampos-memory/memory.sock
Environment=LAMP_MEMORY_DAYS=on
# LAMP_MEMORY_PERSONAL_NEEDS_FACE: its why and rules are its row in docs/switches.md.
Environment=LAMP_MEMORY_PERSONAL_NEEDS_FACE=on
# A line that plainly asks the lamp to keep something calls remember in its first round, so the lamp never says
# it kept what it didn't (lamp-4ace, 25 Oct: "remember that I take my coffee black" got "Noted" and no call).
Environment=LAMP_MEMORY_KEEP_ASKED=on
# And a line that plainly asks for a timer or a reminder calls the function that sets it (lamp-4ace, 25 Oct:
# "remind me in three minutes to call my sister" got "Three minutes, call your sister." and no call).
Environment=LAMP_SCHEDULE_ASKED=on
# And a line that is only a plain question about the person's reminders calls list_reminders (lamp-52e6, 9 Nov:
# "what reminders do I have?" was answered in words with no call in 2 of 8 asks).
Environment=LAMP_REMINDERS_ASKED=on
# And a line that is only a plain ask for a light scene or a light show calls its skill (lamp-52e6, 9 Nov: "movie
# light" and "show me a light show" were answered in words and no call, and the light never changed).
Environment=LAMP_SKILL_ASKED=on
# And a line that is only an installed skill's name said plainly ("photo booth", "run photo booth") calls it in
# code as round 1, for a non-core skill that takes no choice or yes-or-no (#6772, #6782, docs/skills.md; lamp-52e6
# at 12587, 13 Nov: "photo booth" got "I don't have a camera" over the skill it was offered); the second route alone.
Environment=LAMP_SKILL_NAMED=on
# And a line that plainly asks the lamp to make a skill, saying what it does, calls make_skill (lamp-52e6, 13 Nov,
# build 12635: a make of a skill that checks the processor temperature was answered "I can't" with no call, #6835).
Environment=LAMP_MAKE_SKILL_ASKED=on
# A line is a known person's only when their own face was seen speaking it, else the room's (#3437, reviewer-three's
# P1 and P2 on #3435): so what the memory keeps without being asked, and "forget everything about me", reach only
# the person who said it.
Environment=LAMP_PERSON_SCOPE_SEEN=on
# LAMP_PERSON_SCOPE_ONE_FACE: its why and rules are its row in docs/switches.md (#3997, #4584).
Environment=LAMP_PERSON_SCOPE_ONE_FACE=on
# LAMP_ONE_FACE_REMINDERS: its why and rules are its row in docs/switches.md.
Environment=LAMP_ONE_FACE_REMINDERS=on
# LAMP_PERSON_SCOPE_ONE_FACE_READS: its why and rules are its row in docs/switches.md (#5385).
Environment=LAMP_PERSON_SCOPE_ONE_FACE_READS=on
# LAMP_SECOND_NAME_ONE_FACE: its why and rules are its row in docs/switches.md.
Environment=LAMP_SECOND_NAME_ONE_FACE=on
# LAMP_CONVERSATION_CARRIES: its why and rules are its row in docs/switches.md (#4339, #4479).
Environment=LAMP_CONVERSATION_CARRIES=on
# LAMP_CONVERSATION_CARRIED_SAVES: its why and rules are its row in docs/switches.md (#4339, #4508).
Environment=LAMP_CONVERSATION_CARRIED_SAVES=on
# LAMP_CONVERSATION_CARRIED_MEMORY: its why and rules are its row in docs/switches.md (#5842).
Environment=LAMP_CONVERSATION_CARRIED_MEMORY=on
# LAMP_CONVERSATION_CARRIES_PAST_SILENT: its why and rules are its row in docs/switches.md (#4339).
Environment=LAMP_CONVERSATION_CARRIES_PAST_SILENT=on
# LAMP_CARRIED_LINES_KEEP_TALK: its why and rules are its row in docs/switches.md.
Environment=LAMP_CARRIED_LINES_KEEP_TALK=on
# LAMP_CONVERSATION_ROOM_LINES_TOLD: its why and rules are its row in docs/switches.md (#4339).
Environment=LAMP_CONVERSATION_ROOM_LINES_TOLD=on
# LAMP_SECOND_FACE_NAME: its why and rules are its row in docs/switches.md (#2539, #3371, #4090).
Environment=LAMP_SECOND_FACE_NAME=on
# The memory a friend has (#1693): at each conversation's end the second route's model proposes the few things
# worth keeping, each checked by the store and linked to the words it came from (OBSERVE); a dated one keeps its
# day (EVENTS); the next session with that person asks after one open thread, once, at most one a day (THREADS);
# and "forget everything about me" reaches what was kept without being asked too, the named thing only for a named
# forget (FORGET_ALL, #3113's fix #3127). The dry run on the 20 written conversations kept 10 of 10 rightly, none
# wrongly, none intrusive, health and money said in passing not kept (21 Oct); end to end on lamp-c0a4 on 23 Oct.
Environment=LAMP_MEMORY_OBSERVE=on
Environment=LAMP_MEMORY_EVENTS=on
Environment=LAMP_MEMORY_THREADS=on
Environment=LAMP_MEMORY_FORGET_ALL=on
# After ten minutes with no turn told, the next turn asks the memory's note again as a new session, so the same
# person back later (the next morning) can be asked after an open thread of theirs (THREADS above); without it the
# note is asked again only when the person changes or the worker restarts (#1693 (1), C20). The owner's yes on
# 16 Nov; a row on lamp-06c1 comes before it trains. Needs LAMP_MEMORY_DAYS and LAMP_VOICE_ROUTE=second, both above.
Environment=LAMP_MEMORY_REOPEN_QUIET=on
# A forget stops the journal, so no forgotten words stay linked in the provider's context; with only that, the
# pass above saw nothing more until the voice restarted (lamp-06c1, 27 Oct, Friday's N13 on #3504). The next
# session opened fresh, with no resumption, starts the journal again and so the next conversation's pass.
Environment=LAMP_MEMORY_JOURNAL_RESUMES=on
# A long conversation's exchanges about to leave the chat's view are folded, after the reply and off its path, by
# the same DeepSeek model into a RAM-only running note per person or room: what is going on first (a game's rules,
# where it stands, the score), then the facts said; told to that scope's next turns as background never read out,
# gone at any forget (by voice or from the app) or after 10 quiet minutes. And each conversation's note is kept on
# disk, in the lamp's memory, as its talk note, in its own scope: never expired, kept until forgotten (a forget of
# the person, of everything, or of its source exchanges or a fact from them), found only by a recall; the room's
# can be found by anyone in the room, an unplaced voice included; a room conversation keeps none under
# LAMP_MEMORY_PERSONAL_NEEDS_FACE, and a held or carried line is never summarised (the lamp-memory owner's decisions
# on #4479). On lamp-06c1 on 29 Oct, without it, 11 exchanges after a quiz's rules the lamp said there was no quiz
# (#1693's long-conversation plan, step 3).
Environment=LAMP_CONVERSATION_SUMMARY=on
# Each recent exchange is told to the model once (#6218's history side, C131): one the chat's history tells is left
# out of the system message's thread text (HISTORY_SAID_ONCE, -2.3 KB a cut-in measured on lamp-06c1), and one a
# stored running note holds (the summary above) is told in the note alone, not again as thread lines or history
# (HISTORY_AFTER_NOTE). The owner's yes on 16 Nov; a row on lamp-06c1 comes before it trains.
Environment=LAMP_HISTORY_SAID_ONCE=on
Environment=LAMP_HISTORY_AFTER_NOTE=on
# A thing the person already keeps, said again, is that kept thing, not a second one: on lamp-06c1 on 28 Oct
# (build 8163, the product unit) "remember the meeting room is called orange" said again kept it twice (Friday's
# run on #3504). A correction (`replaces`) always writes, and the room's scope is told as a first keep (#2176).
Environment=LAMP_MEMORY_REMEMBER_ONCE=on
# A known person's own plain facts are kept quietly, in their heard words, never health, money or others' private
# matters unasked; the room's scope stays ask-first; an offer to keep is said at most once a conversation, never
# twice about a thing and never on small talk (#5053): on lamp-06c1's long run of 30 Oct 8 of the first 23 turns
# offered to keep. probe-tools --keep on lamp-06c1 through the relay (3 Nov, the first head): offers 2/20 off, 0/20
# on; facts kept 2/7 both. A re-measure at the fixed head is owed.
Environment=LAMP_KEEP_QUIETLY=on
# LAMP_KEEP_QUIETLY_ONE_FACE: its why and rules are its row in docs/switches.md (#7495).
Environment=LAMP_KEEP_QUIETLY_ONE_FACE=on
# What the room kept, and the earlier exchanges a turn is given, were said by whoever was in the room then, never
# necessarily the one asking: on lamp-4ace on 26 Oct (lamp-voice 2a8273ef2's product unit, played), a fresh
# session's "how do I take my coffee?", after a room's "I take my coffee black" kept by nobody, was answered as the
# asker's own in 3 of 3 rounds without it ("Black, no sugar, that's how you've had it", "no sugar" from desk talk)
# and in none of 2 with it ("nobody's told me how you take it"); a played name in a new session was never given back
# either way (names.sh) (#2176).
Environment=LAMP_MEMORY_ROOM_NOT_ASKER=on
# LAMP_MEMORY_FORGET_ASKS: its why and rules are its row in docs/switches.md.
Environment=LAMP_MEMORY_FORGET_ASKS=on
# LAMP_MEMORY_FOLLOWS_FACE: its why and rules are its row in docs/switches.md (#2176).
Environment=LAMP_MEMORY_FOLLOWS_FACE=on
# LAMP_MEMORY_STABLE_ID: its why and rules are its row in docs/switches.md (#2176, #4710).
Environment=LAMP_MEMORY_STABLE_ID=on
# LAMP_MEMORY_KEEP_HEARD: its why and rules are its row in docs/switches.md (#2176, #5276).
Environment=LAMP_MEMORY_KEEP_HEARD=on
# LAMP_MEMORY_DONT_KNOW_RECALLS: its why and rules are its row in docs/switches.md.
Environment=LAMP_MEMORY_DONT_KNOW_RECALLS=on
# A correction replaces the kept thing (#2510): on lamp-06c1 on 4 Nov (build 10012) "my favourite colour is green
# now" after a kept violet called remember with replaces (answer=replaced), one green kept, violet gone from recall.
Environment=LAMP_MEMORY_REPLACES=on
# "Forget what I said about my bicycle" forgets just those things (#2176): on lamp-06c1 on 4 Nov (build 10012) both
# bicycle things were forgotten by forget's about, and the coffee one was still found.
Environment=LAMP_MEMORY_FORGET_ABOUT=on
# LAMP_MEMORY_FORGET_JUST_KEPT: its why and rules are its row in docs/switches.md (#5022).
Environment=LAMP_MEMORY_FORGET_JUST_KEPT=on
# Recall's second version (#2176), with lamp-memory from the same build: on lamp-06c1 on 4 Nov (build 10012) "my"
# alone found nothing (5 before), the drink order was found, and "last week" got a span answer (span=true).
Environment=LAMP_MEMORY_RECALL_V2=on
# A keep the round right after it doubts is taken back and held for the person's yes (C37, docs/memory.md): the
# memory owner's call A on 11 Nov, after lamp-06c1 kept "renunctinus" twice on 10 Nov and then asked "is that
# ranunculus?". A round asking whether a kept word was another keeps the asked word on their yes. Needs
# LAMP_MEMORY_FORGET_ALL and LAMP_EYES_SPEAKING, both on here.
Environment=LAMP_MEMORY_DOUBT_UNDOES=on
# Tiers' ideas in Days (the memory owner's 3 Nov plan, P1 to P4; docs/memory-days.md). The session note keeps the
# person's tastes and kept facts first (PROFILE): the memory owner's call on 5 Nov, off for the candidate on 6 Nov
# (#5464), back on after its played check passed on lamp-06c1 with ElevenLabs voices on 6 Nov (PASS bd98421414,
# #5331). A maybe or a plan comes back marked as one (STRENGTH), back on after its played check on lamp-06c1 on
# 6 Nov showed kept entry 579 with strength:"maybe" and the answer that read it (#5503,
# https://github.com/autonomous-ai/lampOS/pull/5503#issuecomment-6678298333). Each needs a lamp-memory from the
# same build, which a product install ships. LAMP_MEMORY_NEWER_FIRST stays off: with REPLACES and KEEP_QUIETLY on,
# a played correction is either replaced or kept alone, so its earlier:true is not reachable as played.
Environment=LAMP_MEMORY_STRENGTH=on
Environment=LAMP_MEMORY_PROFILE=on
# The nightly pass (extraction plan C, step B; docs/memory.md, "The nightly pass"): 03:00 to 06:00 local, after
# 20 min quiet with the privacy slide open, each known person's day before is sent through the relay's model once
# more and Days keeps the episodes, facts, profile lines, ahead items, patterns and feelings that pass its checks, one
# by one. Nothing is said or shown; the journal has counts only. The memory owner's call on 5 Nov, with patterns and
# feelings; its quotes are kept, by the owner's decision on 4 Nov. Needs lamp-memory's nightly ops (--memory-days).
Environment=LAMP_MEMORY_NIGHTLY=on
Environment=LAMP_MEMORY_NIGHTLY_PATTERNS=on
Environment=LAMP_MEMORY_NIGHTLY_FEELINGS=on
# A role a seen person gives the lamp ("you are Harry Potter") lasts with them until they end it (the memory owner's
# design of 6 Nov, #5545; switched on by their call on 9 Nov). Only a short name is kept, per known face, read once with
# their session's open; a turn not placed as theirs is told only the role names of the known faces in view, never
# whose. Private-room mode above does not hold names back; outside that mode a held-back name suppresses this note.
# Second route and Days only; needs same-build lamp-memory (role_set_session, role_end_session), which a product install ships.
Environment=LAMP_MEMORY_ROLE=on
# LAMP_SERVICE_RECORDS: its why and rules are its row in docs/switches.md.
Environment=LAMP_SERVICE_RECORDS=on
# LAMP_SERVICE_RECORDS_TOLD: its why and rules are its row in docs/switches.md (#6453, #6404).
Environment=LAMP_SERVICE_RECORDS_TOLD=on
Environment=LAMP_SERVICE_CONTACTS=on
Environment=LAMP_SERVICE_REDO=on
# LAMP_SERVICE_READ_IDS_KEPT: its why and rules are its row in docs/switches.md (#6546).
Environment=LAMP_SERVICE_READ_IDS_KEPT=on
Environment=LAMP_BODY_MOOD_SOCKET=/run/lampos-body/mood.sock
Environment=LAMP_EYES_PERMIT_SOCKET=/run/lampos-eyes/permit.sock
Environment=LAMP_EYES_PRESENCE_FILE=/run/lampos-eyes/present
Environment=LAMP_EYES_WHO_SOCKET=/run/lampos-eyes/who.sock
# LAMP_PHOTO_FACES: its why and rules are its row in docs/switches.md (#1968, #5750).
Environment=LAMP_PHOTO_FACES=on
# The name typed at setup (lamp-setup writes it; a reset and the owner's own "forget everything" wipe it,
# #4461), told to the model (docs/setup.md, #806). No file, no name.
Environment=LAMP_PERSON_NAME=/etc/lampOS/person/name
# The owner's language (#4473), read at each start: en, vi, ja, zh or ko. No file, empty, en or unknown is English,
# as before (docs/second-voice.md, "The owner's language").
Environment=LAMP_LANGUAGE_FILE=/etc/lampOS/setup/language
# Never in the character: told only to the owner's own known face alone in view, and by default below
# (LAMP_PERSON_NAME_OWNER_ONLY, #2602, the first builder's piece 2 on #1711; #4461).
Environment=LAMP_PERSON_NAME_OWNER_ONLY=on
# LAMP_PRIVATE_ROOM: its why and rules are its row in docs/switches.md.
Environment=LAMP_PRIVATE_ROOM=on
# A reply is told the person speaking is most likely the one who set the lamp up, unless someone else is
# seen or heard now; the reply only, nothing personal kept on it (LAMP_PERSON_NAME_BY_DEFAULT, #3884).
Environment=LAMP_PERSON_NAME_BY_DEFAULT=on
# LAMP_FACES_AT_DESK_ONLY: its why and rules are its row in docs/switches.md.
Environment=LAMP_FACES_AT_DESK_ONLY=on
Environment=LAMP_EYES_LOOK_FILE=/run/lampos-eyes/sight.jpg
# What the lamp sees, when asked, from the eyes' full look (lamp-eyes --full-look), not the 320 working frame.
Environment=LAMP_LOOK_FULL=on
Environment=LAMP_EYES_FULL_LOOK_FILE=/run/lampos-eyes/look.jpg
# Only the body opens the servo port. Defence in depth, not a mechanical stop.
# With '-', a servo port that isn't there when the voice starts (a boot race: it comes up after the
# unit starts; the body unplugged; a lamp without one) is passed over, and then not hidden for that run:
# systemd sets up the namespace once, at start, and the next start hides it. Without '-' systemd fails the
# unit at start (226/NAMESPACE), and the restart guard can leave the lamp mute (lamp-a0ae, 28 Oct).
InaccessiblePaths=-/dev/ttyACM0

[Install]
WantedBy=lampos.target
