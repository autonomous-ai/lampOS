# lampOS actions: carries out what the model asks for: volume, light, reminders (lampOS/docs/actions.md).
# The product unit (lampOS/docs/install.md).
[Unit]
Description=lampOS actions (lamp-actions)
PartOf=lampos.target
# Not before setup has finished (#806). The target's own condition holds back none of its parts.
ConditionPathExists=/var/lib/lampos-setup/done
After=local-fs.target sound.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=lampos
Group=lampos
Slice=lampos-parts.slice
SupplementaryGroups=audio
RuntimeDirectory=lampos-actions
RuntimeDirectoryMode=0755
# Kept across a restart (a crash's, an update's): its catalog stays in place, so the voice sees
# no functions gone and back, and renews no session for a restart (#1588, El's P3).
RuntimeDirectoryPreserve=restart
# Private durable cap state, separate from the runtime socket directory.
# The path does not turn LAMP_OUTPUT_CAPS on. It comes by environment, not --caps-dir: an
# install takes this unit from the updater's build and the binary from the channel's newest,
# and an older lamp-actions ignores the line where it would exit 2 on the flag (#2157).
StateDirectory=lampos-output-caps
StateDirectoryMode=0700
Environment=LAMP_OUTPUT_CAPS_DIR=/var/lib/lampos-output-caps
Environment=LAMP_SCHEDULE_TOOLS=on
Environment=LAMP_SCHEDULE_SOCKET=/run/lampos-schedule/call.sock
# A reminder every so many minutes or hours, 15 minutes to 24 hours (repeat_reminder's interval, #4710 2 Nov):
# on lamp-9adf on 3 Nov "remind me to drink water every fifteen minutes" was set and came due on time.
Environment=LAMP_SCHEDULE_EVERY=on
# The room's reminder list says how many more belong to someone, a count only, never what or whose
# (LAMP_REMINDERS_HIDDEN_COUNT, the memory owner's option 2, 4 Nov): never told as the whole list.
Environment=LAMP_REMINDERS_HIDDEN_COUNT=on
# A light or volume change it made is answered short, with its own words ("Warmer."), which the voice says at once
# (LAMP_SECOND_SAY_WITH_CALL, #2135, #4700). Here only: the voice's own unit leaves LAMP_SHORT_DONE off, so with an
# owner's language chosen it never says these English words.
Environment=LAMP_SHORT_DONE=on
# The person's volume kept across a power cut (#5551): a V2 lamp is unplugged, never shut down cleanly, so
# alsa-restore never stores the mixer and every boot came back at 100%. Kept in LAMP_OUTPUT_CAPS_DIR/kept-volume
# after each change (never a mute) and set back at the start. An older lamp-actions ignores the line.
Environment=LAMP_VOLUME_KEPT=on
ExecStart=/opt/lampOS/actions/current/lamp-actions --dir /run/lampos-actions --mixer-card allwinnerhdmi --mixer-control Speaker --volume-ceiling 100 --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=2s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-actions
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=lampos.target
