# lampOS cloud: the lamp on the company broker, so the Autonomous app sees it online and its
# page can ask it things (lampOS/docs/cloud.md, #1396). On in the product (#1815): a Lamp 2
# set up from the app shows online at once, and again after a reboot, since lampos.target
# starts it once setup's marker is there (lampos-setup-done.path), and install enables it.
# V1's os-server connects with the same client id (os-server-{device_id}), so only one of them
# may run. lamp-cloud stops it as it really starts (ExecStartPre=, run as root, after the
# conditions below have held), never through Conflicts=: that stop is queued with the start
# job, before any condition is checked, so a lamp-cloud skipped for want of setup's account
# would still stop os-server (the reviewer on #1909; and on #1418, an off lamp-cloud must
# never stop it). To keep it off on a lamp, mask it (`systemctl mask lamp-cloud`).
[Unit]
Description=lampOS cloud (lamp-cloud)
PartOf=lampos.target
# Not before setup has finished (#806), and only with setup's account, the voice's key and
# lamp-update's state to hand in: without them it has nothing to say who the lamp is.
ConditionPathExists=/var/lib/lampos-setup/done
ConditionPathExists=/etc/lampOS/setup/backend.json
ConditionPathExists=/etc/lampOS/voice/credential
ConditionPathExists=/var/lib/lampos-update/state.json
After=network-online.target lamp-actions.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Environment=LAMP_CLOUD=on
# Each connection leaves the broker a will saying the lamp `offline` on its own channel, 30 s
# after the connection is lost (WILL_DELAY_S; the session is kept 60 s, longer, so the delay
# holds): the lamp's record shows it gone about 30 s after a stop and within about 2 min of a
# power cut, not 5 to 8 min later (#2636, docs/cloud.md).
Environment=LAMP_CLOUD_OFFLINE_WILL=on
# The eyes' known file: beside it, their `tellable`, read just before guard mode's named text
# goes to the broker, so a yes taken back while it waited names nobody (#2562). Read only, as
# lampos, under ProtectSystem=strict (/run/lampos-eyes is 0755, `tellable` the eyes' 0600 file
# of the same user); missing or unreadable, the text goes unnamed.
Environment=LAMP_CLOUD_KNOWN_FILE=/run/lampos-eyes/known
# What the app's Lamp 2 pages change after setup (25 Oct, for the first customer lamps: the app's setup
# sends no time zone or name). Each passed from the app on lamp-0c89 (docs/lamp-runs.md): the time zone,
# the person's name and the rename, through root's `lamp-setup change` helper (#2851: the hello used the
# new name, a reminder came at the new zone's time); the skills page, its list 0.8 to 1.0 s after the
# tap, removing and turning off through `lamp-skills-manage` (#1890); and the update page, reading
# lamp-update's own status, never starting one (#2194). Not LAMP_SETTINGS_WIFI yet: a new network from the
# app is the one change that can take the lamp off the network the app reaches it on, so it waits with
# the other broker-held changes for the broker connection's TLS (LAMP_CLOUD_TLS, docs/cloud.md).
Environment=LAMP_SETTINGS_CHANGE=on
Environment=LAMP_SKILLS_PAGE=on
# A skill typed in the app (#2813, fourteen-P15): `can` names skills.make only while lamp-voice's maker
# has a computer to hand it to (make_skill::watch, asked every 60 s).
Environment=LAMP_APP_MAKE_SKILL=on
# Health and crash reports to the company (#2862, docs/cloud.md, "Health and crash reports"): only after
# the person's yes at setup (share_reports) or from the app (reports.set). With no recorded yes, nothing
# is sent; a reset wipes the choice.
Environment=LAMP_REPORTS=on
# Install writes this shared, default-off switch; a separately provisioned Store key is
# required too. Changing store.env and restarting cloud enables the next helper connection.
Environment=LAMP_SKILLS_STORE=off
EnvironmentFile=-/etc/lampOS/skills/store.env
Environment=LAMP_APP_UPDATE=on
# The app's Turn off (#3697, #3698, docs/shutdown.md): `system.shutdown`, asked of setup's change helper,
# which refuses while an update installs. Set in lamp-cloud, Controls, Voice and lamp-setup-reset together,
# every part that reads it (switches.md). On since Mobile's three clean offs on lamp-0c89 (30 Oct, #3698).
Environment=LAMP_SHUTDOWN=on
# The app's Restart (#2193): `system.reboot`, asked of the same helper, which refuses while an update installs, else
# answers first and restarts lampos.target once the voice has rested (at most 45 s); never the machine.
Environment=LAMP_APP_RESTART=on
# `+`: as root, past the sandbox below; `-`: a lamp with no os-server (every product lamp) goes on.
ExecStartPre=-+/usr/bin/systemctl stop os-server.service
User=lampos
Group=lampos
Slice=lampos-parts.slice
# A login a ping rotated, kept 0600; the reset empties it.
StateDirectory=lampos-cloud
StateDirectoryMode=0700
Nice=5
# Root's files, handed in by systemd: setup's account (the broker's login and the two channels),
# the voice's key (the ping's bearer) and lamp-update's state (the build, for `version`).
LoadCredential=account:/etc/lampOS/setup/backend.json
LoadCredential=key:/etc/lampOS/voice/credential
LoadCredential=build:/var/lib/lampos-update/state.json
ExecStart=/opt/lampOS/cloud/current/lamp-cloud --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-cloud
NoNewPrivileges=yes
ProtectSystem=strict
# The bus (the microphones, health and the light) and lamp-actions' socket (the volume); the
# app's photos, for the eyes, with LAMP_PHOTO_FACES=on (docs/cloud.md; made by lampos.conf at boot);
# lamp-skills' call socket, for guard mode from the app with LAMP_GUARD_FROM_APP=on (#2562); and
# lamp-voice's app-make socket, for a skill typed in the app with LAMP_APP_MAKE_SKILL=on (#2813).
ReadWritePaths=/run/lampos-bus /run/lampos-actions -/run/lampos-photos -/run/lampos-skills -/run/lampos-app-make
ProtectHome=yes
PrivateTmp=yes
# No capability is needed (Fourth on #1404): the broker, the ping and the bus. Netlink is for `iw`,
# which says the Wi-Fi's name.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=lampos.target
