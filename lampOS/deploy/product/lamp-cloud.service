# lampOS cloud: the lamp on the company broker, so the Autonomous app sees it online and its
# page can ask it things (lampOS/docs/cloud.md, #1396). On in the product (#1815): a Lamp 2
# set up from the app shows online at once, and again after a reboot, since lampos.target
# starts it once setup's marker is there (lampos-setup-done.path), and install enables it.
# V1's os-server connects with the same client id (os-server-{device_id}), so only one of them
# may run. lamp-cloud stops it as it really starts (ExecStartPre=, run as root, after the
# conditions below have held), never through Conflicts=: that stop is queued with the start
# job, before any condition is checked, so a lamp-cloud skipped for want of setup's account
# would still stop os-server (the reviewer on #1909; and on #1418, an off lamp-cloud must
# never stop it). To keep it off on a lamp, mask it (`systemctl mask lamp-cloud`).
[Unit]
Description=lampOS cloud (lamp-cloud)
PartOf=lampos.target
# Not before setup has finished (#806), and only with setup's account, the voice's key and
# lamp-update's state to hand in: without them it has nothing to say who the lamp is.
ConditionPathExists=/var/lib/lampos-setup/done
ConditionPathExists=/etc/lampOS/setup/backend.json
ConditionPathExists=/etc/lampOS/voice/credential
ConditionPathExists=/var/lib/lampos-update/state.json
After=network-online.target lamp-actions.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Environment=LAMP_CLOUD=on
# Each connection leaves the broker a will saying the lamp `offline` on its own channel, 30 s
# after the connection is lost (WILL_DELAY_S; the session is kept 60 s, longer, so the delay
# holds): the lamp's record shows it gone about 30 s after a stop and within about 2 min of a
# power cut, not 5 to 8 min later (#2636, docs/cloud.md).
Environment=LAMP_CLOUD_OFFLINE_WILL=on
# The eyes' known file: beside it, their `tellable`, read just before guard mode's named text
# goes to the broker, so a yes taken back while it waited names nobody (#2562). Read only, as
# lampos, under ProtectSystem=strict (/run/lampos-eyes is 0755, `tellable` the eyes' 0600 file
# of the same user); missing or unreadable, the text goes unnamed.
Environment=LAMP_CLOUD_KNOWN_FILE=/run/lampos-eyes/known
# What the app's Lamp 2 pages change after setup (25 Oct, for the first customer lamps: the app's setup
# sends no time zone or name). Each passed from the app on lamp-0c89 (docs/lamp-runs.md): the time zone,
# the person's name and the rename, through root's `lamp-setup change` helper (#2851: the hello used the
# new name, a reminder came at the new zone's time); the skills page, its list 0.8 to 1.0 s after the
# tap, removing and turning off through `lamp-skills-manage` (#1890); and the update page, reading
# lamp-update's own status, never starting one (#2194). Not LAMP_SETTINGS_WIFI yet: a new network from the
# app is the one change that can take the lamp off the network the app reaches it on, so it waits with
# the other broker-held changes for the broker connection's TLS (LAMP_CLOUD_TLS, docs/cloud.md).
Environment=LAMP_SETTINGS_CHANGE=on
Environment=LAMP_SKILLS_PAGE=on
# Wellbeing nudges at a present spacing and Comfort break (#5207): the skills page and report list the skills with
# their [present] values, as lamp-skills runs them (Comfort break on). The same line in lamp-skills.service and lamp-skills-manage@.service.
Environment=LAMP_NUDGES_PRESENT=on
# The owner's approximate place from the app (#4333): owner.place and owner.place.clear, rounded to about a
# kilometre and kept in the person's folder through `lamp-setup change`. The lead's yes on 3 Nov.
Environment=LAMP_OWNER_PLACE=on
# A skill typed in the app (#2813, fourteen-P15): `can` names skills.make only while lamp-voice's maker
# has a computer to hand it to (make_skill::watch, asked every 60 s).
Environment=LAMP_APP_MAKE_SKILL=on
# The lamp's own Hermes chats through lamp-cloud's loopback forwarder (127.0.0.1:7741) to the relay
# (#5978, docs/cloud.md); it serves only once Hermes is installed and asks.
Environment=LAMP_HERMES_ON_LAMP=on
# OpenClaw on the lamp, the lamp's default engine, chats through the same forwarder, port and token
# (#6226, docs/cloud.md); either switch serves it.
Environment=LAMP_OPENCLAW_ON_LAMP=on
# Health and crash reports to the company (#2862, docs/cloud.md, "Health and crash reports"): only after
# the person's yes at setup (share_reports) or from the app (reports.set). With no recorded yes, nothing
# is sent; a reset wipes the choice.
Environment=LAMP_REPORTS=on
# Install writes this shared switch in store.env, read after this line; a separately provisioned
# Store key is required too, and without it an install is still refused. On since the backend listed four approved, signed skills (2 Nov, #4710), shown on lamp-9adf (31 Oct).
Environment=LAMP_SKILLS_STORE=on
EnvironmentFile=-/etc/lampOS/skills/store.env
# A skill made on this lamp sent to the Skills Store (fourteen-P13): only on the owner's Share in the app,
# packed unsigned from its own files and sent with the lamp's key; a reviewer reads it before it is listed.
Environment=LAMP_SKILLS_SHARE=on
# Guard mode's texts, an installable skill from the Store (#5752, #1685): only lamp-skills' lines on messages/out
# go up as unasked news (visit times and lengths, never a name, picture or sound; kept 90 days for the owner).
# LAMP_MESSAGES stays off: no app texts onto chat/in, no text turns. Shown on lamp-9adf, 7 Nov 15:33-15:42.
Environment=LAMP_SKILL_MESSAGES=on
# A skill added from a file in the app, on a spoken yes (#5080): skills.upload, the file fetched from the backend
# and handed to lamp-voice's app-make socket, the same line there.
Environment=LAMP_SKILL_UPLOAD=on
Environment=LAMP_APP_UPDATE=on
# The lamp's agents for the app (#6240): `engines` in update.status and engines.install for a missing Hermes,
# on in the product by the owner's rule of 11 Nov; `off` here takes it away.
Environment=LAMP_APP_ENGINES=on
# The app's connectors (Queue #4710): a link set or removed through lamp-services' admin socket. Reads, and
# sends, which lamp-services.service sets on (LAMP_SERVICES_WRITE=on); the same line there and in lamp-voice.service.
Environment=LAMP_SERVICES=on
# A skill that needs a connector not linked, told to the app so it opens that Connect (#6059, the owner's ask):
# skills.list rows carry needs_link, from lamp-services' admin list, and an install or an app make that lands one
# sends skills.needs_link on the account channel, codes and names only.
Environment=LAMP_SKILL_LINK_APP=on
# On after the checks: the button and the app on lamp-52e6 (#3697, 2 Nov), the app's power-off on lamp-0c89 (#3698, 30 Oct).
Environment=LAMP_SHUTDOWN=on
Environment=LAMP_APP_RESTART=on
# Harness signed in from the owner's app (#5198, harness.sign_in.*): handed to lamp-tasks' app route
# (/run/lampos-tasks/app.sock, its --app-socket); the code and the email go to the backend over HTTPS only,
# never on the broker. The same switch as lamp-voice.service's, with LAMP_TASKS_SIGN_IN there.
Environment=LAMP_TASKS_SIGN_IN_APP=on
# The app told once that setup is done (#5812, onboarding.done; system.info's onboarding_done_supported),
# its acked date kept in the state folder below: on, the lead's call (9 Nov).
Environment=LAMP_APP_ONBOARDING_DONE=on
# The app's faces.add_photo (#1968, cloud.md "A face from the app's photo"; on with the eyes' --photo-dir and the
# voice's asking, #5750): a JPEG of at most 8 MiB from the lamp's own account written as a new 0600 file in the
# photo folder, the eyes asked, and the file removed after, answered or not; nothing of a photo leaves the lamp.
Environment=LAMP_PHOTO_FACES=on
Environment=LAMP_EYES_PHOTO_DIR=/run/lampos-photos
Environment=LAMP_EYES_WHO_SOCKET=/run/lampos-eyes/who.sock
# `+`: as root, past the sandbox below; `-`: a lamp with no os-server (every product lamp) goes on.
ExecStartPre=-+/usr/bin/systemctl stop os-server.service
User=lampos
Group=lampos
Slice=lampos-parts.slice
# A login a ping rotated, kept 0600; the reset empties it.
StateDirectory=lampos-cloud
StateDirectoryMode=0700
Nice=5
# Root's files, handed in by systemd: setup's account (the broker's login and the two channels),
# the voice's key (the ping's bearer) and lamp-update's state (the build, for `version`).
LoadCredential=account:/etc/lampOS/setup/backend.json
LoadCredential=key:/etc/lampOS/voice/credential
LoadCredential=build:/var/lib/lampos-update/state.json
# lamp-control's admin socket, for the app's Add a developer computer (`control.code`, sealed;
# `control.clients`, `control.revoke`, docs/cloud.md "The developer door"). This is the first time
# the cloud-facing part can mint pairing codes and revoke pairings. It is gated by the owner's
# developer setting: with developer access off the socket isn't there, and nothing is listed or
# answered.
ExecStart=/opt/lampOS/cloud/current/lamp-cloud --bus-root /run/lampos-bus --control-admin-socket /run/lampos-control/admin.sock
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-cloud
NoNewPrivileges=yes
ProtectSystem=strict
# The bus (the microphones, health and the light) and lamp-actions' socket (the volume); the
# app's photos, for the eyes, with LAMP_PHOTO_FACES=on (docs/cloud.md; made by lampos.conf at boot);
# lamp-skills' call socket, for guard mode from the app with LAMP_GUARD_FROM_APP=on (#2562); and
# lamp-voice's app-make socket, for a skill typed in the app with LAMP_APP_MAKE_SKILL=on (#2813);
# lamp-tasks' app route, for Harness signed in from the app with LAMP_TASKS_SIGN_IN_APP=on (#5198);
# lamp-control's admin socket, while developer access is on; and lamp-voice's say socket, for
# the app's onboarding pages said done (#6076).
ReadWritePaths=/run/lampos-bus /run/lampos-actions -/run/lampos-photos -/run/lampos-skills -/run/lampos-app-make -/run/lampos-services -/run/lampos-tasks -/run/lampos-control -/run/lampos-say
ProtectHome=yes
PrivateTmp=yes
# No capability is needed (Fourth on #1404): the broker, the ping and the bus. Netlink is for `iw`,
# which says the Wi-Fi's name.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=lampos.target
