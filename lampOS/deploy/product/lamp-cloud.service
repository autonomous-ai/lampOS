# lampOS cloud: the lamp on the company broker, so the Autonomous app sees it online and its
# page can ask it things (lampOS/docs/cloud.md, #1396). Off unless set: a drop-in with
# Environment=LAMP_CLOUD=on turns it on.
[Unit]
Description=lampOS cloud (lamp-cloud)
PartOf=lampos.target
# Not before setup has finished (#806), and only with setup's account, the voice's key and
# lamp-update's state to hand in: without them it has nothing to say who the lamp is.
ConditionPathExists=/var/lib/lampos-setup/done
ConditionPathExists=/etc/lampOS/setup/backend.json
ConditionPathExists=/etc/lampOS/voice/credential
ConditionPathExists=/var/lib/lampos-update/state.json
# V1's os-server connects with the same client id (os-server-{device_id}): two would fight over
# one broker session, so only one of them runs.
Conflicts=os-server.service
After=network-online.target lamp-actions.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=lampos
Group=lampos
Slice=lampos-parts.slice
# A login a ping rotated, kept 0600; the reset empties it.
StateDirectory=lampos-cloud
StateDirectoryMode=0700
Nice=5
# Root's files, handed in by systemd: setup's account (the broker's login and the two channels),
# the voice's key (the ping's bearer) and lamp-update's state (the build, for `version`).
LoadCredential=account:/etc/lampOS/setup/backend.json
LoadCredential=key:/etc/lampOS/voice/credential
LoadCredential=build:/var/lib/lampos-update/state.json
ExecStart=/opt/lampOS/cloud/current/lamp-cloud --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-cloud
NoNewPrivileges=yes
ProtectSystem=strict
# The bus (the microphones and health) and lamp-actions' socket (the volume).
ReadWritePaths=/run/lampos-bus /run/lampos-actions
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=lampos.target
