# lampOS policy: decides what the lamp should do, with a decision model (lampOS/docs/policy.md).
# Shadow mode: it listens on the bus, decides, publishes and logs its decision, and nothing acts on it.
# Its own process and unit. With it stopped the lamp behaves exactly as it does without it.
# It sends the recognised text of what was heard to the decision model's service (approved by the owner on
# 2026-10-14). Its log, which holds that text, is in a directory only it can read.
[Unit]
Description=lampOS policy (lamp-policy), shadow mode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
Group=orangepi
StateDirectory=lampos-policy
StateDirectoryMode=0700
# --act progress (first builder, 2026-10-15 20:07, #752/#793): its progress decisions alone are not shadow; the voice's
# task news says them (LAMP_PROGRESS_NEWS=on in lamp-voice.service). Every other question stays shadow.
# The key stays readable by root alone; systemd hands this service its own copy.
LoadCredential=jev.key:/etc/lampOS/policy/jev.key
# --zone system: the hour of its decisions in the lamp's own zone, as setup points /etc/localtime,
# across daylight saving and a re-setup (#820); was --utc-offset-minutes 420.
# --hello-by-rule is not given here yet (the Reviewer-lead on #4625): the hello decided by the hard
# rules alone, the judge only in shadow, as the product runs it. The pinned binary predates it, and
# lamp-policy refuses an unknown option and exits (status 2) at every start, so the option comes in
# the same change that pins a lamp-policy built with #4625. --gate is as old as #958 (15 Oct).
ExecStart=/opt/lampOS/policy/aef70157b022d155794f9396da27e6606d839aeab690f6fffb1d51a84f8e9dd4/lamp-policy --progress --act progress --act attention --hello --act hello --gate --images typesafe/jev-1.14 --sight-file /run/lampos-eyes/sight.jpg --zone system --key-file %d/jev.key --log-dir /var/lib/lampos-policy
Restart=on-failure
RestartSec=5s
SyslogIdentifier=lamp-policy
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
