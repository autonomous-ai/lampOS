# lampOS self-test: checks each part of the lamp once and says pass, fail or not checked for each, keeping the
# report under /var/lib/lamp-selftest and saying it on lamp/selftest (lampOS/docs/selftest.md). A oneshot run on
# demand only (`sudo systemctl start lamp-selftest`), never at boot: on demand it plays one short tone and runs the
# ring through its colours, so it is not started by itself in a home. CAP_SYSLOG, and only that, so that its
# storage part can read the kernel's log (/dev/kmsg is restricted on this lamp).
[Unit]
Description=lampOS self-test, on demand (lamp-selftest)
After=local-fs.target
ConditionHost=lamp-4ace

[Service]
Type=oneshot
User=orangepi
Group=orangepi
ExecStart=/opt/lampOS/selftest/39364926cf2670315d6264539ccee2c13a4cd6d7a6b59cf0fd47db8a0ca733f7/lamp-selftest --occasion on-demand --bus-root /run/lampos-bus --dir /var/lib/lamp-selftest
# Exit 3 is "some items not checked" (lampOS/docs/selftest.md), not a failure, as in deploy/product/lamp-selftest.service.
SuccessExitStatus=3
AmbientCapabilities=CAP_SYSLOG
CapabilityBoundingSet=CAP_SYSLOG
NoNewPrivileges=yes
StateDirectory=lamp-selftest
SyslogIdentifier=lamp-selftest
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes
