# lampOS voice on lamp-4ace: the Rust runtime as the lamp's only voice software.
# Installed 2026-10-12 by Agent 1 (voice) on the owner's instruction
# ("remove v1 from lamp entirely. just deploy v2. clean.").
# The physical privacy switch is the mute: while it is closed only the GPIO
# watcher runs. No motor worker is started by this unit.
# Microphone mic2, turn-taking duplex (a person can interrupt), 600 ms end-of-speech wait.
# After a failure it is started again in 4 s (15 s until 2026-10-13: a long time to face a dark lamp).
# It tells the lamp's body its mood on LAMP_BODY_MOOD_SOCKET; lamp-body.service, a
# separate unit, owns the servo port. This unit can never open that port.
[Unit]
Description=lampOS voice (lamp-voice serve)
ConditionHost=lamp-4ace
After=network-online.target sound.target lamp-cmedia-speaker.service lamp-controls.service
Wants=network-online.target lamp-cmedia-speaker.service lamp-controls.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=root
Group=root
Slice=system.slice
WorkingDirectory=/
UMask=0077
ExecStart=/opt/lampOS/releases/f70b4961c757c107c44713b11a59c4cffc2b67444fba907a5840086063f9f2ce/lamp-voice serve /etc/lampOS/voice/provider.json /var/lib/lampOS/voice/sessions/${INVOCATION_ID} --noise-suppression off --turn-taking duplex --faint-floor-db -28 --microphone mic2 --reference-clock capture --reference-recovery bounded --provider-continuation kept-start --playout-start-ms 350 --ring-channel-ceiling 24 --end-silence-ms 600 --controls-stop --endpoint smart-turn-fast --call-wait-ms 2000 --controls-mute /var/lib/lampOS/voice/controls/mute.json
# The microphone and speaker workers may not wait behind other work on the lamp: a read held up
# for 10 ms, or a reference 20 ms late, ends the service (by design: the echo canceller's timing
# is then unknown). With every core busy for 40 s (2026-10-13, twelve busy loops) the service
# ended four times at the default scheduling. Round-robin real-time, a modest priority: above
# everything ordinary, below the kernel's own threaded interrupts (50).
CPUSchedulingPolicy=rr
CPUSchedulingPriority=20
Restart=on-failure
RestartSec=4s
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-voice
NoNewPrivileges=yes
# The conversation's last few exchanges, kept in memory under /run so that a service that ended
# and was started again carries on where it was (lampOS/docs/conversation-thread.md). Private to
# root, never on disk, kept across a restart of the unit and gone at a power cycle.
RuntimeDirectory=lampos-voice
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment=LAMP_THREAD_FILE=/run/lampos-voice/thread.json
Environment=LAMP_SAY=on
Environment=LAMP_SAY_GROUP=orangepi
Environment=LAMP_FIRST_WORDS=kept
Environment=LAMP_SOFT_START=on
Environment=LAMP_OTHER_LANGUAGE=sorry
Environment=LAMP_START_OFFLINE=on
Environment=LAMP_HEAD_TOUCH=on
Environment=LAMP_NAME_IN_PASSING=ignored
Environment=LAMP_SELFTEST_SPEAKER=on
Environment=LAMP_POLICY_HOLDS_ACTIONS=on
Environment=LAMP_LOOK_FULL=on
Environment=LAMP_EYES_FULL_LOOK_FILE=/run/lampos-eyes/look.jpg
# Since 2026-10-14: in a busy room every answer needs a sign it was meant for the lamp (docs/attention.md).
Environment=LAMP_ATTENTION=busy-near
# Since 2026-10-14 18:46 (the build of 41d09542f): busy-near is busy, and a name heard at 0.95 or more
# with the room microphone 18 dB over its floor during the request is a call (docs/attention.md).
# A stuffy room is told to the model once, beside a request, in a room that is not busy, at most every 3 h (docs/air.md).
Environment=LAMP_AIR_FACTS=on
# The ring as the lamp's eye (task 34, #712; lampOS/docs/ring-choreography.md, "The eye"): listening, it looks toward the
# nearest face the eyes see; at rest it blinks now and then. Take this line out and the ring is as before.
# The strong eye (2026-10-16): leans sooner and further, notices a person who arrives (docs/ring-choreography.md).
Environment=LAMP_RING_EYE=strong
# The asleep face while muted or asleep (#712, #1025, first builder 16 Oct 12:30): a faint warm breath at the bottom of the ring.
Environment=LAMP_RING_ASLEEP=on
# Stop words heard all the while the lamp speaks end its answer (#970, #1047 heard-always, fourth; first builder 16 Oct 13:56, to test over its voice).
Environment=LAMP_STOP_WORDS=heard-always
# The last 10 s of each reply's stop-word stream audio, as sent, for stt-check (#1047, 16 Oct 21:1x; mine to delete).
Environment=LAMP_STOP_WORDS_AUDIO=/run/lampos-voice/stop-words-audio.wav
# Each reply's stop-word counts (blocks sent, pauses asked, results, what was heard), so a cut-in run can read
# whether "Lamp, stop." reached the speech-to-text (17 Oct 13:0x: it never stopped the lamp today).
Environment=LAMP_STOP_WORDS_COUNTS=/run/lampos-voice/stop-words-counts.json
# The stop-word stream hears mic2 before the canceller (#1047, 17 Oct 00:02): the canceller removes a person's
# word said over the lamp along with the echo (crates/audio/src/duplex.rs).
Environment=LAMP_STOP_WORDS_SOURCE=raw
Environment=LAMP_SKILLS_DIR=/run/lampos-skills
Environment=LAMP_TURN_END_PRIORITY=10
Environment=LAMP_TURN_END_NO_SPIN=on
Environment=LAMP_CUT_IN_TOLD=on
# Someone else's answer left alone on the second route (#2136, the first builder at 11:37): a "yes" over the lamp's answer to nothing it asked.
Environment=LAMP_OTHERS_ANSWER=on
Environment=LAMP_TIME_PLACES=on
Environment=LAMP_ROOM_FILE=/run/lampos-voice/room.json
Environment=LAMP_FOLLOWS_RUN=on
Environment=LAMP_SPOKEN_TO=on
# Each stall of 50 ms or more in the voice's loops, with what held it, in /run/lampos-voice (#1179, eighth; first builder 17 Oct 07:3x, for #1178's midnight).
Environment=LAMP_STALLS=on
# Switch group 1, 17 Oct 07:5x (the owner: build 100% / quality 90% by Monday; merged features switched on and measured
# group by group, the battery before and after): conversation and attention.
Environment=LAMP_TOOL_LEAD_IN=on
Environment=LAMP_WAIT_KEEPS_ANSWER=on
# The lamp's own motors take no turn while an answer is awaited (#1712's B, the first builder at 06:44; needs LAMP_BUS=on, set below).
Environment=LAMP_MOTION_KEEPS_ANSWER=on
# A sound begun as the body moves is judged against the asker's level, recorded only, so the bar comes from real lines (#1722, 21 Oct 03:38).
Environment=LAMP_MOTION_VOICE=record
Environment=LAMP_STOP_TOLD=on
# LAMP_ADDRESSED stays off: Ten's census (#1238) says "most likely wrong on lamp-4ace" (it sits sideways to the desk).
# LAMP_ASKER_FIRST records first, to set its 6 dB margin from lamp-4ace (group-talk.md).
Environment=LAMP_ASKER_FIRST=record
Environment=LAMP_NAMES=checked
Environment=LAMP_STAFF_NOTE=on
Environment=LAMP_MARK_WEIRD=on
Environment=LAMP_TASK_NEWS_AT_PAUSE=on
Environment=LAMP_MEMORY_RULES=on
# Switch group 2, 17 Oct 08:2x: when things go wrong. A skill's light request (#993), the backup voice's line when
# its chat fails and its sound while it is slow (#754, #1195), and the voice's link on the bus (#830).
Environment=LAMP_LIGHT_REQUESTS=on
Environment=LAMP_SECOND_DOWN_LINE=on
Environment=LAMP_SECOND_WAIT_CUE=on
Environment=LAMP_VOICE_LINK=on
# The coordinator passes every 5 ms rather than 2 while nothing is going on (#1261, eighth; for heat: the quiet
# voice took ~44% of a core on lamp-4ace on 17 Oct 09:56, coordinator 18.0%).
Environment=LAMP_QUIET_PACE=on
# A mute left by the restart guard after a crash is woken by a head tap, as sleep is (#960, #997, nine; first builder 16 Oct 13:08).
Environment=LAMP_RESTORED_MUTE=on
# A short utterance in a room that is not busy goes to the model to judge, where the noise gate would drop it
# (lampOS/docs/not-speech.md; on 2026-10-14 the gate dropped 13 of 36 short words such as "Hi.").
# Checked since 2026-10-15 23:07 (#818, #800): a request whose end was marked a short sound is answered only when it is a short
# word said to the lamp, said close, by someone turned to it, or the lamp began the turn.
Environment=LAMP_SHORT_SOUNDS=quiet-room-checked
# Work for Claude Code on the office computer through lamp-tasks.service (lampOS/docs/tasks.md, "The voice's side").
Environment=LAMP_TASKS_DIR=/run/lampos-tasks
# Who gets the work (#733, #769): the person names Claude Code or Codex; nobody named is office-claude. On since 2026-10-15 at the owner's word.
Environment=LAMP_TASKS_WHO=on
Environment=LAMP_TASKS_TARGET=office-claude
# Work asked of the staff is handed over every time; a name not made out is asked about (#854, #859). Tried from 2026-10-15 21:30.
Environment=LAMP_TASKS_ASKED=on
# A bare call ("Hey Lamp," and a pause) waits up to 2 s for the rest, on lamp-name's early name/rising, and the name
# carries across a cut (#782, #853; lamp-4ace 2026-10-16 00:27: busy room 3 of 3, from 0 of 3). With --call-wait-ms 2000 above.
Environment=LAMP_CUT_KEEPS_NAME=on
# News of a task while it runs (#752/#793), from the policy's progress decisions (lamp-policy --act progress), under the voice's
# own gates (lampOS/docs/tasks.md, "The voice's side of progress news"). On since 2026-10-15 20:07 on lamp-4ace.
Environment=LAMP_PROGRESS_NEWS=on
# The second route (#778, #1712, lampOS/docs/second-voice.md): from 2026-10-15 21:00 the backup voice standing by, and
# since 19 Oct the lamp's only voice, as lamp-4ace runs it from its deploy copy (the first builder, #1712 20:01).
# Speech to text, DeepSeek's text model and search, and the configured voice (second.json's ElevenLabs,
# eleven_v4_turbo) answer every turn, all through the Autonomous relay, as on a product lamp; Gemini Live is not used.
# Live stays a per-lamp setting: a drop-in with Environment=LAMP_VOICE_ROUTE=gemini. Without second.json or a key file
# below the voice does not start, and never falls back to Live. This lamp's own, root-only (0600), in /etc/lampOS/voice:
#   second.json      the route's services and key paths (deploy/product/settings/second.json is the product's);
#   second-llm.key   second.json's llm_credential_file, the relay key (DeepSeek through the relay takes it too), and
#                    Gemini's key (the gemini.key credential, LoadCredential below);
#   second-stt.key   second.json's stt_credential_file: speech to text;
#   second-tts.key   second.json's tts_credential_file: the voice.
# DeepSeek through the relay since 19 Oct, as the owner asked (21:3x, "instead of using their direct deepseek key"):
# the A/B of DeepSeek direct takes deepseek.key in probe-cascade's own transient unit, never in the voice's.
LoadCredential=gemini.key:/etc/lampOS/voice/second-llm.key
Environment=LAMP_VOICE_ROUTE=second
Environment=LAMP_VOICE_SECOND_CONFIG=/etc/lampOS/voice/second.json
Environment=LAMP_SECOND_CHAT=deepseek
Environment=LAMP_SECOND_SEARCH=deepseek
Environment=LAMP_SECOND_SPEECH_MODEL=eleven_v4_turbo
# DeepSeek's chat and search go through the relay, at the address the voice derives from second.json's llm_base_url
# (second_config::relay_deepseek, #2978) with its llm_credential_file, so no deepseek.key (#1934, #1939). Not
# LAMP_SECOND_DEEPSEEK_BASE_URL here: an address the unit gives is never routed, so the relay's near route
# (LAMP_RELAY_ROUTES, #2882) could not take the chat (Queue #3126: lamp-4ace's r11 without it, 0.39 s off the median).
# Kept: Gemini has no address derived from llm_base_url, so without it Gemini would be Google's own API, past the
# relay; this route asks Gemini nothing (chat deepseek, ElevenLabs speech), so it routes nothing today.
Environment=LAMP_SECOND_GEMINI_BASE_URL=https://campaign-api.autonomous.ai/api/v1/ai/v1/google-search/v1beta
# The words of this lamp's played test lines, heard as written (#1830); not a product setting.
Environment="LAMP_SECOND_KEY_TERMS=Hanoi,Da Nang,Ho Chi Minh City,desk lamp,two-line poem,haiku,Bitcoin,gold price,Louvre,Claude Code,Codex"
# Whom it answered: one line per first output the rule judged, private to root on the lamp, never published
# (lampOS/docs/attention.md, "The record of whom it answered"). Take this line out and nothing is written.
Environment=LAMP_FIRST_OUTPUT=/var/lib/lampOS/voice/first-output
# Said to the lamp by name and nothing answered: the model is told the name was heard (docs/attention.md).
Environment=LAMP_SECOND_LOOK=on
# The lamp's name heard as a request begins: the model is told so beside what it hears (docs/attention.md).
# Off on 2026-10-14 from 08:15 until the build of a3e36ce93: a note sent in a request that was then given up reached the next request (docs/voice-review-2026-10-14.md). Mended: the note is written just before the end of its request's sound.
Environment=LAMP_NAME_NOTE=on
Environment=LAMP_NAME_NOTE_BUSY=face
# The voice says its timing, the person's speech and its own sound on the bus, for the part that plans what the lamp shows (docs/expression.md). Nothing acts on it yet.
Environment=LAMP_EXPRESSION_OUT=on
Environment=LAMP_ACTIONS_DIR=/run/lampos-actions
# Reminders and timers by voice, said when due (#709, #747).
Environment=LAMP_SCHEDULE_TOOLS=on
Environment=LAMP_SCHEDULE_SOCKET=/run/lampos-schedule/call.sock
Environment=LAMP_SCHEDULE_SPEAK=on
Environment=LAMP_SCHEDULE_DELIVERY_DIR=/var/lib/lampOS/voice/schedule-delivery
Environment=LAMP_MEMORY_SOCKET=/run/lampos-memory/memory.sock
# The voice uses what memory across days adds (#698, #743).
Environment=LAMP_MEMORY_DAYS=on
Environment=LAMP_FAINT_HOLD_MS=400
Environment=LAMP_BUS=on
# What the microphone hears also goes on the bus (mic2/audio), for the part that hears the lamp's name
# (lampOS/docs/name.md). The one topic that carries sound; nothing on the lamp writes it down.
Environment=LAMP_BUS_AUDIO=on
Environment=LAMP_TOOLS=on
# The model asks the lamp's clock for the time (docs/tools.md).
Environment=LAMP_CLOCK=on
Environment=LAMP_SESSION_FACT=on
Environment=LAMP_ROOM_FACTS=on
Environment=LAMP_BODY_MOOD_SOCKET=/run/lampos-body/mood.sock
# And tell the eyes (lamp-eyes.service) they may look, while the microphone is permitted.
Environment=LAMP_EYES_PERMIT_SOCKET=/run/lampos-eyes/permit.sock
# Know when someone is sitting in front of the lamp (lampOS/docs/speaking-first.md): a reminder or news
# waits for them, and a skill's note is told who they are. The hello is Welcome back's alone (#2825).
Environment=LAMP_EYES_PRESENCE_FILE=/run/lampos-eyes/present
# Remembering a face when asked, and the name told with what a known person says and with a skill's note
# (lampOS/docs/eyes.md, "Who is there"); the eyes' known file is beside this socket.
Environment=LAMP_EYES_WHO_SOCKET=/run/lampos-eyes/who.sock
# Let the lamp take a look when it says "Let me look" (lampOS/docs/speaking-first.md): the eyes'
# newest frame goes to the model with that one request and with no other.
Environment=LAMP_EYES_LOOK_FILE=/run/lampos-eyes/sight.jpg
# And show the model what the eyes see, one picture with each thing a person says
# (lampOS/docs/eyes.md, "What the model sees"). Take this line out and it sees nothing.
# Off since 2026-10-13 13:40: a picture anywhere in a session made every later answer about
# 0.45 s later (lampOS/docs/eyes.md). Remove the next line's '#' to give the model its eyes again.
#Environment=LAMP_EYES_SIGHT_FILE=/run/lampos-eyes/sight.jpg
# Defence in depth only: this is not a mechanical stop.
InaccessiblePaths=/dev/ttyACM0

[Install]
WantedBy=multi-user.target
