# /etc/systemd/system/lamp-skills.service
# lampOS skills on lamp-4ace (lampOS/docs/skills.md): Welcome back, the hello on arrival, as a
# physical skill in place of the voice's own (lamp-voice.service here has LAMP_SPEAK_FIRST off, so
# only one greets). The skill folders are in /var/lib/lampOS/skills (lampOS/skills/welcome-back).
# It speaks through the voice's say service (#954: LAMP_SAY=on and LAMP_SAY_GROUP=orangepi in
# lamp-voice.service); without it a hello is never begun, and nothing moves or lights.
# LAMP_SKILLS_ASK=skip: the Policy's gate (#939) is not built yet, so nothing asks it.
[Unit]
Description=lampOS skills (lamp-skills)
ConditionHost=lamp-4ace
After=lamp-voice.service lamp-body.service lamp-actions.service

[Service]
Type=exec
User=orangepi
Group=orangepi
Environment=LAMP_SKILLS_ASK=skip
# The SHA-256 is the ARM64 run's lamp-skills (PR for #938), installed under /opt/lampOS/skills/.
ExecStart=/opt/lampOS/skills/79be32ac0bbf7d9646f0b343cc748d67e57e3d8e96b69ff097d28a54f966ef27/lamp-skills --dir /var/lib/lamp-skills --bus-root /run/lampos-bus --gaze-socket /run/lampos-body/gaze.sock --mood-socket /run/lampos-body/mood.sock --actions-socket /run/lampos-actions/call.sock --say-socket /run/lampos-say/say.sock --tools-dir /run/lampos-actions/skills
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
