# lampOS schedule: reminders and timers, kept on the lamp's flash, said due on schedule/due (lampOS/docs/schedule.md).
# Nothing sets a reminder until the voice is wired to its socket; until then it runs empty. Its own process and unit.
[Unit]
Description=lampOS schedule (lamp-schedule)
After=local-fs.target time-sync.target

[Service]
Type=simple
User=orangepi
Group=orangepi
StateDirectory=lampos-schedule
StateDirectoryMode=0700
RuntimeDirectory=lampos-schedule
RuntimeDirectoryMode=0700
# The clock: timedatectl says it is synchronized on this lamp, without systemd-timesyncd's marker, so trust is asserted.
# --zone system: a new reminder is set in the zone setup last pointed /etc/localtime at, followed
# without a restart (#820, #1825; needs a lamp-schedule with #1825); was --zone Asia/Ho_Chi_Minh.
ExecStart=/opt/lampOS/schedule/a834961a4f8c36f0a8989ec04f7f44c601eb03410857dd48927f07c6854e5e74/lamp-schedule serve --enable --dir /var/lib/lampos-schedule/store --socket /run/lampos-schedule/call.sock --zone system --bus-root /run/lampos-bus --trust-clock
Restart=on-failure
RestartSec=5s
SyslogIdentifier=lamp-schedule
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
