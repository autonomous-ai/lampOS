# lampOS body on lamp-4ace (the office lab prototype): small head motion for what the lamp is doing.
# It owns the servo port; lamp-voice.service cannot open it and only tells this unit a mood.
# Not enabled at boot. When it stops itself on a surprise (its JSON report in the journal says
# which) systemd starts it again after 15 s, at most three times in ten minutes; each start
# runs its checks again and refuses a lamp that is not as expected. After the third it stays
# stopped until someone has looked. Limits are fixed in the binary (lampOS/docs/body.md).
[Unit]
Description=lampOS body (lamp-body)
ConditionHost=lamp-4ace
After=lamp-voice.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=exec
# Never root: the servo port owner refuses a process that could bypass its exclusive lock.
User=orangepi
Group=orangepi
SupplementaryGroups=dialout
WorkingDirectory=/
# Where the joints are and how the body is, on the lamp's bus (lampOS/docs/body.md, "On the bus").
Environment=LAMP_BUS=on
# The head takes the little that expression asks to add to its pose (lampOS/docs/body.md, "What Expression may add"). Nothing asks yet unless lamp-expression runs with --enable.
Environment=LAMP_EXPRESSION_BODY=on
RuntimeDirectory=lampos-body
# --wake on (2026-10-14, task 23): a head or base found off where it may start, within 400 counts of home, is brought home slowly
# before anything else instead of refused; a lamp found where it may start writes exactly what it wrote without it (lampOS/docs/body.md, "Waking").
RuntimeDirectoryMode=0755
# --rest-glance on --look-at-name on --torque on --give-way return (2026-10-14 18:41, task 32, #718): a lamp at rest takes Expression's head pitch and roll only, at most 50 and 25 counts,
# and comes back to rest when it runs out; never the base or the arm (lampOS/docs/body.md, "A glance from rest").
ExecStart=/opt/lampOS/body/874ee83c1d55d6442aeb759270e665da87add4a354c95bdce528833916f166e6/lamp-body --device /dev/ttyACM0 --unit-id lamp-4ace --lock-directory /home/orangepi/.local/share/lampOS-voice/motor-locks --mood-socket /run/lampos-body/mood.sock --reach 150,15,1,250 --speed 120 --servo-speed 1000 --servo-acceleration 60 --gaze-socket /run/lampos-body/gaze.sock --gaze 727,553 --gaze-reach 480,120 --stand 1772,2043,2015,2657,2602 --folded-arm 2048,2047 --stand-share 100 --stand-seconds 6 --awake-seconds 90 --idle on --force-limit 600 --wake on --rest-glance on --look-at-name on --torque on --give-way return --home 1950,2043,2015
Restart=on-failure
RestartSec=15s
KillMode=mixed
KillSignal=SIGTERM
# A lamp that stands folds down before it leaves: up to 3 s and twice its way.
TimeoutStopSec=25s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-body
NoNewPrivileges=yes
