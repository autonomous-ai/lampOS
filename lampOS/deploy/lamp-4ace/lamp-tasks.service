# /etc/systemd/system/lamp-tasks.service
# lampOS tasks on lamp-4ace (lampOS/docs/tasks.md): work handed to Claude Code on another computer through Harness,
# started only after the person's spoken yes, which reaches it only on the voice's own socket.
# As the person (--harness-as-person): the owner chose the plain Harness CLI on 2026-10-14.
# Sessions run on other computers only: "lamp doesn't have enough resources" (owner, 2026-10-14).
[Unit]
Description=lampOS tasks (lamp-tasks)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=orangepi
Group=orangepi
Environment=HOME=/home/orangepi
Environment=PATH=/home/orangepi/.local/bin:/usr/local/bin:/usr/bin:/bin
RuntimeDirectory=lampos-tasks
RuntimeDirectoryMode=0700
StateDirectory=lampos-tasks
StateDirectoryMode=0700
ExecStart=/opt/lampOS/tasks/52d1c9de52f5aeabdc3aa95ffaa6108cc0f7970ae46674d45e0752ff7c4a8a40/lamp-tasks serve --enable --watch --progress --push-wait --harness-as-person --dir /var/lib/lampos-tasks/store --socket /run/lampos-tasks/request.sock --voice-socket /run/lampos-tasks/voice.sock --targets /var/lib/lampos-tasks/targets.json --harness /home/orangepi/.local/bin/harness
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
