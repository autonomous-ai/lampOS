# lampOS controls: reads the lamp's button and the touch pads on its head and says on the bus what a hand did
# (a tap, a hold, a pat; lampOS/docs/controls.md). Acting since 2026-10-14 17:15 (--enable), for the owner's hand-stop test; without it nothing it says may be acted on.
# Its own process and unit: with it stopped the lamp talks and moves as before.
# Its two settings files hold no secret and sit beside the build, because /etc/lampOS is readable by root alone and this runs as orangepi.
[Unit]
Description=lampOS controls (lamp-controls)
After=local-fs.target
ConditionHost=lamp-4ace

[Service]
Type=simple
User=orangepi
Group=orangepi
ExecStart=/opt/lampOS/controls/e16ef23448578827603acd8471914a833aac6ba9169858f8fd854874a2c7ad01/lamp-controls serve --config /opt/lampOS/controls/e16ef23448578827603acd8471914a833aac6ba9169858f8fd854874a2c7ad01/controls.json --pins /opt/lampOS/controls/e16ef23448578827603acd8471914a833aac6ba9169858f8fd854874a2c7ad01/controls-pins.json --bus-root /run/lampos-bus --enable --touch
Restart=on-failure
RestartSec=5s
SyslogIdentifier=lamp-controls
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
