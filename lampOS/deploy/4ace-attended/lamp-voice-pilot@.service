# Attended 4ace pilot. Remote installation of this stopped unit is authorized.
# Starting requires the separately reviewed stationary handover and preflight.
# No automatic legacy stop/start, motor policy, restart or boot activation.
[Unit]
Description=Attended Rust Lamp 4ace pilot (%i)
ConditionHost=lamp-4ace
After=network-online.target

[Service]
Type=exec
User=root
Group=root
Slice=system.slice
WorkingDirectory=/
UMask=0077
ExecStart=/opt/lampOS/releases/b1c61a224ea9958eeaa5f06b87fdc7591128da3daf01c21e2f3c851a7643edbd/lamp-voice serve /etc/lampOS/pilot-4ace/provider.json /var/lib/lampOS/pilot-4ace/sessions/%i --noise-suppression off --turn-taking v1-baseline --reference-clock capture --reference-recovery off --playout-start-ms 200 --ring-channel-ceiling 12
Restart=no
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-voice-pilot-%i
NoNewPrivileges=yes
# The pilot's voice is the second route, as lamp-4ace's own (#1712, the first builder at 19:43; lamp-voice-eval's
# played runs, #1916), with lamp-4ace's second.json and key files in /etc/lampOS/voice (deploy/product/lamp-voice.service
# names each one).
LoadCredential=gemini.key:/etc/lampOS/voice/second-llm.key
LoadCredential=deepseek.key:/etc/lampOS/voice/deepseek.key
Environment=LAMP_VOICE_ROUTE=second
Environment=LAMP_VOICE_SECOND_CONFIG=/etc/lampOS/voice/second.json
Environment=LAMP_SECOND_CHAT=deepseek
Environment=LAMP_SECOND_SEARCH=deepseek
Environment=LAMP_SECOND_SPEECH_MODEL=eleven_v4_turbo
Environment=LAMP_SECOND_GEMINI_BASE_URL=https://campaign-api.autonomous.ai/api/v1/ai/v1/google-search/v1beta
Environment=LAMP_SECOND_DOWN_LINE=on
Environment=LAMP_SECOND_WAIT_CUE=on
# Defense in depth only: no motor worker is launched, and this is not a
# mechanical stop or proof of placement. Keep the separate legacy guard intact.
InaccessiblePaths=/dev/ttyACM0
