# Attended 4ace pilot. Remote installation of this stopped unit is authorized.
# Starting requires the separately reviewed stationary handover and preflight.
# No automatic legacy stop/start, motor policy, restart or boot activation.
[Unit]
Description=Attended Rust Lamp 4ace pilot (%i)
ConditionHost=lamp-4ace
After=network-online.target

[Service]
Type=exec
User=root
Group=root
Slice=system.slice
WorkingDirectory=/
UMask=0077
ExecStart=/opt/lampOS/releases/b1c61a224ea9958eeaa5f06b87fdc7591128da3daf01c21e2f3c851a7643edbd/lamp-voice serve /etc/lampOS/pilot-4ace/provider.json /var/lib/lampOS/pilot-4ace/sessions/%i --noise-suppression off --turn-taking v1-baseline --reference-clock capture --reference-recovery off --playout-start-ms 200 --ring-channel-ceiling 12
Restart=no
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-voice-pilot-%i
NoNewPrivileges=yes
# The pilot's voice is the second route, as a product lamp's (#1712, the first builder at 19:43; lamp-voice-eval's
# played runs, #1916): DeepSeek through the relay, with lamp-4ace's /etc/lampOS/voice/second.json and its relay key,
# and no unit credential (deploy/product/lamp-voice.service).
Environment=LAMP_VOICE_ROUTE=second
Environment=LAMP_VOICE_SECOND_CONFIG=/etc/lampOS/voice/second.json
Environment=LAMP_SECOND_CHAT=deepseek
Environment=LAMP_SECOND_SEARCH=deepseek
Environment=LAMP_SECOND_SPEECH_MODEL=eleven_v4_turbo
# DeepSeek's chat and search go through the relay, at the address the voice derives from second.json's llm_base_url
# (second_config::relay_deepseek, #2978) with its llm_credential_file, so no deepseek.key (#1934, #1939). Not
# LAMP_SECOND_DEEPSEEK_BASE_URL here: an address the unit gives is never routed, so the relay's near route
# (LAMP_RELAY_ROUTES, #2882) could not take the chat (Queue #3126: lamp-4ace's r11 without it, 0.39 s off the median).
Environment=LAMP_SECOND_DOWN_LINE=on
Environment=LAMP_SECOND_WAIT_CUE=on
# Defense in depth only: no motor worker is launched, and this is not a
# mechanical stop or proof of placement. Keep the separate legacy guard intact.
# With '-', a servo port that isn't there when the pilot starts (a boot race: it comes up after the
# unit starts; the body unplugged; a lamp without one) is passed over, and then not hidden for that run:
# systemd sets up the namespace once, at start, and the next start hides it. Without '-' systemd fails the
# unit at start (226/NAMESPACE), and the restart guard can leave the lamp mute (lamp-a0ae, 28 Oct).
InaccessiblePaths=-/dev/ttyACM0
