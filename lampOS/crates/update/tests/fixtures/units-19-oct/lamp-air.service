# lampOS air: the air sensor on the I2C bus (lampOS/docs/air.md).
# The product unit (lampOS/docs/install.md).
[Unit]
Description=lampOS air (lamp-air)
PartOf=lampos.target
# Not before setup has finished (#806). The target's own condition holds back none of its parts.
ConditionPathExists=/var/lib/lampos-setup/done
After=local-fs.target lamp-voice.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=lampos
Group=lampos
Slice=lampos-parts.slice
Nice=10
DeviceAllow=/dev/i2c-0 rw
ExecStart=/opt/lampOS/air/current/lamp-air --bus-number 0 --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=10s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-air
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=lampos.target
