 #[cfg(test)]
 mod tests {
+    #[derive(Clone, Copy, Debug, Eq, PartialEq)]
+    enum ThreadOverlapEvent {
+        OwnReady,
+        MusicContended,
+        MusicPending,
+        OwnFinished,
+        MusicFinished,
+    }
+
+    struct ThreadOverlapProbe {
+        events: std::sync::mpsc::Sender<ThreadOverlapEvent>,
+        resume: std::sync::mpsc::Receiver<()>,
+    }
+
+    thread_local! {
+        static THREAD_OVERLAP_PROBE: std::cell::RefCell<Option<ThreadOverlapProbe>> =
+            const { std::cell::RefCell::new(None) };
+    }
+
+    fn thread_overlap_active() -> bool {
+        THREAD_OVERLAP_PROBE.with(|probe| probe.borrow().is_some())
+    }
+
+    fn thread_overlap_pause(event: ThreadOverlapEvent) {
+        THREAD_OVERLAP_PROBE.with(|probe| {
+            let probe = probe.borrow();
+            let probe = probe.as_ref().unwrap();
+            eprintln!("THREAD_OVERLAP {event:?}");
+            probe.events.send(event).unwrap();
+            probe.resume.recv_timeout(Duration::from_secs(3))
+                .expect("the overlap driver must release its fixture");
+        });
+    }
+
+    #[test]
+    fn own_answers_and_pending_music_share_no_conversation_state() {
+        use std::sync::mpsc;
+        use ThreadOverlapEvent::*;
+
+        let (events, seen) = mpsc::channel();
+        let (own_resume, own_wait) = mpsc::channel();
+        let own_events = events.clone();
+        let own = std::thread::spawn(move || {
+            THREAD_OVERLAP_PROBE.with(|probe| {
+                *probe.borrow_mut() = Some(ThreadOverlapProbe {
+                    events: own_events.clone(), resume: own_wait,
+                });
+            });
+            let result = std::panic::catch_unwind(
+                the_lamps_own_answers_to_talk_keep_no_conversation_going,
+            );
+            own_events.send(OwnFinished).unwrap();
+            result
+        });
+        let next = || seen.recv_timeout(Duration::from_secs(3))
+            .expect("the overlap driver must receive its next positive event");
+        assert_eq!(next(), OwnReady);
+        let (music_resume, music_wait) = mpsc::channel();
+        let music_events = events.clone();
+        let music = std::thread::spawn(move || {
+            THREAD_OVERLAP_PROBE.with(|probe| {
+                *probe.borrow_mut() = Some(ThreadOverlapProbe {
+                    events: music_events.clone(), resume: music_wait,
+                });
+            });
+            let contended = music_events.clone();
+            crate::provider_worker::tests::observe_thread_overlap_wait(move || {
+                eprintln!("THREAD_OVERLAP MusicContended");
+                contended.send(MusicContended).unwrap();
+            });
+            let result = std::panic::catch_unwind(|| check_stop_during_music_rpc(false));
+            music_events.send(MusicFinished).unwrap();
+            result
+        });
+        let first = next();
+        assert!(matches!(first, MusicContended | MusicPending), "{first:?}");
+        own_resume.send(()).unwrap();
+        let mut own_finished = false;
+        let mut music_pending = first == MusicPending;
+        while !own_finished || !music_pending {
+            match next() {
+                OwnFinished => own_finished = true,
+                MusicPending => music_pending = true,
+                event => panic!("unexpected overlap event: {event:?}"),
+            }
+        }
+        music_resume.send(()).unwrap();
+        assert_eq!(next(), MusicFinished);
+        let own_result = own.join().unwrap();
+        let music_result = music.join().unwrap();
+        eprintln!("THREAD_OVERLAP own_ok={} music_ok={}", own_result.is_ok(), music_result.is_ok());
+        assert!(music_result.is_ok(), "the original Music checks must pass");
+        // Preserve the original fixture's assertion and panic payload.
+        if let Err(panic) = own_result {
+            std::panic::resume_unwind(panic);
+        }
+        assert_eq!(first, MusicContended, "the held conversation must exclude Music");
+    }
