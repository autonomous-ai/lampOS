+// SCRATCH-ONLY diagnostics. No production file or deadline is changed.
+// Enable only with a private, short absolute LAMP_MOTOR_DIAGNOSTICS directory.
+// Child markers are best-effort nonblocking datagrams, never durable evidence.
+struct MotorDiagnostic {
+    directory: PathBuf,
+    socket: std::os::unix::net::UnixDatagram,
+    mode: String,
+    started_us: u64,
+    previous_us: u64,
+    maximum_gap_us: u64,
+    samples: u64,
+    first: Vec<serde_json::Value>,
+    recent: VecDeque<serde_json::Value>,
+    children: Vec<serde_json::Value>,
+    events: Vec<serde_json::Value>,
+    event_count: u64,
+    saves: u64,
+}
+thread_local! {
+    static MOTOR_DIAGNOSTIC: std::cell::RefCell<Option<MotorDiagnostic>> = const {
+        std::cell::RefCell::new(None)
+    };
+}
+fn diagnostic_start(mode: &str) -> Option<PathBuf> {
+    let _ = MOTOR_DIAGNOSTIC.with(|slot| slot.borrow_mut().take());
+    let root = PathBuf::from(std::env::var_os("LAMP_MOTOR_DIAGNOSTICS")?);
+    assert!(root.is_absolute(), "diagnostics directory must be absolute");
+    let metadata = fs::symlink_metadata(&root).expect("diagnostics directory");
+    assert!(metadata.is_dir() && metadata.permissions().mode() & 0o077 == 0);
+    let started_us = monotonic_us();
+    let directory = root.join(format!("{}-{started_us}", std::process::id()));
+    use std::os::unix::fs::DirBuilderExt;
+    fs::DirBuilder::new().mode(0o700).create(&directory).unwrap();
+    let path = directory.join("d");
+    let socket = std::os::unix::net::UnixDatagram::bind(&path).unwrap();
+    fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+    socket.set_nonblocking(true).unwrap();
+    MOTOR_DIAGNOSTIC.with(|slot| {
+        *slot.borrow_mut() = Some(MotorDiagnostic {
+            directory,
+            socket,
+            mode: mode.to_owned(),
+            started_us,
+            previous_us: started_us,
+            maximum_gap_us: 0,
+            samples: 0,
+            first: Vec::with_capacity(16),
+            recent: VecDeque::with_capacity(256),
+            children: Vec::with_capacity(32),
+            events: Vec::with_capacity(64),
+            event_count: 0,
+            saves: 0,
+        });
+    });
+    Some(path)
+}
+fn diagnostic_child(stage: &'static str) {
+    use std::sync::{OnceLock, atomic::{AtomicUsize, Ordering}};
+    static SOCKET: OnceLock<Option<std::os::unix::net::UnixDatagram>> = OnceLock::new();
+    static COUNT: AtomicUsize = AtomicUsize::new(0);
+    let Some(socket) = SOCKET.get_or_init(|| {
+        let path = std::env::var_os("LAMP_MOTOR_DIAGNOSTIC_SOCKET")?;
+        let socket = std::os::unix::net::UnixDatagram::unbound().ok()?;
+        socket.set_nonblocking(true).ok()?;
+        socket.connect(path).ok()?;
+        Some(socket)
+    }) else { return };
+    let sequence = COUNT.fetch_add(1, Ordering::Relaxed);
+    if sequence >= 32 { return }
+    let marker = serde_json::json!({
+        "sequence": sequence, "stage": stage,
+        "at_us": monotonic_us(), "pid": std::process::id(),
+    });
+    let bytes = serde_json::to_vec(&marker).unwrap();
+    // No retry: missing markers remain unknown, not proof a stage was absent.
+    let _ = socket.send(&bytes);
+}
+fn diagnostic_drain(diagnostic: &mut MotorDiagnostic) {
+    for _ in 0..32 {
+        let mut bytes = [0; 512];
+        let Ok(count) = diagnostic.socket.recv(&mut bytes) else { break };
+        if diagnostic.children.len() < 32 {
+            diagnostic.children.push(serde_json::json!({
+                "received_us": monotonic_us(),
+                "marker": serde_json::from_slice::<serde_json::Value>(&bytes[..count]).ok(),
+            }));
+        }
+    }
+}
+fn diagnostic_parent(stage: &'static str, motor: &OptionalMotor) {
+    MOTOR_DIAGNOSTIC.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        let Some(diagnostic) = slot.as_mut() else { return };
+        let at_us = monotonic_us();
+        let gap_us = at_us.saturating_sub(diagnostic.previous_us);
+        diagnostic.previous_us = at_us;
+        diagnostic.maximum_gap_us = diagnostic.maximum_gap_us.max(gap_us);
+        diagnostic.samples += 1;
+        let child = motor.child.as_ref();
+        let sample = serde_json::json!({
+            "stage": stage, "at_us": at_us, "gap_us": gap_us,
+            "connected": child.is_some_and(Supervisor::connected),
+            "ready": motor.is_ready(), "reaped": motor.reaped(),
+            "adapter_failure": motor.failure(),
+            "child_failure": child.and_then(Supervisor::failure),
+        });
+        if diagnostic.first.len() < 16 { diagnostic.first.push(sample.clone()); }
+        if diagnostic.recent.len() == 256 { let _ = diagnostic.recent.pop_front(); }
+        diagnostic.recent.push_back(sample);
+        diagnostic_drain(diagnostic);
+    });
+}
+fn diagnostic_event(event: &Event) {
+    MOTOR_DIAGNOSTIC.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        let Some(diagnostic) = slot.as_mut() else { return };
+        diagnostic.event_count += 1;
+        let stage = match event {
+            Event::Ready { .. } => "ready",
+            Event::Inhibited { .. } => "inhibited",
+            Event::Stopped { .. } => "stopped",
+            Event::Fault { .. } => "fault",
+            _ => return,
+        };
+        if diagnostic.events.len() < 64 {
+            diagnostic.events.push(serde_json::json!({
+                "stage": stage, "event_us": event.at_us(), "observed_us": monotonic_us(),
+            }));
+        }
+    });
+}
+fn diagnostic_save(outcome: &'static str) {
+    MOTOR_DIAGNOSTIC.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        let Some(diagnostic) = slot.as_mut() else { return };
+        diagnostic_drain(diagnostic);
+        diagnostic.saves += 1;
+        let record = serde_json::json!({
+            "mode": diagnostic.mode, "outcome": outcome,
+            "fixture_started_us": diagnostic.started_us,
+            "recorded_us": monotonic_us(), "sample_count": diagnostic.samples,
+            "maximum_gap_us": diagnostic.maximum_gap_us,
+            "first_samples": diagnostic.first, "recent_samples": diagnostic.recent,
+            "child_markers": diagnostic.children,
+            "event_count": diagnostic.event_count, "events": diagnostic.events,
+        });
+        let bytes = serde_json::to_vec_pretty(&record).unwrap();
+        assert!(bytes.len() <= 262_144, "diagnostic record exceeded fixed bound");
+        let path = diagnostic.directory.join(format!("wait-{}.json", diagnostic.saves));
+        // This write is after success or after the original deadline has expired.
+        // It never runs in the live poll loop and does not fsync.
+        fs::write(&path, bytes).unwrap();
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+        eprintln!("motor diagnostic: {}", path.display());
+    });
+}
 
