+        &mut lamp,
+        &[
+            ("alpha", "After=lamp-middle.service"),
+            ("middle", "After=lamp-alpha.service"),
+        ],
+        &[("alpha", ""), ("middle", "")],
+        &[],
+        &["middle", "alpha"],
+    );
