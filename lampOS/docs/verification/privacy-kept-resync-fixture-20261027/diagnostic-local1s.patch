+#[cfg(test)]
+mod lease_resync_diagnostic {
+    use std::cell::{Cell, RefCell};
+    use std::io::Write;
+    thread_local! {
+        static RECORDS: RefCell<Vec<(&'static str, serde_json::Value)>> = const { RefCell::new(Vec::new()) };
+        static LAST_CURRENT: RefCell<Option<serde_json::Value>> = const { RefCell::new(None) };
+        static OVERFLOW: Cell<bool> = const { Cell::new(false) };
+    }
+    pub(super) fn record(kind: &'static str, mut value: serde_json::Value) {
+        if kind == "CURRENT" {
+            LAST_CURRENT.with(|current| *current.borrow_mut() = Some(value.clone()));
+        }
+        if kind == "NOTICE" {
+            value["nearest_payload"] = LAST_CURRENT.with(|current| current.borrow().clone()).unwrap_or(serde_json::Value::Null);
+        }
+        RECORDS.with(|records| {
+            let mut records = records.borrow_mut();
+            if records.len() < 128 {
+                records.push((kind, value));
+            } else {
+                OVERFLOW.with(|overflow| overflow.set(true));
+            }
+        });
+    }
+    pub(super) struct Guard;
+    impl Guard {
+        pub(super) fn new() -> Self {
+            RECORDS.with(|records| records.borrow_mut().clear());
+            LAST_CURRENT.with(|current| *current.borrow_mut() = None);
+            OVERFLOW.with(|overflow| overflow.set(false));
+            Self
+        }
+    }
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            // Flush after the case (including unwind), outside its lease window.
+            let records = RECORDS.with(|records| std::mem::take(&mut *records.borrow_mut()));
+            let overflow = OVERFLOW.with(Cell::get);
+            let mut stderr = std::io::stderr().lock();
+            let _ = writeln!(stderr, "PRIVACY_DIAGNOSTIC_BUFFER {}", serde_json::json!({"overflow": overflow, "records": records.len()}));
+            for (kind, value) in records {
+                let _ = writeln!(stderr, "PRIVACY_DIAGNOSTIC_{kind} {value}");
+            }
+            LAST_CURRENT.with(|current| *current.borrow_mut() = None);
+        }
     }
 }
 
