+//! Shared semantic time for explicitly opted-in, single-root fixtures only.
+use crate::{Source, live, wire};
+use std::{fmt, io, path::Path, time::{Duration, Instant}};
+#[cfg(any(test, feature = "fixture-clock"))]
+use std::{sync::Arc, time::{SystemTime, UNIX_EPOCH}};
+
+/// Pure, non-advancing reads in one owner-controlled domain. All participants
+/// under an opted-in root must share this clock; never mix ordinary actors there.
+/// Real socket waits, filesystem I/O completion and cleanup watchdogs are not time here.
+#[cfg(any(test, feature = "fixture-clock"))]
+pub trait FixtureClock: Send + Sync + 'static {
+    fn now(&self) -> Instant;
+    fn wall_ms(&self) -> u64;
+}
+
+#[derive(Clone, Default)]
+pub(crate) enum ClockSource {
+    #[default]
+    System,
+    #[cfg(any(test, feature = "fixture-clock"))]
+    Fixture(Arc<dyn FixtureClock>),
+}
+impl fmt::Debug for ClockSource {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(match self {
+            Self::System => "System",
+            #[cfg(any(test, feature = "fixture-clock"))]
+            Self::Fixture(_) => "Fixture",
+        })
+    }
+}
+impl ClockSource {
+    pub(crate) fn now(&self) -> Instant {
+        match self {
+            Self::System => Instant::now(),
+            #[cfg(any(test, feature = "fixture-clock"))]
+            Self::Fixture(clock) => clock.now(),
+        }
+    }
+    pub(crate) fn wall_ms(&self) -> u64 {
+        match self {
+            Self::System => wire::unix_ms(),
+            #[cfg(any(test, feature = "fixture-clock"))]
+            Self::Fixture(clock) => clock.wall_ms(),
+        }
+    }
+    pub(crate) fn touch(&self, path: &Path) -> io::Result<()> {
+        match self {
+            Self::System => live::touch(path),
+            #[cfg(any(test, feature = "fixture-clock"))]
+            Self::Fixture(clock) => live::touch_with(path, || fixture_wall(clock.as_ref())),
+        }
+    }
+    pub(crate) fn sources(&self, path: &Path, lease: Duration) -> io::Result<Vec<Source>> {
+        match self {
+            Self::System => live::list(path, lease),
+            #[cfg(any(test, feature = "fixture-clock"))]
+            Self::Fixture(clock) => live::list_with(path, lease, || fixture_wall(clock.as_ref())),
+        }
+    }
+}
+#[cfg(any(test, feature = "fixture-clock"))]
+fn fixture_wall(clock: &dyn FixtureClock) -> io::Result<SystemTime> {
+    UNIX_EPOCH.checked_add(Duration::from_millis(clock.wall_ms()))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "fixture wall outside SystemTime"))
+}
