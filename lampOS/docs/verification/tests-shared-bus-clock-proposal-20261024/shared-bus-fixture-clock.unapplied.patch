+//! Proposed controls; not compiled or executed. Each root has exactly one time domain.
+use super::*;
+use std::sync::{Arc, Mutex};
+
+struct Root(PathBuf);
+impl Root {
+    fn new() -> Self {
+        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+        let path = std::env::temp_dir().join(format!("lbf-{}-{}", std::process::id(),
+            NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed)));
+        std::fs::create_dir(&path).unwrap();
+        Self(path)
+    }
+}
+impl Drop for Root {
+    fn drop(&mut self) { std::fs::remove_dir_all(&self.0).unwrap(); }
+}
+struct Clock(Mutex<(Instant, u64)>);
+impl Clock {
+    fn new() -> Arc<Self> { Arc::new(Self(Mutex::new((Instant::now(), 1_000)))) }
+    fn advance(&self, ms: u64) {
+        let mut clock = self.0.lock().unwrap();
+        clock.0 = clock.0.checked_add(Duration::from_millis(ms)).unwrap();
+        clock.1 = clock.1.checked_add(ms).unwrap();
+    }
+}
+impl FixtureClock for Clock {
+    fn now(&self) -> Instant { self.0.lock().unwrap().0 }
+    fn wall_ms(&self) -> u64 { self.0.lock().unwrap().1 }
+}
+fn declared() -> Declaration {
+    Declaration::new("fixture/Value", 1, Kind::Latest)
+        .every(Duration::from_millis(10)).lasting(Duration::from_millis(50))
+}
+
+#[test]
+fn ordinary_constructors_stay_system_while_an_explicit_bus_and_its_clones_share_time() {
+    let ordinary_root = Root::new();
+    let fixture_root = Root::new();
+    let ordinary = Bus::new(&ordinary_root.0).unwrap();
+    assert!(matches!(ordinary.clock, clock::ClockSource::System));
+    let clock = Clock::new();
+    let fixture = Bus::new(&fixture_root.0).unwrap().with_fixture_clock(clock.clone());
+    let subscriber_bus = fixture.clone();
+    let mut subscriber = subscriber_bus.subscribe_typed("fixture", "typed", "fixture/Value").unwrap();
+    let mut publisher = fixture.publisher_declared("fixture", &declared(), "source").unwrap();
+    publisher.publish_json(1, &1).unwrap();
+    let message = subscriber.recv(Duration::ZERO).unwrap().unwrap();
+    assert_eq!(message.header.at_unix_ms, 1_000);
+    assert!(!message.expired);
+    assert_eq!(fixture.latest("fixture").unwrap().unwrap().header.at_unix_ms, 1_000);
+    let before = wire::unix_ms();
+    let mut ordinary_publisher = ordinary.publisher("plain", Kind::Latest, "source").unwrap();
+    ordinary_publisher.publish_json(1, &1).unwrap();
+    let ordinary_wall = ordinary.latest("plain").unwrap().unwrap().header.at_unix_ms;
+    assert!(before <= ordinary_wall && ordinary_wall <= wire::unix_ms());
+    // The untyped constructor also inherits only an explicitly opted-in Bus.
+    let mut untyped = fixture.subscribe("fixture", "untyped").unwrap();
+    let kept = untyped.latest().unwrap().unwrap();
+    assert_eq!(kept.header.at_unix_ms, 1_000);
+    assert!(!kept.expired);
+}
+
+#[test]
+fn expiry_and_grace_still_end_at_the_same_logical_boundaries() {
+    let root = Root::new();
+    let clock = Clock::new();
+    let bus = Bus::new(&root.0).unwrap().with_fixture_clock(clock.clone());
+    let mut publisher = bus.publisher_declared("fixture", &declared(), "source").unwrap();
+    publisher.publish_json(1, &1).unwrap();
+    let mut subscriber = bus.subscribe_typed("fixture", "reader", "fixture/Value").unwrap();
+    clock.advance(100); // original 50 ms lifespan plus original 50 ms grace
+    assert!(!bus.latest("fixture").unwrap().unwrap().expired);
+    assert!(!subscriber.latest().unwrap().unwrap().expired);
+    clock.advance(1);
+    assert!(bus.latest("fixture").unwrap().unwrap().expired);
+    assert!(subscriber.latest().unwrap().unwrap().expired);
+}
+
+#[test]
+fn late_and_source_gone_require_their_original_logical_time_and_presence_changes() {
+    let root = Root::new();
+    let clock = Clock::new();
+    let bus = Bus::new(&root.0).unwrap().with_fixture_clock(clock.clone());
+    let mut subscriber = bus.subscribe_typed("fixture", "reader", "fixture/Value").unwrap();
+    let mut publisher = bus.publisher_declared("fixture", &declared(), "source").unwrap();
+    publisher.publish_json(1, &1).unwrap();
+    assert!(subscriber.recv(Duration::ZERO).unwrap().is_some());
+    clock.advance(20);
+    assert!(!subscriber.is_late());
+    clock.advance(1);
+    assert!(subscriber.is_late());
+    assert!(!subscriber.source_gone());
+    // At the original 3 s presence lease a publisher still exists, without sleeping.
+    clock.advance(2_979);
+    assert!(!subscriber.source_gone());
+    assert_eq!(bus.publishers("fixture").unwrap().len(), 1);
+    clock.advance(1);
+    assert!(subscriber.source_gone());
+    assert!(bus.publishers("fixture").unwrap().is_empty());
+    // A new publication uses the same owner clock, restores presence, and ends Gone.
+    publisher.publish_json(2, &2).unwrap();
+    assert!(subscriber.recv(Duration::ZERO).unwrap().is_some());
+    assert!(!subscriber.source_gone());
+    assert_eq!(bus.publishers("fixture").unwrap().len(), 1);
+    assert!(subscriber.notices().contains(&Notice::SourceBack));
+}
+
+#[test]
+fn retained_rescan_uses_owned_time_and_guarded_header_stamps_use_that_wall() {
+    let root = Root::new();
+    let clock = Clock::new();
+    let bus = Bus::new(&root.0).unwrap().rescan_every(Duration::from_millis(5))
+        .with_fixture_clock(clock.clone());
+    // Scan with no subscriber, then keep only; no hidden delivered datagrams.
+    let cadence = clock.clone();
+    let mut publisher = bus.clone().rescan_every(Duration::from_secs(3_600))
+        .publisher_declared_with_cadence_clock("fixture", &declared(), "source", move || cadence.now())
+        .unwrap();
+    assert_eq!(publisher.publish_json(1, &1).unwrap().delivered, 0);
+    let mut subscriber = bus.subscribe_typed("fixture", "reader", "fixture/Value").unwrap();
+    assert_eq!(subscriber.recv(Duration::ZERO).unwrap().unwrap().header.seq, 1);
+    assert_eq!(publisher.publish_json(2, &2).unwrap().delivered, 0);
+    assert!(subscriber.recv(Duration::ZERO).unwrap().is_none());
+    clock.advance(5);
+    assert_eq!(subscriber.recv(Duration::ZERO).unwrap().unwrap().header.seq, 2);
+    let event = Declaration::new("fixture/Event", 1, Kind::Event);
+    let mut event_publisher = bus.publisher_declared("event", &event, "source").unwrap();
+    let mut events = bus.subscribe_typed("event", "reader", "fixture/Event").unwrap();
+    event_publisher.publish_bytes_guarded(1, JSON, b"{}", || true).unwrap();
+    assert_eq!(events.recv(Duration::ZERO).unwrap().unwrap().header.at_unix_ms, 1_005);
+}
