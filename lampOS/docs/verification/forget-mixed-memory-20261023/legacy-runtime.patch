-            &mut store,
-            json!({"op":"remember","person":MAI,"at_unix_ms":NOW,"text":"Sister's wedding is on Saturday."}),
-        );
-        assert_eq!(wedding, json!({"ok":true,"id":1}));
-        let old = store.observe_for_test(&mai, NOW, "Favourite colour is blue.", false);
