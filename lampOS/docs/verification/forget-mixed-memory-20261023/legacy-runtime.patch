-        let mai = Person::new(MAI).unwrap();
-        let an = Person::new(AN).unwrap();
-        let ask = |store: &mut Days, request: Value| -> Value {
-            serde_json::from_str(&answer(store, request.to_string().as_bytes(), NOW + 9).line)
-                .unwrap()
-        };
