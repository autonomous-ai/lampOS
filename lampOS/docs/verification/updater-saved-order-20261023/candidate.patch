+    assert_eq!(restarts(&lamp), [name("zulu"), name("alpha")]);
+    assert_eq!(lamp.systemd.units[&name("steady")].pid, steady_pid);
+    assert!(!lamp.systemd.units.contains_key(&name("sleeping")));
