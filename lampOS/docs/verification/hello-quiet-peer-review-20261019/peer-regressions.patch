+
+// Append inside crates/voice/src/second_provider/tests.rs. This uses that
+// module's Script, scripted, start, audio and end helpers and existing imports.
+// Characterization of the production ordering, not an assertion of the desired
+// Policy outcome: the current-thread worker can publish its verdict while the
+// matching heard transcript is still waiting in Engine's output queue.
+#[tokio::test(flavor = "current_thread")]
+async fn held_verdict_is_published_before_the_queued_transcript_is_consumed() {
+    let script = Arc::new(Script {
+        heard: Mutex::new([Ok("Room talk.".to_owned())].into()),
+        ..Script::default()
+    });
+    let (engine, calls, _) = scripted(script.clone());
+    let (published, received) = tokio::sync::oneshot::channel();
+    let published = Mutex::new(Some(published));
+    let mut engine = engine
+        .heeding(Arc::new(|_, _, _, _| Some("a busy room")))
+        .telling_verdicts(Arc::new(move |request, verdict| {
+            // In the real worker this synchronous callback calls TurnOut::tell.
+            // The barrier observes that boundary without consuming any output.
+            published
+                .lock()
+                .unwrap()
+                .take()
+                .expect("one verdict")
+                .send((request, verdict))
+                .expect("the publication observer is present");
+        }));
+    engine.submit(start(1));
+    engine.submit(audio(1, 1));
+    engine.submit(end(1));
+
+    let verdict = tokio::time::timeout(Duration::from_secs(2), received)
+        .await
+        .expect("publication does not wait for output delivery")
+        .expect("the verdict callback runs");
+    assert_eq!(verdict, (1, lamp_msgs::TurnVerdict::HeldBack));
+
+    // This is the first drain. Neither the worker's 2 ms output loop nor the
+    // coordinator could have published this transcript on voice/heard yet.
+    assert!(matches!(
+        engine.try_output(),
+        Some(ProviderOutput::Started { request: 1, .. })
+    ));
+    assert!(matches!(
+        engine.try_output(),
+        Some(ProviderOutput::Transcript {
+            request: None,
+            text,
+            finished: true,
+        }) if text == "Room talk."
+    ));
+    assert!(matches!(
+        engine.try_output(),
+        Some(ProviderOutput::TurnComplete {
+            request: 1,
+            idle: true,
+        })
+    ));
+    assert!(engine.try_output().is_none());
+    assert!(script.asked.lock().unwrap().is_empty());
+    assert!(calls.lock().unwrap().is_empty());
+}
