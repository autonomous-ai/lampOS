+#[test]
+#[ignore = "manual actual old ARM64 helper; needs Docker and LAMP_COMPAT_OLD_HELPER"]
+fn cut_after_actual_old_apply_recovers_pins_and_restarts_unchanged_controls() {
+    let mut lamp = old_product(true);
+    let owner = actual_helper_owner(&mut lamp);
+    let files = etc_files(&lamp);
+    let settings = lamp.state()["settings"].clone();
+    let links: Vec<_> = ["voice", "expression", "controls", "body"]
+        .into_iter()
+        .map(|part| {
+            let path = lamp.root.join(format!("opt/lampOS/{part}/current"));
+            let target = fs::read_link(&path).unwrap();
+            (path, target)
+        })
+        .collect();
+    let mut build = product_build(&mut lamp, 1);
+    build.sequence = 2;
+    assert!(build.units.is_empty());
+    let candidate = OLD_PINS.replace("\"every_ms\": 5", "\"every_ms\": 6");
+    build.settings = vec![Setting::new(PINS, &candidate)];
+    needing(&mut lamp, build, manifest::SETTINGS_UPDATER);
+    #[derive(Debug)]
+    struct AfterActualOldApply;
+    let first = Rc::new(Cell::new(true));
+    let cut_once = Rc::clone(&first);
+    let operations = Rc::new(RefCell::new(Vec::new()));
+    let seen = Rc::clone(&operations);
+    let root = lamp.root.clone();
+    lamp.systemd.applier = Some(Box::new(move || {
+        let request: apply::Request = serde_json::from_slice(
+            &fs::read(root.join("var/lib/lampos-update/apply/request.json")).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(
+            helper_release_pair::old_apply_in_test_root(&root, &owner),
+            0
+        );
+        seen.borrow_mut().push(request.op);
+        if cut_once.replace(false) {
+            assert_eq!(request.op, apply::Op::Apply);
+            std::panic::panic_any(AfterActualOldApply);
+        }
+        assert_eq!(request.op, apply::Op::Back);
+        assert_eq!(
+            fs::read_to_string(root.join(PINS.trim_start_matches('/'))).unwrap(),
+            OLD_PINS
+        );
+        Ok(())
+    }));
+    // This is a logical coordinator cut after actual helper completion,
+    // not process death, a daemon exec handover or physical flash evidence.
+    let cut = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| lamp.round()));
+    match cut {
+        Err(payload) if payload.is::<AfterActualOldApply>() => {}
+        Err(other) => std::panic::resume_unwind(other),
+        Ok(outcome) => panic!(
+            "actual old Apply cut was not reached: {outcome:?}; {:?}",
+            lamp.said
+        ),
+    }
+    assert!(!first.get());
+    assert_eq!(lamp.read(PINS), candidate);
+    assert!(lamp.exists("/var/lib/lampos-update/journal.json"));
+    for (name, old) in OLD_UNITS {
+        assert_eq!(lamp.read(&format!("/etc/systemd/system/{name}")), old);
+    }
+    for (path, target) in &links {
+        assert_eq!(fs::read_link(path).unwrap(), *target);
+    }
+    lamp.calls.borrow_mut().clear();
+    // Lamp::round constructs a fresh World around the same persisted files.
+    let outcome = lamp.round();
+    assert!(
+        matches!(
+            &outcome,
+            Outcome::RolledBack {
+                sequence: 2,
+                after: Ok(()),
+                ..
+            }
+        ),
+        "{outcome:?}; {:?}",
+        lamp.said,
+    );
+    assert_eq!(*operations.borrow(), [apply::Op::Apply, apply::Op::Back]);
+    assert_eq!(etc_files(&lamp), files);
+    assert_eq!(lamp.state()["settings"], settings);
+    let calls = lamp.calls();
+    let back = calls
+        .iter()
+        .position(|call| call == &format!("restart {}", apply::UNIT))
+        .unwrap();
+    let controls = calls
+        .iter()
+        .position(|call| call == "restart lamp-controls.service")
+        .expect("unchanged Controls must reload the restored pins");
+    assert!(back < controls, "{calls:?}");
+    for (path, target) in links {
+        assert_eq!(fs::read_link(path).unwrap(), target);
+    }
+}
