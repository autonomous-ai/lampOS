+// Experimental manual transport only: the ordinary round tests never invoke
+// Docker. These checks keep the current host coordinator and fake systemd;
+// only the fixed old helper executes in an ARM64 container.
+#[path = "../helper_release_pair.rs"]
+mod helper_release_pair;
+
+fn actual_helper_owner(lamp: &mut Lamp) -> Rc<tempfile::TempDir> {
+    // Keep the lamp's actual TempDir alive in the 'static applier closure.
+    // Lamp's replacement folder is empty; root still names the original.
+    let owner = Rc::new(std::mem::replace(
+        &mut lamp._folder,
+        tempfile::tempdir().unwrap(),
+    ));
+    assert_eq!(lamp.root, owner.path());
+    let path = lamp.root.join("etc/lampOS/update/key.pub");
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    // This is the existing fixture's throwaway signer, not another helper
+    // fixture's trust or a real lamp's key.
+    fs::write(path, manifest::public_key_text(&lamp.key)).unwrap();
+    owner
+}
+
+#[test]
+#[ignore = "manual actual old ARM64 helper; needs Docker and LAMP_COMPAT_OLD_HELPER"]
+fn actual_old_helper_pins_mismatch_is_put_back_before_readers_restart() {
+    let mut lamp = old_product(true);
+    let owner = actual_helper_owner(&mut lamp);
+    let files = etc_files(&lamp);
+    let settings = lamp.state()["settings"].clone();
+    let mut build = publish_readers(&mut lamp, true, true, true);
+    // Unlike the in-process emulation above, make the signed old-mode pins
+    // differ from those installed so the old helper really writes a backup.
+    let candidate = OLD_PINS.replace("\"every_ms\": 5", "\"every_ms\": 6");
+    build.settings = vec![Setting::new(PINS, &candidate)];
+    needing(&mut lamp, build, manifest::SETTINGS_UPDATER);
+    let (root, calls) = (lamp.root.clone(), Rc::clone(&lamp.calls));
+    let operations = Rc::new(RefCell::new(Vec::new()));
+    let seen = Rc::clone(&operations);
+    lamp.systemd.applier = Some(Box::new(move || {
+        let request: apply::Request = serde_json::from_slice(
+            &fs::read(root.join("var/lib/lampos-update/apply/request.json")).unwrap(),
+        )
+        .unwrap();
+        if request.op == apply::Op::Back {
+            assert!(
+                !calls.borrow().iter().any(|call| {
+                    call == "restart lamp-voice.service"
+                        || call == "restart lamp-expression.service"
+                        || call == "restart lamp-controls.service"
+                }),
+                "readers restarted before actual old Back restored pins: {:?}",
+                calls.borrow(),
+            );
+        }
+        assert_eq!(
+            helper_release_pair::old_apply_in_test_root(&root, &owner),
+            0
+        );
+        if request.op == apply::Op::Apply {
+            assert_eq!(
+                fs::read_to_string(root.join(PINS.trim_start_matches('/'))).unwrap(),
+                candidate
+            );
+        } else {
+            assert_eq!(
+                fs::read_to_string(root.join(PINS.trim_start_matches('/'))).unwrap(),
+                OLD_PINS
+            );
+        }
+        seen.borrow_mut().push(request.op);
+        Ok(())
+    }));
+    let outcome = lamp.round();
+    assert!(
+        matches!(
+            &outcome,
+            Outcome::RolledBack {
+                sequence: 2,
+                after: Ok(()),
+                ..
+            }
+        ),
+        "{outcome:?}; {:?}",
+        lamp.said,
+    );
+    assert_eq!(*operations.borrow(), [apply::Op::Apply, apply::Op::Back]);
+    assert_eq!(etc_files(&lamp), files);
+    assert_eq!(lamp.state()["settings"], settings);
+    assert!(!head_voice(&lamp));
+    assert!(!head_expression(&lamp));
+}
