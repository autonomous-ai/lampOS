{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/autonomous-ai/lampOS/blob/lamp-voice/lampOS/docs/control.schema.json",
  "title": "lampOS control protocol, v1",
  "description": "Every frame on wss://<lamp>.local:7731/v1, one JSON object per text frame: a request from the client, a reply or an event from the lamp. docs/control.md says what each means; this file is what the SDKs generate from. Not served yet: lamp-control is a design (#3504).",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/reply"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "id": {
      "description": "The client's number for a request, echoed as `re` in its reply.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "time": {
      "description": "The lamp's local time with its offset (RFC 3339).",
      "type": "string",
      "format": "date-time"
    },
    "grant": {
      "description": "What a paired client may do. body: gestures, moves, look, joints; light; speak: say and sound; look: presence events; hear: registered phrases; sound: sound classes; skills: its own skills put on the lamp, which run on their own after it goes.",
      "enum": [
        "body",
        "light",
        "speak",
        "look",
        "hear",
        "sound",
        "skills"
      ]
    },
    "part": {
      "description": "What a lease holds: voice is say and sound.",
      "enum": [
        "body",
        "light",
        "voice"
      ]
    },
    "event_name": {
      "enum": [
        "person.arrived",
        "person.left",
        "person.stood_up",
        "person.facing",
        "hand",
        "phrase.heard",
        "name.heard",
        "sound.heard",
        "touch",
        "button",
        "time",
        "lamp.changed"
      ]
    },
    "state_name": {
      "enum": [
        "presence",
        "light",
        "mood",
        "lamp"
      ]
    },
    "colour": {
      "description": "lamp_msgs::Light::COLOURS.",
      "enum": [
        "yellow",
        "red",
        "green",
        "blue",
        "cyan",
        "purple",
        "orange",
        "pink",
        "white",
        "warm"
      ]
    },
    "pattern": {
      "description": "lamp_msgs::PatternKind: a breath, a candle's wander, one soft pulse around. Never a blink or a flash.",
      "enum": [
        "breathe",
        "candle",
        "pulse"
      ]
    },
    "gesture": {
      "description": "A body clip (crates/body/src/clips/data.rs) by name. The door checks only the name's shape, as lamp-control's plain_name (a lowercase letter, then lowercase letters, digits, _ or -, at most 64), and the body answers a name it doesn't have. `examples` are the clips offered to programs (skills and add-ons name these); `idle`, the lamp's own life, and `scanning`, a room sweep, are taken too.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "examples": [
        "nod",
        "headshake",
        "greeting",
        "laugh",
        "shy",
        "stretching",
        "acknowledge",
        "curious",
        "happy",
        "caring",
        "surprised",
        "confused",
        "sleepy",
        "excited",
        "dance_chill",
        "dance_groove",
        "dance_hype",
        "dance_waltz",
        "dance_jazz"
      ]
    },
    "joint": {
      "description": "A joint's target in degrees from its pose.",
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "frame": {
      "description": "One step of a move: head pitch, head roll, base yaw, shoulder, elbow, in counts from the pose (4,096 a turn), as moves/*.json.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -350,
        "maximum": 350
      },
      "minItems": 5,
      "maxItems": 5
    },
    "request": {
      "oneOf": [
        {
          "$ref": "#/$defs/pair"
        },
        {
          "$ref": "#/$defs/hello"
        },
        {
          "$ref": "#/$defs/subscribe"
        },
        {
          "$ref": "#/$defs/unsubscribe"
        },
        {
          "$ref": "#/$defs/get"
        },
        {
          "$ref": "#/$defs/lease.take"
        },
        {
          "$ref": "#/$defs/lease.renew"
        },
        {
          "$ref": "#/$defs/lease.release"
        },
        {
          "$ref": "#/$defs/express"
        },
        {
          "$ref": "#/$defs/gesture.op"
        },
        {
          "$ref": "#/$defs/look"
        },
        {
          "$ref": "#/$defs/move"
        },
        {
          "$ref": "#/$defs/play"
        },
        {
          "$ref": "#/$defs/joints"
        },
        {
          "$ref": "#/$defs/light"
        },
        {
          "$ref": "#/$defs/say"
        },
        {
          "$ref": "#/$defs/sound"
        },
        {
          "$ref": "#/$defs/stop"
        }
      ]
    },
    "pair": {
      "description": "Once per computer, with the one-time code the owner's app shows (or the lamp says after a 3 s hold of its button).",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "pair"
        },
        "name": {
          "description": "The computer's name, shown in the app.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "key": {
          "description": "The client's Ed25519 public key, base64 (32 bytes).",
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "proof": {
          "description": "HMAC-SHA256 keyed with the code's 8 ASCII digits, over \"lampos/v1/pair\" and a zero byte, the pin's 32 bytes (the certificate's full SHA-256, from the owner's app), the 32 key bytes, then the welcome's 32 nonce bytes; base64.",
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      },
      "required": [
        "id",
        "op",
        "name",
        "key",
        "proof"
      ],
      "additionalProperties": false
    },
    "hello": {
      "description": "First on every connection of a paired client.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "hello"
        },
        "client": {
          "type": "string",
          "pattern": "^c_[0-9a-f]{1,32}$"
        },
        "sig": {
          "description": "The client key's Ed25519 signature over \"lampos/v1/hello\" and a zero byte, then the welcome's 32 nonce bytes; base64 (64 bytes).",
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "id",
        "op",
        "client",
        "sig"
      ],
      "additionalProperties": false
    },
    "subscribe": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "subscribe"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_name"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "phrases": {
          "description": "For phrase.heard: matched on the lamp; the client is told only which matched, never what was said.",
          "type": "array",
          "items": {
            "description": "8 letters at least, so no short word or pair.",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "op",
        "events"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "description": "phrase.heard needs the phrases to listen for.",
          "if": {
            "properties": {
              "events": {
                "contains": {
                  "const": "phrase.heard"
                }
              }
            }
          },
          "then": {
            "required": [
              "phrases"
            ],
            "properties": {
              "phrases": {
                "minItems": 1
              }
            }
          }
        },
        {
          "description": "Phrases go only with phrase.heard.",
          "if": {
            "required": [
              "phrases"
            ]
          },
          "then": {
            "properties": {
              "events": {
                "contains": {
                  "const": "phrase.heard"
                }
              }
            }
          }
        }
      ]
    },
    "unsubscribe": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "unsubscribe"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_name"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "op",
        "events"
      ],
      "additionalProperties": false
    },
    "get": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "get"
        },
        "state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_name"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "op",
        "state"
      ],
      "additionalProperties": false
    },
    "lease.take": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "lease.take"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "for_ms": {
          "description": "At most 10 min a take or renewal; renewed in time, a lease is held as long as its holder renews.",
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "why": {
          "description": "Journaled and shown in the app.",
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "op",
        "parts",
        "for_ms"
      ],
      "additionalProperties": false
    },
    "lease.renew": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "lease.renew"
        },
        "lease": {
          "$ref": "#/$defs/lease_id"
        },
        "for_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      },
      "required": [
        "id",
        "op",
        "lease",
        "for_ms"
      ],
      "additionalProperties": false
    },
    "lease.release": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "lease.release"
        },
        "lease": {
          "$ref": "#/$defs/lease_id"
        }
      },
      "required": [
        "id",
        "op",
        "lease"
      ],
      "additionalProperties": false
    },
    "lease_id": {
      "type": "string",
      "pattern": "^l_[0-9]{1,20}$"
    },
    "express": {
      "description": "A feeling in body and light, as the lamp shows its own (the feelings skill, #3691): its move and its light. Its names are that skill's, glad, lively and low today; any other is bad_request. strength from 0.5 up plays the skill's whole move, below it a three-quarter, half or quarter step of it, never bigger.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "express"
        },
        "feeling": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      },
      "required": [
        "id",
        "op",
        "feeling"
      ],
      "additionalProperties": false
    },
    "gesture.op": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "gesture"
        },
        "name": {
          "$ref": "#/$defs/gesture"
        }
      },
      "required": [
        "id",
        "op",
        "name"
      ],
      "additionalProperties": false
    },
    "look": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "look"
        },
        "at": {
          "oneOf": [
            {
              "description": "At the face it sees (needs look); at the hand it sees, followed by the body until stop, another look or the lease ends (needs look); the person who called its name; or straight ahead.",
              "enum": [
                "face",
                "hand",
                "name",
                "ahead"
              ]
            },
            {
              "description": "Degrees from straight ahead: yaw right positive, pitch up positive; any finite number, the body clamps it to its gaze reach (the done says `clamped`).",
              "type": "object",
              "properties": {
                "yaw": {
                  "type": "number"
                },
                "pitch": {
                  "type": "number"
                }
              },
              "required": [
                "yaw",
                "pitch"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "op",
        "at"
      ],
      "additionalProperties": false,
      "description": "Needs a body lease held by this client."
    },
    "move": {
      "description": "A move of the client's own, needs a body lease held by this client. Its first and last frames are all 0; the body's move check (moves.rs) judges the rest: 1.5 to 10 s, each joint's farthest and fastest. The last frame is all 0 too, which the crate checks; the schema can say only the first.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "move"
        },
        "step_ms": {
          "description": "The body's own: 40 to 1000, and the move lasts 1.5 to 10 s ((frames - 1) x step_ms), each joint within the body's reach and speed (lamp_body::moves::check); a move the body would drop is refused at the door.",
          "type": "integer",
          "minimum": 40,
          "maximum": 1000
        },
        "frames": {
          "description": "At least 2; at most what the body's move check allows (10 s at the shortest step, 40 ms: 251 frames).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          },
          "minItems": 2,
          "maxItems": 251,
          "prefixItems": [
            {
              "description": "The first frame is the pose: all 0.",
              "const": [
                0,
                0,
                0,
                0,
                0
              ]
            }
          ]
        }
      },
      "required": [
        "id",
        "op",
        "step_ms",
        "frames"
      ],
      "additionalProperties": false
    },
    "play": {
      "description": "A recorded move from the client's installed package; needs a body lease held by this client.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "play"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "id",
        "op",
        "name"
      ],
      "additionalProperties": false
    },
    "joints": {
      "description": "Joint targets, at most 40 a second, each step through the body's caps.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "joints"
        },
        "lease": {
          "$ref": "#/$defs/lease_id"
        },
        "targets": {
          "type": "object",
          "properties": {
            "pitch": {
              "$ref": "#/$defs/joint"
            },
            "roll": {
              "$ref": "#/$defs/joint"
            },
            "yaw": {
              "$ref": "#/$defs/joint"
            },
            "shoulder": {
              "$ref": "#/$defs/joint"
            },
            "elbow": {
              "$ref": "#/$defs/joint"
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "within_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "op",
        "lease",
        "targets",
        "within_ms"
      ],
      "additionalProperties": false
    },
    "light": {
      "description": "A light for a while, below the person and the conversation, at the ring's default period for its pattern.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "light"
        },
        "colour": {
          "$ref": "#/$defs/colour"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "pattern": {
          "$ref": "#/$defs/pattern"
        },
        "for_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      },
      "required": [
        "id",
        "op",
        "colour",
        "level",
        "for_ms"
      ],
      "additionalProperties": false
    },
    "say": {
      "description": "A line in the lamp's own voice, through its privacy and busy gates, and its quiet hours when set.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "say"
        },
        "text": {
          "description": "Words, at most 900 UTF-8 bytes, the voice's own cap (lamp-voice's MOST_WORDS_BYTES; hello's limits say_max_bytes). JSON Schema can't count bytes, so lamp-control checks it.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "id",
        "op",
        "text"
      ],
      "additionalProperties": false
    },
    "sound": {
      "description": "A clip of 3 s or less from the client's installed package.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "sound"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "id",
        "op",
        "name"
      ],
      "additionalProperties": false
    },
    "stop": {
      "description": "Ends the client's own actions now. Needs no grant and no lease.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "stop"
        }
      },
      "required": [
        "id",
        "op"
      ],
      "additionalProperties": false
    },
    "reply": {
      "oneOf": [
        {
          "description": "Taken. A pair reply carries client and grants; hello carries lamp, grants and limits; lease.take and lease.renew carry lease and until; get carries state, the states asked for by name; skill.push carries got for each part but the last, and skill for the last; skill.list carries skills.",
          "type": "object",
          "properties": {
            "re": {
              "description": "The request's id, or null when it couldn't be read.",
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ok": {
              "const": true
            },
            "client": {
              "type": "string"
            },
            "grants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/grant"
              },
              "uniqueItems": true
            },
            "lamp": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "v": {
                  "const": 1
                }
              },
              "required": [
                "id",
                "name",
                "v"
              ]
            },
            "limits": {
              "$ref": "#/$defs/limits"
            },
            "lease": {
              "$ref": "#/$defs/lease_id"
            },
            "until": {
              "$ref": "#/$defs/time"
            },
            "state": {
              "type": "object",
              "description": "get's answer: each state asked for, by its name. lamp-control's own: light and mood are null until known.",
              "properties": {
                "presence": {
                  "$ref": "#/$defs/presence"
                },
                "light": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "The person's own light (`on`, `colour`, `level`, from light/state), and `shows`: what the ring draws now (light/drawn), the person's light or one asked for over it. Each is left out until the lamp has said it; null until either is known.",
                  "properties": {
                    "on": {
                      "type": "boolean"
                    },
                    "colour": {
                      "type": "string"
                    },
                    "level": {
                      "type": "integer"
                    },
                    "shows": {
                      "type": "object",
                      "properties": {
                        "on": {
                          "type": "boolean"
                        },
                        "colour": {
                          "type": "string"
                        },
                        "level": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "on",
                        "colour",
                        "level"
                      ]
                    }
                  }
                },
                "mood": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "lamp": {
                  "$ref": "#/$defs/lamp_state"
                }
              },
              "additionalProperties": false
            },
            "got": {
              "type": "integer",
              "minimum": 1
            },
            "skill": {
              "type": "object"
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "re",
            "ok"
          ]
        },
        {
          "type": "object",
          "properties": {
            "re": {
              "description": "The request's id, or null when it couldn't be read.",
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "re",
            "ok",
            "error"
          ]
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "unpaired",
            "no_hello",
            "no_grant",
            "no_lease",
            "lease_lost",
            "busy",
            "refused",
            "quiet_hours",
            "private",
            "paused",
            "asleep",
            "rate",
            "bad_request",
            "off"
          ]
        },
        "why": {
          "type": "string"
        },
        "retry_ms": {
          "description": "With rate: when the oldest counted action leaves its window.",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "code",
        "why"
      ],
      "description": "A refusal. New fields may come; a client ignores what it doesn't know."
    },
    "limits": {
      "description": "hello's limits, as lamp-control's session::limits() says them: each rate class's windows (at most `most` in any `within_ms`), a light's and a lease's longest hold, the longest say, and this lamp's quiet hours.",
      "type": "object",
      "properties": {
        "rates": {
          "description": "Present when the door's rates are off, lamp-control's default (`--rates default` turns them on): every rate lifted but `refused` and `phrases`, whose windows are then the only ones told.",
          "const": "off"
        },
        "quiet_hours": {
          "description": "This lamp's quiet hours (lamp-control's --quiet-hours or LAMP_CONTROL_QUIET; \"off\" unless set): when set, `say` and `sound` are refused inside them, local times from `from` up to `to`, across midnight when `to` comes first; or \"off\".",
          "anyOf": [
            {
              "const": "off"
            },
            {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          ]
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "most": {
                "type": "integer",
                "minimum": 1
              },
              "within_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "most",
              "within_ms"
            ]
          }
        },
        "motion": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "most": {
                "type": "integer",
                "minimum": 1
              },
              "within_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "most",
              "within_ms"
            ]
          }
        },
        "light": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "most": {
                "type": "integer",
                "minimum": 1
              },
              "within_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "most",
              "within_ms"
            ]
          }
        },
        "say": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "most": {
                "type": "integer",
                "minimum": 1
              },
              "within_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "most",
              "within_ms"
            ]
          }
        },
        "express": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "most": {
                "type": "integer",
                "minimum": 1
              },
              "within_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "most",
              "within_ms"
            ]
          }
        },
        "refused": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "most": {
                "type": "integer",
                "minimum": 1
              },
              "within_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "most",
              "within_ms"
            ]
          }
        },
        "phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "most": {
                "type": "integer",
                "minimum": 1
              },
              "within_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "most",
              "within_ms"
            ]
          }
        },
        "hold_max_ms": {
          "type": "integer"
        },
        "lease_max_ms": {
          "description": "The longest one lease take or renewal asks for (600000); renewed in time, a lease has no ceiling. `hold_max_ms` stays a light's longest `for_ms` (30000).",
          "type": "integer"
        },
        "say_max_bytes": {
          "description": "The longest say's text in UTF-8 bytes (900), the voice's own cap.",
          "type": "integer"
        },
        "push": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "most": {
                "type": "integer",
                "minimum": 1
              },
              "within_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "most",
              "within_ms"
            ]
          }
        },
        "manage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "most": {
                "type": "integer",
                "minimum": 1
              },
              "within_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "most",
              "within_ms"
            ]
          }
        }
      }
    },
    "presence": {
      "description": "How many people, how near, whether one faces the lamp. Never who.",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "near": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "facing": {
          "type": "boolean"
        }
      },
      "required": [
        "count"
      ]
    },
    "lamp_state": {
      "type": "object",
      "properties": {
        "talking": {
          "type": "boolean"
        },
        "paused": {
          "type": "boolean"
        },
        "private": {
          "type": "boolean"
        },
        "asleep": {
          "type": "boolean"
        },
        "quiet_hours": {
          "description": "Planned: not produced yet. With quiet hours set (off by default), the door refuses say and sound in them, or while the lamp's local time isn't known, with the error `quiet_hours` (control.md, quiet hours); this state key is a later piece.",
          "type": "boolean"
        },
        "lease": {
          "description": "Who holds a lease now, by client name, if anyone.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "properties": {
        "ev": {
          "anyOf": [
            {
              "$ref": "#/$defs/event_name"
            },
            {
              "enum": [
                "welcome",
                "lease",
                "done"
              ]
            }
          ]
        },
        "at": {
          "$ref": "#/$defs/time",
          "description": "The lamp's local time, on the events about the room. welcome, lease and done may not carry it."
        }
      },
      "required": [
        "ev"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "ev": {
                "const": "welcome"
              }
            }
          },
          "then": {
            "description": "The lamp's first frame on every connection: the nonce pair's proof and hello's signature cover.",
            "properties": {
              "nonce": {
                "description": "32 random bytes, base64, new for each connection.",
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{43}=$"
              },
              "lamp": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "v": {
                    "const": 1
                  }
                },
                "required": [
                  "id",
                  "name",
                  "v"
                ]
              }
            },
            "required": [
              "nonce",
              "lamp"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "enum": [
                  "person.arrived",
                  "person.left"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "near": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "count"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "person.stood_up"
              }
            }
          },
          "then": {
            "properties": {
              "side": {
                "enum": [
                  "left",
                  "right",
                  "ahead"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "person.facing"
              }
            }
          },
          "then": {
            "properties": {
              "facing": {
                "type": "boolean"
              }
            },
            "required": [
              "facing"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "phrase.heard"
              }
            }
          },
          "then": {
            "properties": {
              "phrase": {
                "type": "string"
              }
            },
            "required": [
              "phrase"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "sound.heard"
              }
            }
          },
          "then": {
            "properties": {
              "class": {
                "type": "string"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "class"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "touch"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "tap",
                  "pet",
                  "hold"
                ]
              },
              "where": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "button"
              }
            }
          },
          "then": {
            "properties": {
              "press": {
                "enum": [
                  "press",
                  "long_press"
                ]
              }
            },
            "required": [
              "press"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "hand"
              }
            }
          },
          "then": {
            "description": "A hand in view (humans/hands/tracked, on the lamp): told when it is first seen, moves or grows by 0.05 of the picture, opens or closes, at most four times a second; and once when gone, after 1 s with no hand. Where it is in the picture, never the picture, its keypoints or whose hand.",
            "anyOf": [
              {
                "properties": {
                  "seen": {
                    "const": false,
                    "description": "The hand is gone."
                  }
                },
                "required": [
                  "seen"
                ]
              },
              {
                "properties": {
                  "seen": {
                    "const": true
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The palm's centre, as a share of the picture's width from its left edge."
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The palm's centre, as a share of the picture's height from its top edge."
                  },
                  "size": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The palm's width as a share of the picture's width."
                  },
                  "open": {
                    "type": "boolean",
                    "description": "An open hand; false for a closed one."
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "How sure the tracker is that it is a hand, from 0.5: below that it isn't one."
                  }
                },
                "required": [
                  "seen",
                  "x",
                  "y",
                  "size",
                  "open",
                  "confidence"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "lamp.changed"
              }
            }
          },
          "then": {
            "properties": {
              "lamp_state": {
                "$ref": "#/$defs/lamp_state"
              }
            },
            "required": [
              "lamp_state"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "lease"
              }
            }
          },
          "then": {
            "properties": {
              "lease": {
                "$ref": "#/$defs/lease_id"
              },
              "state": {
                "enum": [
                  "held",
                  "suspended",
                  "lost"
                ]
              },
              "why": {
                "enum": [
                  "conversation",
                  "hand",
                  "stop_heard",
                  "private",
                  "paused",
                  "asleep",
                  "expired",
                  "taken_by_owner_app",
                  "revoked",
                  "released",
                  "slumped"
                ]
              }
            },
            "required": [
              "lease",
              "state"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ev": {
                "const": "done"
              }
            }
          },
          "then": {
            "properties": {
              "re": {
                "$ref": "#/$defs/id"
              },
              "how": {
                "enum": [
                  "finished",
                  "cut_short",
                  "dropped"
                ]
              },
              "why": {
                "type": "string"
              },
              "yaw": {
                "description": "A look's done: the yaw the head reached, degrees, right positive.",
                "type": "number"
              },
              "pitch": {
                "description": "A look's done: the pitch the head reached, degrees, up positive.",
                "type": "number"
              },
              "clamped": {
                "description": "A look's done: the body held it inside its reach or pitch window, so yaw and pitch are not what was asked.",
                "type": "boolean"
              }
            },
            "required": [
              "re",
              "how"
            ]
          }
        }
      ]
    }
  }
}
